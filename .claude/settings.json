{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:webkit)",
      "Bash(pnpm lint:webkit:*)",
      "Bash(pnpm typecheck:webkit)",
      "Bash(pnpm type-coverage:webkit)",
      "Bash(pnpm format:webkit)",
      "Bash(pnpm check-format:webkit)",
      "Bash(pnpm build:icons)",
      "Bash(pnpm check:icons)",
      "Bash(pnpm gates)",
      "Bash(pnpm --filter:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx stylelint:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(npm run *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-tokens.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validate-references.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validate-authoring.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validate-naming.mjs"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-component-create.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-spec-exists.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-spec-compliance.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-test-exists.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validate-authoring-docs.mjs"
          }
        ]
      }
    ]
  }
}
