.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Theme dist is generated but tracked — `@aziontech/theme`'s package.json#exports
# points at ./dist/v3/{tailwind-preset.js,globals.css,…}. Without these checked in,
# consumers (and CI) hit "Package subpath not defined" before they get a chance
# to run `pnpm --filter @aziontech/theme build:tokens:v3`.
!packages/theme/dist
!packages/theme/dist/**
# output.css is a transient harness artifact (build:css:v3) — not exported.
packages/theme/dist/v3/output.css
coverage
*.local

# Secrets — keep .env files local; commit .env.example only.
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.edge

package-lock.json
yarn.lock

.DS_Store
*.tsbuildinfo
*.d.ts
*d.ts.map
# Declarations for WebKit's runtime .js modules (node packages/webkit/scripts/build-js-dts.mjs)
!packages/webkit/src/components/actions/icon-button/presets/icon-transition.d.ts
!packages/webkit/src/components/content/item/merge-as-child.d.ts
!packages/webkit/src/components/inputs/presets/interactive-states.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/create-change-event-details.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/get-css-dimensions.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/navigation-menu-css-vars.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/resolve-host-element.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/use-navigation-menu-context.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/use-navigation-menu-list-highlight-context.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/use-navigation-menu-list-highlight.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/use-navigation-menu-positioner-context.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/use-navigation-menu-positioner.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/use-navigation-menu-root.d.ts
!packages/webkit/src/components/navigation/navigation-menu/composables/use-transition-status.d.ts
!packages/webkit/src/components/navigation/navigation-menu/presets/animations.d.ts
!packages/webkit/src/components/navigation/navigation-menu/presets/styles.d.ts
!packages/webkit/src/components/overlay/composables/use-overlay-mobile.d.ts
!packages/webkit/src/components/overlay/drawer/presets/sizes.d.ts
!packages/webkit/src/components/overlay/panel/presets/sizes.d.ts
!packages/webkit/src/components/overlay/presets/bottom-sheet-transitions.d.ts
!packages/webkit/src/components/overlay/presets/mobile-position.d.ts
!packages/webkit/src/components/overlay/tooltip/presets/popup-scale-transition.d.ts
!packages/webkit/src/composables/use-focus-trap/index.d.ts
!packages/webkit/src/utils/cn.d.ts
!apps/docs/src/env.d.ts
!apps/docs/src/lib/virtual/*.d.ts

CLAUDE.md
# Claude Code — personal state and runtime caches (ignored)
# Versioned in .claude/: settings.json, agents/, hooks/, commands/, skills/, rules/, docs/
.claude/settings.local.json
.claude/launch.json
.claude/sessions/
.claude/projects/
.claude/file-history/
.claude/cache/
.claude/todos/
.claude/telemetry/
.claude/debug/
.claude/statsig/
.claude/session-env/
.claude/shell-snapshots/
.claude/tasks/
.claude/backups/
.claude/plans/
.claude/ide/
.claude/plugins/
.claude/paste-cache/
.claude/history.jsonl
.claude/stats-cache.json
.claude/mcp-needs-auth-cache.json
.claude/.last-cleanup

# packages folder to ignore
packages/icons/tmp/
tmp
.tmp

# Vitest browser-mode failure screenshots (regenerated on demand)
**/__screenshots__/
# Vitest browser-mode attachments (failure artifacts, same nature as __screenshots__)
packages/webkit/.vitest-attachments/

# Visual regression (Playwright, apps/visual) — the baselines in apps/visual/baselines
# are the CI contract and ARE committed; results and reports are local-only.
apps/visual/test-results/
apps/visual/playwright-report/

# AI bundle copies made by packages/webkit's prepack (sources live in skills/, rules/, adapters/)
packages/webkit/skills/
packages/webkit/rules/
packages/webkit/adapters/
