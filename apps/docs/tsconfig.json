{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "virtual:docs-index": ["./src/lib/virtual/docs-index.d.ts"],
      "virtual:docs-tokens": ["./src/lib/virtual/docs-tokens.d.ts"],
      "virtual:docs-component-loaders": ["./src/lib/virtual/docs-component-loaders.d.ts"]
    }
  },
  "include": ["src/**/*", "plugins/**/*", "vite.config.ts"]
}
