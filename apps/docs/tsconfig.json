{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "virtual:docs-index": ["./src/lib/virtual/docs-index.d.ts"],
      "virtual:docs-nav": ["./src/lib/virtual/docs-nav.d.ts"],
      "virtual:docs-frame-styles": ["./src/lib/virtual/docs-frame-styles.d.ts"],
      "virtual:docs-tokens": ["./src/lib/virtual/docs-tokens.d.ts"],
      "virtual:docs-assets": ["./src/lib/virtual/docs-assets.d.ts"],
      "virtual:docs-component-loaders": ["./src/lib/virtual/docs-component-loaders.d.ts"],
      "virtual:docs-example-loaders": ["./src/lib/virtual/docs-example-loaders.d.ts"],
      "virtual:docs-block-loaders": ["./src/lib/virtual/docs-block-loaders.d.ts"]
    }
  },
  "include": ["src/**/*", "plugins/**/*", "test/**/*", "vite.config.ts"]
}
