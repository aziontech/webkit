{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@site/*": ["src/site/*"],
      "@hub/*": ["src/hub/*"],
      "@console/*": ["src/console/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.vue", "vite.config.js"],
  "exclude": ["node_modules", "dist", ".edge"]
}
