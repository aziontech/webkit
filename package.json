{
  "name": "@aziontech/webkit-monorepo",
  "author": "@aziontech",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/aziontech/webkit.git"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean:install": "rm -rf pnpm-lock.yaml node_modules/ && pnpm install",
    "prepare": "husky",
    "dev:icons-gallery": "pnpm --filter @aziontech/icons-gallery run dev",
    "build:icons-gallery": "pnpm --filter @aziontech/icons-gallery run build",
    "build:icons-gallery:azion": "pnpm --filter @aziontech/icons-gallery run build:azion",
    "preview:icons-gallery": "pnpm --filter @aziontech/icons-gallery run preview",
    "deploy:icons-gallery": "pnpm --filter @aziontech/icons-gallery run deploy",
    "build:icons": "pnpm --filter @aziontech/icons run build",
    "check:icons": "pnpm --filter @aziontech/icons run check:svg && pnpm --filter @aziontech/icons run check:manifest",
    "release:icons": "pnpm --filter @aziontech/icons run release",
    "dev:docs": "pnpm build:icons && pnpm --filter @aziontech/webkit-docs run dev",
    "build:docs": "pnpm build:icons && pnpm --filter @aziontech/webkit-docs run build",
    "preview:docs": "pnpm --filter @aziontech/webkit-docs run preview",
    "check:docs:links": "pnpm --filter @aziontech/webkit-docs run check:links",
    "check:docs:editor-chunks": "pnpm --filter @aziontech/webkit-docs run check:editor-chunks",
    "test:docs": "pnpm --filter @aziontech/webkit-docs test",
    "test:docs:smoke": "pnpm --filter @aziontech/webkit-docs run test:smoke",
    "test:docs:shell": "pnpm --filter @aziontech/webkit-docs run test:shell",
    "lint:docs": "pnpm --filter @aziontech/webkit-docs run lint",
    "typecheck:docs": "pnpm --filter @aziontech/webkit-docs run typecheck",
    "dev:demos": "pnpm build:icons && pnpm --filter @aziontech/webkit-demos run dev",
    "build:demos": "pnpm build:icons && pnpm --filter @aziontech/webkit-demos run build",
    "preview:demos": "pnpm --filter @aziontech/webkit-demos run preview",
    "test:visual": "pnpm --filter @aziontech/webkit-visual run test",
    "update:visual": "pnpm --filter @aziontech/webkit-visual run update",
    "update:baselines": "gh workflow run visual-baselines.yml -r $(git branch --show-current) -f update_baselines=true",
    "build:tokens": "pnpm --filter @aziontech/theme run build:tokens",
    "build:theme-types": "pnpm --filter @aziontech/theme run build:types",
    "clean:theme-types": "pnpm --filter @aziontech/theme run clean:types",
    "format:theme": "pnpm --filter @aziontech/theme run format",
    "lint:webkit": "pnpm --filter @aziontech/webkit run lint",
    "lint:webkit:fix": "pnpm --filter @aziontech/webkit run lint:fix",
    "lint:webkit:style": "stylelint \"packages/webkit/**/*.{css,scss,vue}\"",
    "lint:webkit:style:fix": "stylelint \"packages/webkit/**/*.{css,scss,vue}\" --fix",
    "typecheck:webkit": "pnpm --filter @aziontech/webkit run typecheck",
    "typecheck:webkit:tests": "pnpm --filter @aziontech/webkit run typecheck:tests",
    "check:webkit:type-coverage": "pnpm --filter @aziontech/webkit run check:type-coverage",
    "test:webkit": "pnpm --filter @aziontech/webkit run test",
    "test:webkit:coverage": "pnpm --filter @aziontech/webkit run test:coverage",
    "test:webkit:watch": "pnpm --filter @aziontech/webkit run test:watch",
    "test:webkit:ui": "pnpm --filter @aziontech/webkit run test:ui",
    "format:webkit": "pnpm --filter @aziontech/webkit run format",
    "check:webkit:format": "pnpm --filter @aziontech/webkit run check:format",
    "check:audit": "pnpm audit",
    "generate:sbom": "pnpm sbom --sbom-format cyclonedx --prod --lockfile-only --filter './packages/*' --sbom-supplier 'Azion Technologies' --out 'sbom/%s.cdx.json'",
    "check:workflows": "if command -v actionlint >/dev/null; then actionlint -no-color; else echo \"check:workflows: actionlint is not on PATH, skipped\"; fi && if command -v zizmor >/dev/null; then zizmor --offline --no-progress --color never .github/workflows; else echo \"check:workflows: zizmor is not on PATH, skipped\"; fi",
    "check:spelling": "typos --format brief",
    "check:unused": "npx --yes knip@5.88.1 --no-progress",
    "check:versions": "npx --yes syncpack@13.0.4 list-mismatches && pnpm dedupe --check --prefer-offline",
    "gates": "pnpm run lint:webkit && pnpm run lint:webkit:style && pnpm run check:webkit:format && pnpm run typecheck:webkit && pnpm run typecheck:webkit:tests && pnpm run typecheck:docs && pnpm run check:webkit:type-coverage && pnpm run check:audit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@eslint/js": "^9.39.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^9",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.9.4",
    "stylelint": "^17.7.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "type-coverage": "^2.29.7",
    "vue-eslint-parser": "^10.4.0"
  },
  "lint-staged": {
    "packages/webkit/**/*.{js,ts,vue}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "packages/webkit/**/*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "packages/webkit/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
