{
  "name": "@aziontech/icons",
  "version": "4.1.1",
  "description": "Azion icon font library — azionicons + primeicons as CSS/woff2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aziontech/webkit.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "build": "npm run clean; node scripts/build.mjs",
    "validate": "node scripts/validate-svg.mjs",
    "publish": "cd dist && npm publish && cd ..",
    "pack:dry": "cd dist && npm pack --dry-run && cd ..",
    "format": "prettier --write scripts/ src/"
  },
  "dependencies": {
    "fantasticon": "^4.1.0"
  },
  "main": "./dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./azionicons": "./dist/azionicons.css",
    "./azionicons-color": "./dist/azionicons-color.css",
    "./primeicons": "./dist/primeicons.css",
    "./catalog": "./dist/catalog.json",
    "./color-catalog": "./dist/color-catalog.json"
  }
}
