{
  "name": "@aziontech/theme",
  "type": "module",
  "version": "5.2.2",
  "author": "aziontech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aziontech/webkit.git",
    "directory": "packages/theme"
  },
  "scripts": {
    "pack:dry": "npm pack --dry-run",
    "test": "node --test \"test/**/*.test.mjs\"",
    "format": "prettier --write scripts/ src/",
    "build": "pnpm build:tokens",
    "build:tokens": "node scripts/build-tokens.mjs",
    "clean:types": "find src -name '*.d.ts' -delete && find src -name '*.d.ts.map' -delete",
    "build:types": "pnpm clean:types && vue-tsc --declaration --emitDeclarationOnly",
    "prepack": "pnpm build:tokens && pnpm build:types"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-tokens",
    "theme",
    "css",
    "css-vars",
    "tailwind-css",
    "branding",
    "ui-kit",
    "token-generator"
  ],
  "devDependencies": {
    "vue-tsc": ">=3.2.5 <3.3.12 || >=3.3.15 <4.0.0"
  },
  "files": [
    "src/",
    "dist/",
    "fonts/",
    "LICENSE"
  ],
  "types": "./dist/globals.d.ts",
  "exports": {
    ".": {
      "types": "./dist/globals.d.ts",
      "default": "./dist/globals.css"
    },
    "./fonts.css": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.css"
    },
    "./fonts/*": "./fonts/*",
    "./animations": "./src/tokens/primitives/animations/animate.js",
    "./colors": "./src/tokens/primitives/colors/colors.js",
    "./layout": "./src/tokens/semantic/layout.js",
    "./typography": "./src/tokens/semantic/typography.js",
    "./theme-colors": "./src/tokens/theme-colors.js"
  }
}
