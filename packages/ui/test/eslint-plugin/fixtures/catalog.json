{
  "package": "@aziontech/ui",
  "azionUiVersion": "9.9.9",
  "deniedPrefixes": ["@aziontech/ui/src/"],
  "tokenRules": [
    {
      "id": "hex-color",
      "pattern": "#[0-9a-fA-F]{3,8}\\b",
      "flags": "g",
      "message": "Hex color hardcoded. Use semantic tokens (var(--primary), ...)."
    },
    {
      "id": "tailwind-palette",
      "pattern": "\\b(?:bg|text|border)-(?:gray|red|blue|green)-\\d{2,3}\\b",
      "flags": "g",
      "message": "Tailwind palette color. Use semantic Azion UI tokens."
    }
  ],
  "imports": {
    "button": {
      "import": "@aziontech/ui/button",
      "kind": "component",
      "treeShakeableImport": "@aziontech/ui/button",
      "structure": "monolithic",
      "props": [{ "name": "label" }, { "name": "kind" }],
      "slots": [{ "name": "prefix" }]
    },
    "card": {
      "import": "@aziontech/ui/card",
      "kind": "component",
      "treeShakeableImport": "@aziontech/ui/card",
      "styleSeam": true,
      "structure": "monolithic",
      "props": [{ "name": "title" }],
      "slots": [{ "name": "header" }, { "name": "content" }]
    },
    "chip": {
      "import": "@aziontech/ui/chip",
      "kind": "component",
      "treeShakeableImport": "@aziontech/ui/chip",
      "structure": "monolithic",
      "props": [{ "name": "removable" }]
    },
    "chips": {
      "import": "@aziontech/ui/chips",
      "kind": "component",
      "treeShakeableImport": "@aziontech/ui/chips",
      "deprecated": true,
      "replacedBy": "chip"
    },
    "vite": {
      "import": "@aziontech/ui/vite",
      "kind": "other",
      "treeShakeableImport": "@aziontech/ui/vite",
      "deprecated": true,
      "deprecation": "since 6.1 — nothing to pre-bundle. Removed in 7.0."
    },
    "table": {
      "import": "@aziontech/ui/table",
      "kind": "component",
      "compoundRoot": true,
      "treeShakeableImport": "@aziontech/ui/table-root",
      "subcomponents": ["@aziontech/ui/table-row"],
      "structure": "composition",
      "slots": [{ "name": "default" }]
    },
    "table-root": {
      "import": "@aziontech/ui/table-root",
      "kind": "root",
      "rootOf": "table",
      "treeShakeableImport": "@aziontech/ui/table-root"
    },
    "table-row": {
      "import": "@aziontech/ui/table-row",
      "kind": "subcomponent",
      "parent": "table",
      "treeShakeableImport": "@aziontech/ui/table-row"
    }
  },
  "tokens": {
    "animations": [
      "fade-in",
      "fade-out",
      "slide-down",
      "slide-in-start",
      "slide-out-start",
      "slide-in-end",
      "slide-out-end",
      "popup-scale-in",
      "popup-scale-out",
      "pulse",
      "spin"
    ]
  }
}
