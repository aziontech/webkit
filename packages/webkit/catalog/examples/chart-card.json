{
 "examples": [
  {
   "name": "Default",
   "summary": "A padded card with a title and its info hint, the chart, and a footer naming the range. The chart inside takes its accessible name from the card title.",
   "sfc": "<script setup>\n  import Chart from '@aziontech/webkit/chart'\n  import ChartCard from '@aziontech/webkit/chart-card'\n  import Hint from '@aziontech/webkit/hint'\n\n  const labels = [\n    '13:05',\n    '13:10',\n    '13:15',\n    '13:20',\n    '13:25',\n    '13:30',\n    '13:35',\n    '13:40',\n    '13:45',\n    '13:50',\n    '13:55',\n    '14:00'\n  ]\n  const series = [\n    {\n      id: 'allowed',\n      name: 'WAF requests allowed',\n      color: 'success',\n      values: [1210, 1340, 1295, 1480, 1530, 1460, 1610, 1580, 1720, 1690, 1810, 1760]\n    },\n    {\n      id: 'blocked',\n      name: 'WAF requests blocked',\n      color: 'danger',\n      values: [320, 410, 380, 520, 470, 430, 610, 580, 540, 690, 650, 720]\n    },\n    {\n      id: 'threat',\n      name: 'WAF requests threat',\n      color: 'warning',\n      values: [80, 95, 70, 120, 110, 90, 140, 130, 115, 160, 150, 170]\n    }\n  ]\n</script>\n\n<template>\n  <ChartCard>\n    <ChartCard.Header>\n      <span class=\"inline-flex min-w-0 items-center gap-(--spacing-xxs)\">\n        <ChartCard.Title>Threats vs requests</ChartCard.Title>\n        <Hint text=\"Requests WAF analyzed, split into blocked, logged and allowed.\" />\n      </span>\n    </ChartCard.Header>\n    <ChartCard.Content>\n      <Chart\n        :series=\"series\"\n        :labels=\"labels\"\n      >\n        <Chart.Grid />\n        <Chart.Axis kind=\"y\" />\n        <Chart.Axis kind=\"x\" />\n        <Chart.Line />\n        <Chart.Crosshair />\n        <Chart.Tooltip />\n        <Chart.Legend totals />\n      </Chart>\n    </ChartCard.Content>\n    <ChartCard.Footer>Last hour, 5 minute buckets</ChartCard.Footer>\n  </ChartCard>\n</template>"
  },
  {
   "name": "Content",
   "summary": "Padded content for a chart with axes and a legend; flush content for an edge-to-edge plot.",
   "sfc": "<script setup>\n  import Chart from '@aziontech/webkit/chart'\n  import ChartCard from '@aziontech/webkit/chart-card'\n\n  const labels = [\n    '13:05',\n    '13:10',\n    '13:15',\n    '13:20',\n    '13:25',\n    '13:30',\n    '13:35',\n    '13:40',\n    '13:45',\n    '13:50',\n    '13:55',\n    '14:00'\n  ]\n  const series = [\n    {\n      id: 'allowed',\n      name: 'WAF requests allowed',\n      color: 'success',\n      values: [1210, 1340, 1295, 1480, 1530, 1460, 1610, 1580, 1720, 1690, 1810, 1760]\n    },\n    {\n      id: 'blocked',\n      name: 'WAF requests blocked',\n      color: 'danger',\n      values: [320, 410, 380, 520, 470, 430, 610, 580, 540, 690, 650, 720]\n    },\n    {\n      id: 'threat',\n      name: 'WAF requests threat',\n      color: 'warning',\n      values: [80, 95, 70, 120, 110, 90, 140, 130, 115, 160, 150, 170]\n    }\n  ]\n</script>\n\n<template>\n  <div class=\"grid grid-cols-1 gap-(--spacing-lg) lg:grid-cols-2\">\n    <ChartCard>\n      <ChartCard.Header>\n        <ChartCard.Title>Padded</ChartCard.Title>\n      </ChartCard.Header>\n      <ChartCard.Content>\n        <Chart\n          :series=\"series\"\n          :labels=\"labels\"\n        >\n          <Chart.Grid />\n          <Chart.Axis kind=\"y\" />\n          <Chart.Axis kind=\"x\" />\n          <Chart.Line />\n          <Chart.Crosshair />\n          <Chart.Tooltip />\n          <Chart.Legend totals />\n        </Chart>\n      </ChartCard.Content>\n    </ChartCard>\n    <ChartCard>\n      <ChartCard.Header>\n        <ChartCard.Title>Flush</ChartCard.Title>\n      </ChartCard.Header>\n      <ChartCard.Content flush>\n        <Chart\n          :series=\"series\"\n          :labels=\"labels\"\n        >\n          <Chart.Grid />\n          <Chart.Axis kind=\"y\" />\n          <Chart.Axis kind=\"x\" />\n          <Chart.Line />\n          <Chart.Crosshair />\n          <Chart.Tooltip />\n          <Chart.Legend totals />\n        </Chart>\n      </ChartCard.Content>\n    </ChartCard>\n  </div>\n</template>"
  },
  {
   "name": "WithControls",
   "summary": "The aggregation and variation tags sit before the options menu. The menu carries Copy query and Export CSV, the two paths a person takes to move this data into another tool.",
   "sfc": "<script setup>\n  import Chart from '@aziontech/webkit/chart'\n  import ChartCard from '@aziontech/webkit/chart-card'\n  import DropdownMenuGroup from '@aziontech/webkit/dropdown-menu-group'\n  import DropdownMenuOption from '@aziontech/webkit/dropdown-menu-option'\n  import DropdownMenuRoot from '@aziontech/webkit/dropdown-menu-root'\n  import DropdownMenuTrigger from '@aziontech/webkit/dropdown-menu-trigger'\n  import Hint from '@aziontech/webkit/hint'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Tag from '@aziontech/webkit/tag'\n\n  const labels = [\n    '13:05',\n    '13:10',\n    '13:15',\n    '13:20',\n    '13:25',\n    '13:30',\n    '13:35',\n    '13:40',\n    '13:45',\n    '13:50',\n    '13:55',\n    '14:00'\n  ]\n  const series = [\n    {\n      id: 'xss',\n      name: 'WAF requests XSS attacks',\n      values: [42, 38, 51, 47, 63, 58, 72, 69, 81, 77, 90, 86]\n    }\n  ]\n</script>\n\n<template>\n  <ChartCard class=\"max-w-(--container-3xl)\">\n    <ChartCard.Header>\n      <span class=\"inline-flex min-w-0 items-center gap-(--spacing-xxs)\">\n        <ChartCard.Title>Cross-site scripting threats</ChartCard.Title>\n        <Hint text=\"Requests carrying cross-site scripting attacks against your domains.\" />\n      </span>\n      <ChartCard.Controls>\n        <Tag\n          label=\"Sum\"\n          severity=\"secondary\"\n          icon=\"pi pi-calculator\"\n        />\n        <Tag\n          label=\"+12.40%\"\n          severity=\"danger\"\n        />\n        <DropdownMenuRoot>\n          <DropdownMenuTrigger>\n            <IconButton\n              kind=\"transparent\"\n              size=\"small\"\n              icon=\"pi pi-ellipsis-h\"\n              aria-label=\"More options\"\n            />\n          </DropdownMenuTrigger>\n          <DropdownMenuGroup>\n            <DropdownMenuOption\n              value=\"copy-query\"\n              label=\"Copy query\"\n            />\n            <DropdownMenuOption\n              value=\"export-csv\"\n              label=\"Export CSV\"\n            />\n            <DropdownMenuOption\n              value=\"mean-line\"\n              label=\"Show mean line\"\n            />\n          </DropdownMenuGroup>\n        </DropdownMenuRoot>\n      </ChartCard.Controls>\n    </ChartCard.Header>\n    <ChartCard.Content>\n      <Chart\n        :series=\"series\"\n        :labels=\"labels\"\n      >\n        <Chart.Grid />\n        <Chart.Axis kind=\"y\" />\n        <Chart.Axis kind=\"x\" />\n        <Chart.Line />\n        <Chart.Crosshair />\n        <Chart.Tooltip />\n      </Chart>\n    </ChartCard.Content>\n  </ChartCard>\n</template>"
  }
 ]
}
