{
 "examples": [
  {
   "name": "Default",
   "summary": "One turn: the reader's question in a filled bubble at the inline end, and the AI assistant's response flat beside its mark, each with an author line and time.",
   "sfc": "<script setup>\n  import ChatMessage from '@aziontech/webkit/chat-message'\n  import StreamingResponse from '@aziontech/webkit/streaming-response'\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-3xl) flex-col gap-(--spacing-lg)\">\n    <ChatMessage\n      from=\"user\"\n      author=\"Ana Lima\"\n      timestamp=\"10:41\"\n    >\n      How do I purge the cache of one URL?\n    </ChatMessage>\n    <ChatMessage timestamp=\"10:41\">\n      <StreamingResponse\n        content=\"Open **Real-Time Purge**, choose *URL* as the purge type and paste the address. The purge reaches every edge location in a few seconds.\"\n      />\n    </ChatMessage>\n  </div>\n</template>"
  },
  {
   "name": "Actions",
   "summary": "A complete response with its inline actions always visible: Copy, Regenerate and the Helpful / Not helpful thumbs, which disable the other thumb and confirm Feedback submitted.",
   "sfc": "<script setup>\n  import ChatMessage from '@aziontech/webkit/chat-message'\n  import CopyButton from '@aziontech/webkit/copy-button'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import StreamingResponse from '@aziontech/webkit/streaming-response'\n  import { ref } from 'vue'\n\n  const answer =\n    'Set **Cache by query string** to *Allowlist* and keep only `page` and `lang`. Campaign parameters such as `utm_source` stop creating new cache keys.'\n  const feedback = ref(null)\n  const sending = ref(false)\n\n  function send(value) {\n    feedback.value = value\n    sending.value = true\n    setTimeout(() => (sending.value = false), 800)\n  }\n</script>\n\n<template>\n  <div class=\"w-full max-w-(--container-3xl)\">\n    <ChatMessage timestamp=\"10:44\">\n      <StreamingResponse :content=\"answer\" />\n      <template #actions>\n        <ChatMessage.Actions>\n          <CopyButton :value=\"answer\" />\n          <IconButton\n            icon=\"pi pi-refresh\"\n            aria-label=\"Regenerate response\"\n            kind=\"transparent\"\n            size=\"small\"\n          />\n          <ChatMessage.Feedback\n            :model-value=\"feedback\"\n            :loading=\"sending\"\n            @update:model-value=\"send\"\n          />\n        </ChatMessage.Actions>\n      </template>\n    </ChatMessage>\n  </div>\n</template>"
  },
  {
   "name": "Lifecycle",
   "summary": "The same response moving through pending (Generating a response), streaming (busy, caret, no actions) and complete (actions appear). Replay restarts it.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import ChatMessage from '@aziontech/webkit/chat-message'\n  import CopyButton from '@aziontech/webkit/copy-button'\n  import StreamingResponse from '@aziontech/webkit/streaming-response'\n  import { onBeforeUnmount, onMounted, ref } from 'vue'\n\n  const full =\n    'The 502 responses started at 14:05, when the **origin certificate** expired. Upload the renewed certificate and the errors stop.'\n  const state = ref('pending')\n  const content = ref('')\n  let timer\n\n  function play() {\n    clearTimeout(timer)\n    clearInterval(timer)\n    state.value = 'pending'\n    content.value = ''\n    timer = setTimeout(() => {\n      state.value = 'streaming'\n      let index = 0\n      timer = setInterval(() => {\n        index = Math.min(full.length, index + 3)\n        content.value = full.slice(0, index)\n        if (index >= full.length) {\n          clearInterval(timer)\n          state.value = 'complete'\n        }\n      }, 40)\n    }, 1500)\n  }\n\n  onMounted(play)\n  onBeforeUnmount(() => {\n    clearTimeout(timer)\n    clearInterval(timer)\n  })\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-3xl) flex-col items-start gap-(--spacing-md)\">\n    <ChatMessage :state=\"state\">\n      <StreamingResponse\n        :content=\"content\"\n        :streaming=\"state === 'streaming'\"\n      />\n      <template #actions>\n        <ChatMessage.Actions>\n          <CopyButton :value=\"full\" />\n        </ChatMessage.Actions>\n      </template>\n    </ChatMessage>\n    <Button\n      label=\"Replay\"\n      kind=\"outlined\"\n      size=\"small\"\n      icon=\"pi pi-refresh\"\n      :disabled=\"state !== 'complete'\"\n      @click=\"play\"\n    />\n  </div>\n</template>"
  }
 ]
}
