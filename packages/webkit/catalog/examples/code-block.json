   "name": "Default",
   "summary": "Language switcher: two tabs with a filename bar, syntax highlighting, and copy.",
   "sfc": "<script setup>\n  import CodeBlock from '@aziontech/webkit/code-block'\n\n  const tabs = [\n    {\n      label: 'Javascript',\n      value: 'js',\n      language: 'javascript',\n      fileName: 'file name.js',\n      code: \"export default {\\n  async fetch(request) {\\n    const { prompt } = await request.json()\\n\\n    const modelResponse = await Azion.AI.run(\\n      'Qwen/Qwen3-30B-A3B-Instruct-2507-FP8',\\n      {\\n        messages: [\\n          { role: 'system', content: 'You are a helpful assistant.' },\\n          { role: 'user', content: prompt }\\n        ]\\n      }\\n    )\\n\\n    return new Response(JSON.stringify(modelResponse))\\n  }\\n}\"\n    },\n    {\n      label: 'Typescript',\n      value: 'ts',\n      language: 'typescript',\n      fileName: 'file name.ts',\n      code: \"export default {\\n  async fetch(request: Request) {\\n    const { prompt } = await request.json()\\n\\n    const modelResponse = await Azion.AI.run(\\n      'Qwen/Qwen3-30B-A3B-Instruct-2507-FP8',\\n      {\\n        messages: [\\n          { role: 'system', content: 'You are a helpful assistant.' },\\n          { role: 'user', content: prompt }\\n        ]\\n      }\\n    )\\n\\n    return new Response(JSON.stringify(modelResponse))\\n  }\\n}\"\n    }\n  ]\n</script>\n\n<template>\n  <div class=\"max-w-[692px]\">\n    <CodeBlock\n      :tabs=\"tabs\"\n      default-value=\"js\"\n      show-line-numbers\n    />\n  </div>\n</template>"
  },
