{
 "examples": [
  {
   "name": "Default",
   "summary": "The console chrome around a list page: navigation as data with a drill level and a Preview badge, the breadcrumb, Create and Agent in the actions slot (icon-only while compact), recent resources in the ⌘K palette and the account menu. The page body is only the slot content.",
   "sfc": "<script setup lang=\"ts\">\n  import Button from '@aziontech/webkit/button'\n  import ButtonHighlight from '@aziontech/webkit/button-highlight'\n  import Command from '@aziontech/webkit/command'\n  import ConsoleLayout, { type ConsoleLayoutNavGroup } from '@aziontech/webkit/console-layout'\n  import DropdownMenu from '@aziontech/webkit/dropdown-menu'\n  import EmptyState from '@aziontech/webkit/empty-state'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import PageHeader from '@aziontech/webkit/page-header'\n  import Tooltip from '@aziontech/webkit/tooltip'\n\n  const navigation: ConsoleLayoutNavGroup[] = [\n    {\n      items: [\n        { id: 'overview', label: 'Overview', icon: 'ai ai-home', href: '/' },\n        { id: 'workloads', label: 'Workloads', icon: 'ai ai-workloads', href: '/workloads' }\n      ]\n    },\n    {\n      label: 'Build',\n      items: [\n        {\n          id: 'applications',\n          label: 'Applications',\n          icon: 'ai ai-edge-application',\n          href: '/applications'\n        },\n        { id: 'functions', label: 'Functions', icon: 'ai ai-edge-functions', href: '/functions' }\n      ]\n    },\n    {\n      label: 'Store',\n      items: [\n        {\n          id: 'sql-database',\n          label: 'SQL Database',\n          icon: 'ai ai-edge-sql',\n          href: '/sql-database',\n          tagValue: 'Preview'\n        }\n      ]\n    },\n    {\n      label: 'More',\n      items: [\n        {\n          id: 'settings',\n          label: 'Settings',\n          icon: 'pi pi-cog',\n          kind: 'drill',\n          groups: [\n            {\n              label: 'Settings',\n              items: [\n                { id: 'settings-general', label: 'General', href: '/settings' },\n                { id: 'settings-users', label: 'Users management', href: '/settings/users' }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n</script>\n\n<template>\n  <ConsoleLayout\n    :navigation=\"navigation\"\n    :breadcrumbs=\"[{ label: 'Workloads', href: '/workloads' }, { label: 'edge-shop' }]\"\n    :account=\"{ name: 'Ana Souza', email: 'ana.souza@example.com' }\"\n    active-id=\"workloads\"\n  >\n    <template #actions=\"{ compact }\">\n      <Tooltip\n        v-if=\"compact\"\n        text=\"Create\"\n        placement=\"bottom\"\n      >\n        <IconButton\n          icon=\"pi pi-plus-circle\"\n          kind=\"primary\"\n          size=\"medium\"\n          ariaLabel=\"Create\"\n        />\n      </Tooltip>\n      <template v-else>\n        <Button\n          label=\"Create\"\n          kind=\"primary\"\n          size=\"medium\"\n          icon=\"pi pi-plus-circle\"\n        />\n        <ButtonHighlight\n          label=\"Agent\"\n          size=\"medium\"\n          icon=\"ai ai-ask-azion\"\n        />\n      </template>\n    </template>\n\n    <template #search=\"{ query }\">\n      <Command.Group\n        v-if=\"!query\"\n        heading=\"Recents\"\n      >\n        <Command.Item value=\"recent:edge-shop\">edge-shop</Command.Item>\n        <Command.Item value=\"recent:auth-handler\">auth-handler</Command.Item>\n      </Command.Group>\n    </template>\n\n    <template #account-menu>\n      <DropdownMenu.Group>\n        <DropdownMenu.Option\n          value=\"settings\"\n          label=\"Account settings\"\n        />\n        <DropdownMenu.Option\n          value=\"logout\"\n          label=\"Log out\"\n        />\n      </DropdownMenu.Group>\n    </template>\n\n    <div class=\"layout-boundary\">\n      <div class=\"layout-column flex flex-col gap-(--layout-group-gap)\">\n        <PageHeader\n          title=\"edge-shop\"\n          description=\"The workload that serves the storefront.\"\n        />\n        <EmptyState\n          title=\"No deployments yet\"\n          description=\"Deploy the workload to see its history here.\"\n        />\n      </div>\n    </div>\n  </ConsoleLayout>\n</template>"
  },
  {
   "name": "PageOpensSearch",
   "summary": "A page inside the layout opens the shared ⌘K palette from its own button with `useConsoleLayout().openSearch()`; it never mounts a second palette.",
   "sfc": "<script setup lang=\"ts\">\n  import Button from '@aziontech/webkit/button'\n  import ConsoleLayout, { type ConsoleLayoutNavGroup } from '@aziontech/webkit/console-layout'\n  import PageHeader from '@aziontech/webkit/page-header'\n  import { useConsoleLayout } from '@aziontech/webkit/use-console-layout'\n  import { defineComponent, h } from 'vue'\n\n  const navigation: ConsoleLayoutNavGroup[] = [\n    {\n      items: [\n        { id: 'overview', label: 'Overview', icon: 'ai ai-home', href: '/' },\n        { id: 'workloads', label: 'Workloads', icon: 'ai ai-workloads', href: '/workloads' },\n        { id: 'functions', label: 'Functions', icon: 'ai ai-edge-functions', href: '/functions' }\n      ]\n    }\n  ]\n\n  const FindWorkload = defineComponent({\n    name: 'FindWorkload',\n    setup() {\n      const { openSearch } = useConsoleLayout()\n      return () =>\n        h(Button, {\n          label: 'Find a workload',\n          icon: 'pi pi-search',\n          kind: 'outlined',\n          size: 'medium',\n          onClick: openSearch\n        })\n    }\n  })\n</script>\n\n<template>\n  <ConsoleLayout\n    :navigation=\"navigation\"\n    active-id=\"workloads\"\n  >\n    <div class=\"layout-boundary\">\n      <div class=\"layout-column flex flex-col gap-(--layout-group-gap)\">\n        <PageHeader\n          title=\"Workloads\"\n          description=\"Open the same palette as the header search, from the page.\"\n        >\n          <template #actions>\n            <FindWorkload />\n          </template>\n        </PageHeader>\n      </div>\n    </div>\n  </ConsoleLayout>\n</template>"
  },
  {
   "name": "NavigationExpanded",
   "summary": "`v-model:navigation-expanded` binds the rail: a `Collapse sidebar` / `Expand sidebar` command in the palette's `search` slot folds and restores it, and the app can persist the value.",
   "sfc": "<script setup lang=\"ts\">\n  import Command from '@aziontech/webkit/command'\n  import ConsoleLayout, { type ConsoleLayoutNavGroup } from '@aziontech/webkit/console-layout'\n  import PageHeader from '@aziontech/webkit/page-header'\n  import { ref } from 'vue'\n\n  const navigation: ConsoleLayoutNavGroup[] = [\n    {\n      items: [\n        { id: 'overview', label: 'Overview', icon: 'ai ai-home', href: '/' },\n        { id: 'workloads', label: 'Workloads', icon: 'ai ai-workloads', href: '/workloads' },\n        { id: 'functions', label: 'Functions', icon: 'ai ai-edge-functions', href: '/functions' }\n      ]\n    }\n  ]\n\n  const navigationExpanded = ref(true)\n\n  const onSearchSelect = (_event: MouseEvent | KeyboardEvent, value: string | number) => {\n    if (value === 'action:sidebar') navigationExpanded.value = !navigationExpanded.value\n  }\n</script>\n\n<template>\n  <ConsoleLayout\n    v-model:navigation-expanded=\"navigationExpanded\"\n    :navigation=\"navigation\"\n    active-id=\"workloads\"\n    @search-select=\"onSearchSelect\"\n  >\n    <template #search>\n      <Command.Group heading=\"Actions\">\n        <Command.Item value=\"action:sidebar\">\n          <template #prefix>\n            <i\n              :class=\"navigationExpanded ? 'pi pi-angle-double-left' : 'pi pi-angle-double-right'\"\n              aria-hidden=\"true\"\n            />\n          </template>\n          {{ navigationExpanded ? 'Collapse sidebar' : 'Expand sidebar' }}\n        </Command.Item>\n      </Command.Group>\n    </template>\n\n    <div class=\"layout-boundary\">\n      <div class=\"layout-column\">\n        <PageHeader\n          title=\"Workloads\"\n          description=\"Press ⌘K or Ctrl K and choose Collapse sidebar to fold the rail.\"\n        />\n      </div>\n    </div>\n  </ConsoleLayout>\n</template>"
  }
 ]
}
