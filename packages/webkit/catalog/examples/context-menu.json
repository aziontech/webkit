{
 "examples": [
  {
   "name": "Default",
   "summary": "A list of resources inside `ContextMenu.Trigger`. Right-click a row, press `Shift+F10` or the context-menu key on a focused row, or long-press it on touch: the menu opens at the pointer (or under the row) and focus returns to the row on close. Read which row was targeted from a native `@contextmenu` on the row.",
   "sfc": "<script setup>\n  import ContextMenu from '@aziontech/webkit/context-menu'\n  import { ref } from 'vue'\n\n  const resources = ['production', 'staging', 'docs-site']\n  const target = ref('')\n  const last = ref('')\n\n  const onSelect = (event, value) => {\n    last.value = `${value} · ${target.value}`\n  }\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-sm) flex-col gap-(--spacing-sm)\">\n    <ContextMenu\n      :aria-label=\"target ? `Actions for ${target}` : 'Resource actions'\"\n      @select=\"onSelect\"\n    >\n      <ContextMenu.Trigger>\n        <ul\n          class=\"flex flex-col rounded-(--shape-card) border border-(--border-default) bg-(--bg-surface)\"\n        >\n          <li\n            v-for=\"name in resources\"\n            :key=\"name\"\n            tabindex=\"0\"\n            class=\"flex h-10 items-center border-b border-(--border-default) px-(--spacing-md) text-body-sm text-(--text-default) outline-none last:border-b-0 focus-visible:ring-2 focus-visible:ring-(--ring-color)\"\n            @contextmenu=\"target = name\"\n            @focus=\"target = name\"\n          >\n            {{ name }}\n          </li>\n        </ul>\n      </ContextMenu.Trigger>\n\n      <ContextMenu.Group>\n        <ContextMenu.Item\n          value=\"open\"\n          label=\"Open\"\n        />\n        <ContextMenu.Item\n          value=\"rename\"\n          label=\"Rename\"\n          command=\"F2\"\n        />\n        <ContextMenu.Item\n          value=\"duplicate\"\n          label=\"Duplicate\"\n        />\n      </ContextMenu.Group>\n      <ContextMenu.Group>\n        <ContextMenu.Item\n          value=\"delete\"\n          label=\"Delete\"\n        />\n      </ContextMenu.Group>\n    </ContextMenu>\n\n    <p class=\"text-body-sm text-(--text-muted)\">\n      Right-click a row, press Shift+F10 on a focused row, or long-press it on touch.\n      <span v-if=\"last\">Last action: {{ last }}</span>\n    </p>\n  </div>\n</template>"
  },
  {
   "name": "WithSubMenu",
   "summary": "Panel forced open (`:open=\"true\"`) to show the anatomy it shares with `DropdownMenu`: groups, a `command` hint, an open `Sub` (`default-open`) and `type=\"checkbox\"` items that keep the panel open.",
   "sfc": "<script setup>\n  import ContextMenu from '@aziontech/webkit/context-menu'\n  import { reactive } from 'vue'\n\n  const view = reactive({ hidden: false, grid: true })\n\n  const onSelect = (event, value) => {\n    if (value in view) view[value] = !view[value]\n  }\n</script>\n\n<template>\n  <ContextMenu\n    :open=\"true\"\n    aria-label=\"File actions\"\n    @select=\"onSelect\"\n  >\n    <ContextMenu.Trigger>\n      <div\n        class=\"flex h-40 w-full max-w-(--container-sm) items-center justify-center rounded-(--shape-card) border border-dashed border-(--border-default) text-body-sm text-(--text-muted)\"\n      >\n        site-assets\n      </div>\n    </ContextMenu.Trigger>\n\n    <ContextMenu.Group>\n      <ContextMenu.Item\n        value=\"open\"\n        label=\"Open\"\n      />\n      <ContextMenu.Item\n        value=\"rename\"\n        label=\"Rename\"\n        command=\"F2\"\n      />\n      <ContextMenu.Sub default-open>\n        <ContextMenu.SubTrigger label=\"Move to\" />\n        <ContextMenu.SubContent>\n          <ContextMenu.Group>\n            <ContextMenu.Item\n              value=\"production\"\n              label=\"production\"\n            />\n            <ContextMenu.Item\n              value=\"staging\"\n              label=\"staging\"\n            />\n          </ContextMenu.Group>\n        </ContextMenu.SubContent>\n      </ContextMenu.Sub>\n    </ContextMenu.Group>\n\n    <ContextMenu.Group label=\"View\">\n      <ContextMenu.Item\n        value=\"hidden\"\n        label=\"Show hidden files\"\n        type=\"checkbox\"\n        :selected=\"view.hidden\"\n      />\n      <ContextMenu.Item\n        value=\"grid\"\n        label=\"Grid layout\"\n        type=\"checkbox\"\n        :selected=\"view.grid\"\n      />\n    </ContextMenu.Group>\n\n    <ContextMenu.Group>\n      <ContextMenu.Item\n        value=\"delete\"\n        label=\"Delete\"\n      />\n    </ContextMenu.Group>\n  </ContextMenu>\n</template>"
  },
  {
   "name": "Disabled",
   "summary": "`disabled` leaves the area to the browser: right-click shows the native context menu and the panel never opens.",
   "sfc": "<script setup>\n  import ContextMenu from '@aziontech/webkit/context-menu'\n</script>\n\n<template>\n  <ContextMenu\n    disabled\n    aria-label=\"File actions\"\n  >\n    <ContextMenu.Trigger>\n      <div\n        class=\"flex h-40 w-full max-w-(--container-sm) items-center justify-center rounded-(--shape-card) border border-dashed border-(--border-default) text-body-sm text-(--text-muted)\"\n      >\n        Right-click shows the browser menu\n      </div>\n    </ContextMenu.Trigger>\n\n    <ContextMenu.Group>\n      <ContextMenu.Item\n        value=\"open\"\n        label=\"Open\"\n      />\n    </ContextMenu.Group>\n  </ContextMenu>\n</template>"
  }
 ]
}
