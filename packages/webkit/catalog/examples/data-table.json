{
 "examples": [
  {
   "name": "Default",
   "summary": "A standard data-driven table: pass `:data` and `:columns` and the engine renders sortable headers, status `Tag`s, per-row action menus, and pagination. The outer card border is drawn via the `border` prop — the table is borderless by default (it usually sits inside a surface that already frames it), so set `border` to draw the `var(--border-default)` outline; the internal row dividers are unaffected either way.",
   "sfc": "<script setup>\n  import DataTable from '@aziontech/webkit/data-table'\n  import DropdownMenuGroup from '@aziontech/webkit/dropdown-menu-group'\n  import DropdownMenuOption from '@aziontech/webkit/dropdown-menu-option'\n  import DropdownMenuRoot from '@aziontech/webkit/dropdown-menu-root'\n  import DropdownMenuTrigger from '@aziontech/webkit/dropdown-menu-trigger'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Tag from '@aziontech/webkit/tag'\n  import { ref } from 'vue'\n\n  const rows = [\n    {\n      id: '1001',\n      name: 'Workload Alpha',\n      status: 'Active',\n      editor: 'user1@example.com',\n      modified: 'Jan 1, 2026, 09:00 AM',\n      protocol: 'HTTP & HTTPS',\n      domains: 2,\n      origins: 1,\n      created: 'Dec 1, 2025, 10:00 AM'\n    },\n    {\n      id: '1002',\n      name: 'Workload Bravo',\n      status: 'Inactive',\n      editor: 'user2@example.com',\n      modified: 'Jan 2, 2026, 09:00 AM',\n      protocol: 'HTTP',\n      domains: 1,\n      origins: 2,\n      created: 'Dec 2, 2025, 10:00 AM'\n    },\n    {\n      id: '1003',\n      name: 'Workload Charlie',\n      status: 'Degraded',\n      editor: 'user3@example.com',\n      modified: 'Jan 3, 2026, 09:00 AM',\n      protocol: 'gRPC',\n      domains: 3,\n      origins: 1,\n      created: 'Dec 3, 2025, 10:00 AM'\n    }\n  ]\n\n  const columns = [\n    { accessorKey: 'name', header: 'Name' },\n    { accessorKey: 'id', header: 'ID', enableSorting: false },\n    { accessorKey: 'status', header: 'Status' },\n    { accessorKey: 'editor', header: 'Last Editor', enableSorting: false, grow: 2 },\n    { accessorKey: 'modified', header: 'Last Modified', grow: 2 },\n    { id: 'actions', header: '', kind: 'action', enableSorting: false }\n  ]\n\n  const sorting = ref([])\n\n  const rowActionGroups = [\n    [\n      { value: 'view', label: 'View details', icon: 'ai ai-eye' },\n      { value: 'edit', label: 'Edit', icon: 'ai ai-pencil' },\n      { value: 'duplicate', label: 'Duplicate', icon: 'ai ai-copy' }\n    ],\n    [{ value: 'delete', label: 'Delete', icon: 'ai ai-trash' }]\n  ]\n\n  const statusSeverity = (status) =>\n    status === 'Active' ? 'success' : status === 'Degraded' ? 'warning' : 'danger'\n\n  const onRowClick = (_row) => {}\n  const onRowAction = (_payload) => {}\n</script>\n\n<template>\n  <DataTable\n    :data=\"rows\"\n    :columns=\"columns\"\n    row-key=\"id\"\n    enable-sorting\n    paginated\n    :page-size=\"5\"\n    bordered\n    v-model:sorting=\"sorting\"\n    @row-click=\"onRowClick\"\n  >\n    <template #cell-name=\"{ row, value }\">\n      <a\n        :href=\"'/workloads/' + row.id\"\n        class=\"cursor-pointer truncate text-(--text-default) no-underline hover:underline active:underline\"\n        >{{ value }}</a\n      >\n    </template>\n    <template #cell-status=\"{ value }\">\n      <Tag :severity=\"statusSeverity(value)\">{{ value }}</Tag>\n    </template>\n    <template #header-actions>\n      <span class=\"sr-only\">Actions</span>\n    </template>\n    <template #cell-actions=\"{ row }\">\n      <DropdownMenuRoot @select=\"({ value }) => onRowAction({ id: row.id, action: { value } })\">\n        <DropdownMenuTrigger>\n          <IconButton\n            icon=\"ai ai-ellipsis-v\"\n            aria-label=\"Row actions\"\n            kind=\"transparent\"\n            size=\"small\"\n          />\n        </DropdownMenuTrigger>\n        <DropdownMenuGroup\n          v-for=\"(group, gi) in rowActionGroups\"\n          :key=\"gi\"\n        >\n          <DropdownMenuOption\n            v-for=\"option in group\"\n            :key=\"option.value\"\n            :value=\"option.value\"\n            :label=\"option.label\"\n          >\n            <template #leading\n              ><i\n                :class=\"option.icon\"\n                aria-hidden=\"true\"\n            /></template>\n          </DropdownMenuOption>\n        </DropdownMenuGroup>\n      </DropdownMenuRoot>\n    </template>\n  </DataTable>\n</template>"
  },
