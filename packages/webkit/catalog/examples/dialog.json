l gap-(--spacing-sm) md:flex-row md:justify-end\">\n          <Button\n            label=\"Cancel\"\n            variant=\"outline\"\n            @click=\"open = false\"\n          />\n          <Button\n            label=\"Save\"\n            variant=\"primary\"\n          />\n        </div>\n      </PanelFooter>\n    </DialogContent>\n  </Dialog>\n</template>"
  }
