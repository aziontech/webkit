{
 "examples": [
  {
   "name": "Default",
   "summary": "Medium modal with a trigger, overlay backdrop, and header/body/footer panel regions.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Dialog from '@aziontech/webkit/dialog'\n  import DialogClose from '@aziontech/webkit/dialog-close'\n  import DialogContent from '@aziontech/webkit/dialog-content'\n  import DialogDescription from '@aziontech/webkit/dialog-description'\n  import DialogOverlay from '@aziontech/webkit/dialog-overlay'\n  import DialogPortal from '@aziontech/webkit/dialog-portal'\n  import DialogTitle from '@aziontech/webkit/dialog-title'\n  import DialogTrigger from '@aziontech/webkit/dialog-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n</script>\n\n<template>\n  <Dialog\n    v-model:open=\"open\"\n    dismissible\n    size=\"medium\"\n  >\n    <DialogTrigger>\n      <Button\n        label=\"Open dialog\"\n        kind=\"primary\"\n      />\n    </DialogTrigger>\n    <DialogPortal>\n      <DialogOverlay />\n      <DialogContent>\n        <PanelHeader class=\"w-full\">\n          <DialogTitle>Dialog Title</DialogTitle>\n          <DialogClose />\n        </PanelHeader>\n        <PanelContent>\n          <DialogDescription>\n            Modal content. Uses the shared Panel header, body, and footer regions.\n          </DialogDescription>\n        </PanelContent>\n        <PanelFooter class=\"flex-col md:flex-row md:justify-end\">\n          <Button\n            class=\"w-full md:w-auto\"\n            label=\"Cancel\"\n            kind=\"outlined\"\n            @click=\"open = false\"\n          />\n          <Button\n            class=\"w-full md:w-auto\"\n            label=\"Save\"\n            kind=\"primary\"\n          />\n        </PanelFooter>\n      </DialogContent>\n    </DialogPortal>\n  </Dialog>\n</template>"
  },
  {
   "name": "Sizes",
   "summary": "The three `size` presets. Each caps the panel max-width from the `md` breakpoint up; below `md` the dialog is a full-width bottom sheet regardless of `size`.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Dialog from '@aziontech/webkit/dialog'\n  import DialogClose from '@aziontech/webkit/dialog-close'\n  import DialogContent from '@aziontech/webkit/dialog-content'\n  import DialogDescription from '@aziontech/webkit/dialog-description'\n  import DialogOverlay from '@aziontech/webkit/dialog-overlay'\n  import DialogPortal from '@aziontech/webkit/dialog-portal'\n  import DialogTitle from '@aziontech/webkit/dialog-title'\n  import DialogTrigger from '@aziontech/webkit/dialog-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n\n  import { reactive, watch } from 'vue'\n\n  const sizes = ['small', 'medium', 'large']\n  const sizeLabels = { small: 'Small', medium: 'Medium', large: 'Large' }\n  const openBySize = reactive({ small: false, medium: false, large: false })\n\n  watch(\n    openBySize,\n    () => {\n      const openKey = sizes.find((key) => openBySize[key])\n      if (!openKey) return\n      sizes.forEach((key) => {\n        if (key !== openKey) openBySize[key] = false\n      })\n    },\n    { deep: true }\n  )\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-center gap-(--spacing-md)\">\n    <Dialog\n      v-for=\"size in sizes\"\n      :key=\"size\"\n      v-model:open=\"openBySize[size]\"\n      :size=\"size\"\n    >\n      <DialogTrigger>\n        <Button\n          :label=\"sizeLabels[size]\"\n          kind=\"outlined\"\n        />\n      </DialogTrigger>\n      <DialogPortal>\n        <DialogOverlay />\n        <DialogContent>\n          <PanelHeader class=\"w-full\">\n            <DialogTitle>{{ sizeLabels[size] }}</DialogTitle>\n            <DialogClose />\n          </PanelHeader>\n          <PanelContent>\n            <DialogDescription>\n              Panel max-width preset for the {{ size }} dialog, applied from the md breakpoint up.\n            </DialogDescription>\n          </PanelContent>\n          <PanelFooter class=\"flex-col md:flex-row md:justify-end\">\n            <Button\n              class=\"w-full md:w-auto\"\n              label=\"Close\"\n              kind=\"outlined\"\n              @click=\"openBySize[size] = false\"\n            />\n          </PanelFooter>\n        </DialogContent>\n      </DialogPortal>\n    </Dialog>\n  </div>\n</template>"
  },
  {
   "name": "ScrollContent",
   "summary": "A body taller than the dialog, centered above the page (from `md` up). Open it from the trigger: the panel bounds the surface and `PanelContent` is the only region that scrolls, so the title and the footer actions stay put while the body moves.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Dialog from '@aziontech/webkit/dialog'\n  import DialogClose from '@aziontech/webkit/dialog-close'\n  import DialogContent from '@aziontech/webkit/dialog-content'\n  import DialogDescription from '@aziontech/webkit/dialog-description'\n  import DialogOverlay from '@aziontech/webkit/dialog-overlay'\n  import DialogPortal from '@aziontech/webkit/dialog-portal'\n  import DialogTitle from '@aziontech/webkit/dialog-title'\n  import DialogTrigger from '@aziontech/webkit/dialog-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n</script>\n\n<template>\n  <Dialog\n    v-model:open=\"open\"\n    dismissible\n    size=\"medium\"\n  >\n    <DialogTrigger>\n      <Button\n        label=\"Open dialog\"\n        kind=\"primary\"\n      />\n    </DialogTrigger>\n    <DialogPortal>\n      <DialogOverlay />\n      <DialogContent>\n        <PanelHeader class=\"w-full\">\n          <DialogTitle>Domain settings</DialogTitle>\n          <DialogClose />\n        </PanelHeader>\n        <PanelContent>\n          <DialogDescription>Body taller than the dialog, so it has to scroll.</DialogDescription>\n          <p>\n            Setting 1 — the body is the only region that scrolls, so the title and the footer\n            actions stay reachable.\n          </p>\n          <p>\n            Setting 2 — the body is the only region that scrolls, so the title and the footer\n            actions stay reachable.\n          </p>\n          <p>\n            Setting 3 — the body is the only region that scrolls, so the title and the footer\n            actions stay reachable.\n          </p>\n          <p>\n            Setting 4 — the body is the only region that scrolls, so the title and the footer\n            actions st