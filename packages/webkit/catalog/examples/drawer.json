{
 "examples": [
  {
   "name": "Default",
   "summary": "Right-side large drawer with a trigger and header/body/footer panel regions. `Drawer.Content` renders the overlay and the header gets the close button on its own.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Drawer from '@aziontech/webkit/drawer'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n</script>\n\n<template>\n  <Drawer\n    v-model:open=\"open\"\n    dismissible\n    side=\"end\"\n    size=\"large\"\n  >\n    <Drawer.Trigger>\n      <Button\n        label=\"Open drawer\"\n        variant=\"primary\"\n      />\n    </Drawer.Trigger>\n    <Drawer.Content>\n      <Drawer.Header class=\"w-full\">\n        <Drawer.Title>Drawer Title</Drawer.Title>\n      </Drawer.Header>\n      <Drawer.Body>\n        <Drawer.Description>\n          Side panel content. Uses the same Panel header, body, and footer regions as Dialog.\n        </Drawer.Description>\n      </Drawer.Body>\n      <Drawer.Footer>\n        <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n          <Button\n            label=\"Cancel\"\n            variant=\"outline\"\n            @click=\"open = false\"\n          />\n          <Button\n            label=\"Save\"\n            variant=\"primary\"\n          />\n        </div>\n      </Drawer.Footer>\n    </Drawer.Content>\n  </Drawer>\n</template>"
  },
  {
   "name": "Sizes",
   "summary": "Small (384px), medium (672px), and large (1024px) max-width presets side by side.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import DrawerContent from '@aziontech/webkit/drawer-content'\n  import DrawerDescription from '@aziontech/webkit/drawer-description'\n  import Drawer from '@aziontech/webkit/drawer-root'\n  import DrawerTitle from '@aziontech/webkit/drawer-title'\n  import DrawerTrigger from '@aziontech/webkit/drawer-trigger'\n  import PanelBody from '@aziontech/webkit/panel-body'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { reactive, watch } from 'vue'\n\n  const sizes = ['small', 'medium', 'large']\n  const sizeLabels = {\n    small: 'Small (384px)',\n    medium: 'Medium (672px)',\n    large: 'Large (1024px)'\n  }\n  const openBySize = reactive({ small: false, medium: false, large: false })\n\n  watch(\n    openBySize,\n    () => {\n      const openKey = sizes.find((key) => openBySize[key])\n      if (!openKey) return\n      sizes.forEach((key) => {\n        if (key !== openKey) openBySize[key] = false\n      })\n    },\n    { deep: true }\n  )\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-center justify-center gap-(--spacing-4)\">\n    <Drawer\n      v-for=\"size in sizes\"\n      :key=\"size\"\n      :size=\"size\"\n      v-model:open=\"openBySize[size]\"\n      dismissible\n      side=\"end\"\n    >\n      <DrawerTrigger>\n        <Button\n          :label=\"sizeLabels[size]\"\n          variant=\"primary\"\n        />\n      </DrawerTrigger>\n      <DrawerContent>\n        <PanelHeader class=\"w-full\">\n          <DrawerTitle>{{ sizeLabels[size] }}</DrawerTitle>\n        </PanelHeader>\n        <PanelBody>\n          <DrawerDescription>\n            Panel max-width preset for the {{ size }} drawer. Height is always 100% viewport.\n          </DrawerDescription>\n        </PanelBody>\n        <PanelFooter>\n          <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n            <Button\n              label=\"Cancel\"\n              variant=\"outline\"\n              @click=\"openBySize[size] = false\"\n            />\n            <Button\n              label=\"Save\"\n              variant=\"primary\"\n            />\n          </div>\n        </PanelFooter>\n      </DrawerContent>\n    </Drawer>\n  </div>\n</template>"
  },
  {
   "name": "ScrollContent",
   "summary": "Long content in `PanelBody` scrolls inside `ScrollArea`. The header and footer stay in the panel flex layout at the top and bottom; only the body scrolls.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import DrawerContent from '@aziontech/webkit/drawer-content'\n  import DrawerDescription from '@aziontech/webkit/drawer-description'\n  import Drawer from '@aziontech/webkit/drawer-root'\n  import DrawerTitle from '@aziontech/webkit/drawer-title'\n  import DrawerTrigger from '@aziontech/webkit/drawer-trigger'\n  import PanelBody from '@aziontech/webkit/panel-body'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n  const scrollSections = Array.from({ length: 12 }, (_, index) => ({\n    title: `Section ${index + 1}`,\n    body: `Scrollable drawer body copy for section ${index + 1}. Only PanelBody scrolls; header and footer stay in the panel layout.`\n  }))\n</script>\n\n<template>\n  <Drawer\n    v-model:open=\"open\"\n    dismissible\n    side=\"end\"\n    size=\"large\"\n  >\n    <DrawerTrigger>\n      <Button\n        label=\"Open scrollable drawer\"\n        variant=\"primary\"\n      />\n    </DrawerTrigger>\n    <DrawerContent>\n      <PanelHeader class=\"w-full\">\n        <DrawerTitle>Scrollable drawer</DrawerTitle>\n      </PanelHeader>\n      <PanelBody>\n        <div class=\"flex flex-col gap-(--spacing-4)\">\n          <DrawerDescription>\n            Place long forms, lists, or settings inside PanelBody. Only the body scrolls inside\n            ScrollArea while header and footer stay in the panel layout.\n          </DrawerDescription>\n          <section\n            v-for=\"section in scrollSections\"\n            :key=\"section.title\"\n            class=\"flex flex-col gap-(--spacing-2) rounded-(--shape-control) border border-(length:--border-width-default) border-(--border-muted) p-(--spacing-4)\"\n          >\n            <h3 class=\"m-0 text-body-md text-(--text-default)\">{{ section.title }}</h3>\n            <p class=\"m-0 text-body-sm text-(--text-muted)\">{{ section.body }}</p>\n          </section>\n        </div>\n      </PanelBody>\n      <PanelFooter>\n        <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n          <Button\n            label=\"Cancel\"\n            variant=\"outline\"\n            @click=\"open = false\"\n          />\n          <Button\n            label=\"Save\"\n            variant=\"primary\"\n          />\n        </div>\n      </PanelFooter>\n    </DrawerContent>\n  </Drawer>\n</template>"
  }
 ]
}
