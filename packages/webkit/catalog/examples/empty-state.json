   "summary": "The size variants — small and medium — stacked.",
   "sfc": "<script setup>\n  import EmptyState from '@aziontech/webkit/empty-state'\n  import Button from '@aziontech/webkit/button'\n  import MiniButton from '@aziontech/webkit/mini-button'\n</script>\n\n<template>\n  <div class=\"flex w-full flex-col gap-(--spacing-xl)\">\n    <EmptyState\n      v-for=\"size in ['small', 'medium']\"\n      :key=\"size\"\n      :size=\"size\"\n      title=\"No resource yet\"\n      description=\"Get started by creating your first resource.\"\n      icon=\"pi pi-inbox\"\n    >\n      <template #actions>\n        <div class=\"flex gap-(--spacing-3)\">\n          <Button\n            kind=\"secondary\"\n            label=\"Secondary Item\"\n          />\n          <Button\n            kind=\"outlined\"\n            label=\"Create Item\"\n          />\n        </div>\n        <MiniButton\n          label=\"Docs\"\n          icon=\"pi pi-arrow-right\"\n          size=\"medium\"\n          href=\"#\"\n        />\n      </template>\n    </EmptyState>\n  </div>\n</template>"
