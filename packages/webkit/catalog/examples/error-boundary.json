{
 "examples": [
  {
   "name": "Default",
   "summary": "A card's list is wrapped in a boundary. Simulate a failure: the list is replaced by a danger Alert with Try again, the rest of the page keeps working, and the error event reports what was thrown.",
   "sfc": "<script setup>\n  import BarList from '@aziontech/webkit/bar-list'\n  import Button from '@aziontech/webkit/button'\n  import Card from '@aziontech/webkit/card'\n  import ErrorBoundary from '@aziontech/webkit/error-boundary'\n  import { ref } from 'vue'\n\n  const items = [\n    { id: 'web-app-prod', name: 'web-app-prod', value: 11420000 },\n    { id: 'payments-api', name: 'payments-api', value: 6240000 },\n    { id: 'storefront-checkout', name: 'storefront-checkout', value: 4910000 }\n  ]\n\n  const broken = ref(false)\n  const reported = ref('')\n\n  const format = (value) =>\n    new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(value)\n\n  const failingFormat = () => {\n    throw new Error('The response held a value the list could not read.')\n  }\n\n  const report = ({ error }) => {\n    reported.value = error instanceof Error ? error.message : String(error)\n  }\n\n  const recover = () => {\n    broken.value = false\n    reported.value = ''\n  }\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-[512px] flex-col gap-(--spacing-sm)\">\n    <Card title=\"Top services\">\n      <template #content>\n        <ErrorBoundary\n          @error=\"report\"\n          @retry=\"recover\"\n        >\n          <BarList\n            :items=\"items\"\n            :format-value=\"broken ? failingFormat : format\"\n            aria-label=\"Top services by requests\"\n          />\n        </ErrorBoundary>\n      </template>\n    </Card>\n    <div class=\"flex flex-wrap items-center gap-(--spacing-xs)\">\n      <Button\n        label=\"Simulate a failure\"\n        kind=\"outlined\"\n        size=\"medium\"\n        :disabled=\"broken\"\n        @click=\"broken = true\"\n      />\n      <p\n        v-if=\"reported\"\n        class=\"m-0 text-body-sm text-(--text-muted)\"\n      >\n        Reported: {{ reported }}\n      </p>\n    </div>\n  </div>\n</template>"
  },
  {
   "name": "Custom fallback",
   "summary": "The fallback slot draws a small EmptyState in the card's place, sized to the region, with its own Try again bound to the slot's retry.",
   "sfc": "<script setup>\n  import BarList from '@aziontech/webkit/bar-list'\n  import Button from '@aziontech/webkit/button'\n  import Card from '@aziontech/webkit/card'\n  import EmptyState from '@aziontech/webkit/empty-state'\n  import ErrorBoundary from '@aziontech/webkit/error-boundary'\n  import { ref } from 'vue'\n\n  const items = [\n    { id: 'south-america', name: 'South America', value: 9820000 },\n    { id: 'north-america', name: 'North America', value: 7410000 },\n    { id: 'europe', name: 'Europe', value: 4960000 }\n  ]\n\n  const broken = ref(false)\n\n  const format = (value) =>\n    new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(value)\n\n  const failingFormat = () => {\n    throw new Error('Unreadable value.')\n  }\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-[512px] flex-col gap-(--spacing-sm)\">\n    <Card title=\"Requests by region\">\n      <template #content>\n        <ErrorBoundary @retry=\"broken = false\">\n          <BarList\n            :items=\"items\"\n            :format-value=\"broken ? failingFormat : format\"\n            aria-label=\"Requests by region\"\n          />\n          <template #fallback=\"{ retry }\">\n            <EmptyState\n              title=\"This chart failed to load\"\n              description=\"The rest of the dashboard still works.\"\n              icon=\"pi pi-exclamation-triangle\"\n              size=\"small\"\n            >\n              <template #actions>\n                <Button\n                  label=\"Try again\"\n                  kind=\"outlined\"\n                  size=\"medium\"\n                  icon=\"pi pi-refresh\"\n                  @click=\"retry\"\n                />\n              </template>\n            </EmptyState>\n          </template>\n        </ErrorBoundary>\n      </template>\n    </Card>\n    <Button\n      label=\"Simulate a failure\"\n      kind=\"outlined\"\n      size=\"medium\"\n      class=\"self-start\"\n      :disabled=\"broken\"\n      @click=\"broken = true\"\n    />\n  </div>\n</template>"
  }
 ]
}
