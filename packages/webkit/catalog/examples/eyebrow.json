 "examples": [
  {
   "name": "Default",
   "summary": "Default overline label without prefix or cursor.",
   "sfc": "<script setup>\n  import Eyebrow from '@aziontech/webkit/eyebrow'\n</script>\n\n<template>\n  <Eyebrow>OVERLINE TEXT</Eyebrow>\n</template>"
  },
  {
   "name": "Prefixes",
   "summary": "All preset prefixes side by side: `//`, `<>`, and `</>`.",
   "sfc": "<script setup>\n  import Eyebrow from '@aziontech/webkit/eyebrow'\n</script>\n\n<template>\n  <div class=\"flex flex-col items-start gap-4\">\n    <Eyebrow prefix=\"//\">COMMENT STYLE</Eyebrow>\n    <Eyebrow prefix=\"<>\">CODE LABEL</Eyebrow>\n    <Eyebrow prefix=\"</>\">CLOSING TAG</Eyebrow>\n  </div>\n</template>"
  },
  {
   "name": "Cursor",
   "summary": "Blinking terminal-style cursor at the end of the text, shown with and without a prefix.",
   "sfc": "<script setup>\n  import Eyebrow from '@aziontech/webkit/eyebrow'\n</script>\n\n<template>\n  <div class=\"flex flex-col items-start gap-4\">\n    <Eyebrow\n      cursor\n      prefix=\"//\"\n      >OVERLINE TEXT</Eyebrow\n    >\n    <Eyebrow cursor>NO PREFIX</Eyebrow>\n  </div>\n</template>"
  }
 ]
