{
 "examples": [
  {
   "name": "Default",
   "summary": "An inline drop region with a \"Browse files\" button wired to a hidden file input, the keyboard path to the same outcome.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import FileDropzone from '@aziontech/webkit/file-dropzone'\n  import { ref } from 'vue'\n\n  const input = ref(null)\n  const browse = () => input.value?.click()\n</script>\n\n<template>\n  <div class=\"w-full max-w-(--container-md)\">\n    <FileDropzone description=\"Or browse for files on your computer.\">\n      <Button\n        label=\"Browse files\"\n        kind=\"secondary\"\n        size=\"medium\"\n        @click=\"browse\"\n      />\n    </FileDropzone>\n    <input\n      ref=\"input\"\n      type=\"file\"\n      multiple\n      class=\"hidden\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Folders",
   "summary": "With `directories`, a dropped folder is walked and every file inside arrives in `drop` with its `webkitRelativePath`; Browse folder opens the folder picker (`<input webkitdirectory>`). `FileTokenGroup` names each file by its path.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import FileDropzone from '@aziontech/webkit/file-dropzone'\n  import FileTokenGroup from '@aziontech/webkit/file-token-group'\n  import { ref } from 'vue'\n\n  const filesInput = ref(null)\n  const folderInput = ref(null)\n  const items = ref([])\n\n  const add = (files) => {\n    items.value = [...items.value, ...Array.from(files, (file) => ({ file }))]\n  }\n  const onPick = (event) => {\n    add(event.target.files ?? [])\n    event.target.value = ''\n  }\n  const remove = (index) => {\n    items.value = items.value.filter((_, position) => position !== index)\n  }\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-md) flex-col gap-(--spacing-md)\">\n    <FileDropzone\n      directories\n      title=\"Drop files or folders to upload\"\n      description=\"Folders keep their structure: each file goes up with its path.\"\n      @drop=\"(event, files) => add(files)\"\n    >\n      <div class=\"flex flex-wrap justify-center gap-(--spacing-xs)\">\n        <Button\n          label=\"Browse files\"\n          kind=\"secondary\"\n          size=\"medium\"\n          @click=\"filesInput?.click()\"\n        />\n        <Button\n          label=\"Browse folder\"\n          kind=\"secondary\"\n          size=\"medium\"\n          icon=\"pi pi-folder-open\"\n          @click=\"folderInput?.click()\"\n        />\n      </div>\n    </FileDropzone>\n    <input\n      ref=\"filesInput\"\n      type=\"file\"\n      multiple\n      class=\"hidden\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\"\n      @change=\"onPick\"\n    />\n    <input\n      ref=\"folderInput\"\n      type=\"file\"\n      webkitdirectory\n      class=\"hidden\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\"\n      @change=\"onPick\"\n    />\n    <FileTokenGroup\n      v-if=\"items.length\"\n      :items=\"items\"\n      :limit=\"6\"\n      aria-label=\"Files to upload\"\n      @dismiss=\"remove\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Overlay",
   "summary": "Hidden at rest. Drag a file over the window and the overlay fades in over its nearest positioned ancestor, here the wrapper around the card.",
   "sfc": "<script setup>\n  import Card from '@aziontech/webkit/card'\n  import FileDropzone from '@aziontech/webkit/file-dropzone'\n</script>\n\n<template>\n  <div class=\"relative w-full max-w-(--container-md)\">\n    <Card title=\"Project files\">\n      <template #content>\n        <div class=\"flex min-h-48 flex-col gap-(--spacing-xs)\">\n          <p class=\"text-body-sm text-(--text-muted)\">\n            Drag a file from your computer over this window. The drop target covers this card until\n            you drop the file, leave the window or press Escape.\n          </p>\n        </div>\n      </template>\n    </Card>\n    <FileDropzone kind=\"overlay\" />\n  </div>\n</template>"
  }
 ]
}
