{
 "examples": [
  {
   "name": "Default",
   "summary": "Under a `FileDropzone` with a Browse files button: dropped or picked files join the list as tokens with a type glyph and size, a file over 300 MB stays in the list with its error, and each token's remove button takes it out.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import FileDropzone from '@aziontech/webkit/file-dropzone'\n  import FileTokenGroup from '@aziontech/webkit/file-token-group'\n  import { ref } from 'vue'\n\n  const LIMIT = 300 * 1024 * 1024\n\n  const input = ref(null)\n  const items = ref([\n    { file: { name: 'logo.svg', size: 4210, type: 'image/svg+xml' } },\n    { file: { name: 'index.html', size: 18432, type: 'text/html' } },\n    { file: { name: 'site-backup.tar', size: 412_000_000 }, error: 'Larger than 300 MB' },\n    { file: { name: 'notes.txt', size: 0, type: 'text/plain' }, warning: 'This file is empty' }\n  ])\n\n  const toItem = (file) => ({\n    file,\n    error: file.size > LIMIT ? 'Larger than 300 MB' : undefined,\n    warning: file.size === 0 ? 'This file is empty' : undefined\n  })\n\n  const add = (files) => {\n    items.value = [...items.value, ...Array.from(files).map(toItem)]\n  }\n\n  const onPick = (event) => {\n    add(event.target.files ?? [])\n    event.target.value = ''\n  }\n\n  const remove = (index) => {\n    items.value = items.value.filter((_, position) => position !== index)\n  }\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-md) flex-col gap-(--spacing-sm)\">\n    <FileDropzone\n      description=\"Up to 300 MB per file.\"\n      @drop=\"(event, files) => add(files)\"\n    >\n      <Button\n        label=\"Browse files\"\n        kind=\"secondary\"\n        size=\"medium\"\n        @click=\"input?.click()\"\n      />\n    </FileDropzone>\n    <input\n      ref=\"input\"\n      type=\"file\"\n      multiple\n      class=\"hidden\"\n      aria-hidden=\"true\"\n      tabindex=\"-1\"\n      @change=\"onPick\"\n    />\n    <FileTokenGroup\n      :items=\"items\"\n      @dismiss=\"remove\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Uploading",
   "summary": "While the files upload: a determinate bar on the file with a known progress, an indeterminate bar on the one still starting, a finished file with its last-modified date, and a refused one with its reason.",
   "sfc": "<script setup>\n  import FileTokenGroup from '@aziontech/webkit/file-token-group'\n\n  const items = [\n    {\n      file: { name: 'hero.webp', size: 1_482_000, type: 'image/webp', lastModified: 1762790400000 },\n      loading: false\n    },\n    {\n      file: { name: 'app.js', size: 248_320, type: 'text/javascript' },\n      loading: true,\n      progress: 64\n    },\n    { file: { name: 'styles.css', size: 52_100, type: 'text/css' }, loading: true },\n    {\n      file: { name: 'archive.zip', size: 512_000_000, type: 'application/zip' },\n      error: 'Larger than 300 MB'\n    }\n  ]\n</script>\n\n<template>\n  <div class=\"w-full max-w-(--container-md)\">\n    <FileTokenGroup\n      :items=\"items\"\n      show-file-last-modified\n      aria-label=\"Files to upload\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Horizontal",
   "summary": "`alignment=\"horizontal\"` wraps compact tokens in rows; `limit` shows three and a Show more toggle for the rest.",
   "sfc": "<script setup>\n  import FileTokenGroup from '@aziontech/webkit/file-token-group'\n  import { ref } from 'vue'\n\n  const items = ref(\n    ['robots.txt', 'favicon.ico', 'sitemap.xml', 'manifest.json', 'og-image.png', 'fonts.css'].map(\n      (name, index) => ({ file: { name, size: 1024 * (index + 2) } })\n    )\n  )\n\n  const remove = (index) => {\n    items.value = items.value.filter((_, position) => position !== index)\n  }\n</script>\n\n<template>\n  <div class=\"w-full max-w-(--container-lg)\">\n    <FileTokenGroup\n      :items=\"items\"\n      alignment=\"horizontal\"\n      :limit=\"3\"\n      @dismiss=\"remove\"\n    />\n  </div>\n</template>"
  }
 ]
}
