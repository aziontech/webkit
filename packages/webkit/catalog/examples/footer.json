   "name": "SitePlacement",
   "summary": "The footer closing a framed marketing page: the bands capped at the site measure and centred, with the side rules, the hatched gutters and the framed column whose bottom rule finishes the page frame. The hero band and the framed sections above resolve to that same measure, which is the only reason the rules running down the page are continuous.",
   "sfc": "<script setup>\n  import Brand from '@aziontech/webkit/brand'\n  import Footer from '@aziontech/webkit/footer'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Select from '@aziontech/webkit/select'\n  import StatusIndicator from '@aziontech/webkit/status-indicator'\n  import { ref } from 'vue'\n\n  const language = ref('en')\n  const languageOptions = [\n    { value: 'en', label: 'EN' },\n    { value: 'pt-br', label: 'PT-BR' },\n    { value: 'es', label: 'ES' }\n  ]\n</script>\n\n<template>\n  <Footer\n    kind=\"site\"\n    aria-label=\"Footer\"\n  >\n    <Footer.Column title=\"Products\">\n      <Footer.Link href=\"/products/edge-application\">Edge Application</Footer.Link>\n      <Footer.Link href=\"/products/edge-firewall\">Edge Firewall</Footer.Link>\n      <Footer.Link href=\"/products/edge-storage\">Edge Storage</Footer.Link>\n    </Footer.Column>\n    <Footer.Column title=\"Developers\">\n      <Footer.Link href=\"/documentation\">Docs</Footer.Link>\n      <Footer.Link href=\"/blog\">Blog</Footer.Link>\n      <Footer.Link href=\"/integrations\">Integrations</Footer.Link>\n    </Footer.Column>\n    <Footer.Column title=\"Company\">\n      <Footer.Link href=\"/about\">About us</Footer.Link>\n      <Footer.Link href=\"/careers\">Careers</Footer.Link>\n      <Footer.Link href=\"/legal\">Legal</Footer.Link>\n    </Footer.Column>\n    <Footer.Column title=\"Support\">\n      <Footer.Link href=\"/contact\">Talk to a specialist</Footer.Link>\n      <Footer.Link href=\"/support\">Help center</Footer.Link>\n      <Footer.Link href=\"https://status.azion.com/\">System status</Footer.Link>\n    </Footer.Column>\n    <template #social>\n      <IconButton\n        kind=\"transparent\"\n        size=\"small\"\n        icon=\"pi pi-github\"\n        aria-label=\"Azion on GitHub\"\n        href=\"https://github.com/aziontech\"\n        target=\"_blank\"\n      />\n      <IconButton\n        kind=\"transparent\"\n        size=\"small\"\n        icon=\"pi pi-linkedin\"\n        aria-label=\"Azion on LinkedIn\"\n        href=\"https://www.linkedin.com/company/aziontech\"\n        target=\"_blank\"\n      />\n      <IconButton\n        kind=\"transparent\"\n        size=\"small\"\n        icon=\"pi pi-youtube\"\n        aria-label=\"Azion on YouTube\"\n        href=\"https://www.youtube.com/aziontech\"\n        target=\"_blank\"\n      />\n      <IconButton\n        kind=\"transparent\"\n        size=\"small\"\n        icon=\"pi pi-twitter\"\n        aria-label=\"Azion on X\"\n        href=\"https://x.com/aziontech\"\n        target=\"_blank\"\n      />\n      <IconButton\n        kind=\"transparent\"\n        size=\"small\"\n        icon=\"pi pi-instagram\"\n        aria-label=\"Azion on Instagram\"\n        href=\"https://www.instagram.com/aziontech\"\n        target=\"_blank\"\n      />\n      <IconButton\n        kind=\"transparent\"\n        size=\"small\"\n        icon=\"pi pi-discord\"\n        aria-label=\"Azion on Discord\"\n        href=\"https://discord.gg/azion\"\n        target=\"_blank\"\n      />\n      <IconButton\n        kind=\"transparent\"\n        size=\"small\"\n        icon=\"pi pi-reddit\"\n        aria-label=\"Azion on Reddit\"\n        href=\"https://www.reddit.com/r/aziontech\"\n        target=\"_blank\"\n      />\n    </template>\n    <template #status>\n      <StatusIndicator\n        severity=\"success\"\n        label=\"All Systems Operational\"\n      />\n    </template>\n    <template #language>\n      <div class=\"w-24\">\n        <Select\n          v-model=\"language\"\n          placeholder=\"Language\"\n        >\n          <Select.Trigger aria-label=\"Language\" />\n          <Select.Content>\n            <Select.Option\n              v-for=\"o in languageOptions\"\n              :key=\"o.value\"\n              :value=\"o.value\"\n              >{{ o.label }}</Select.Option\n            >\n          </Select.Content>\n        </Select>\n      </div>\n    </template>\n    <template #brand>\n      <a\n        href=\"/\"\n        aria-label=\"Azion home\"\n      >\n        <Brand size=\"large\" />\n      </a>\n    </template>\n    <template #tagline>The web platform for modern workloads</template>\n  </Footer>\n</template>"
