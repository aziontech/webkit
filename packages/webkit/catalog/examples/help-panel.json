{
 "examples": [
  {
   "name": "Default",
   "summary": "A help topic: a header, two sections that each answer one question, and the Learn more links at the end.",
   "sfc": "<script setup>\n  import HelpPanel from '@aziontech/webkit/help-panel'\n  import Link from '@aziontech/webkit/link'\n</script>\n\n<template>\n  <div class=\"max-w-(--container-xs)\">\n    <HelpPanel aria-label=\"Help: Cache settings\">\n      <HelpPanel.Header\n        title=\"Cache settings\"\n        description=\"How long content stays at the edge before it is fetched again.\"\n      />\n      <HelpPanel.Section title=\"What does the cache TTL control?\">\n        <p>\n          The TTL sets how many seconds an object is served from the edge before the origin is asked\n          for a fresh copy.\n        </p>\n      </HelpPanel.Section>\n      <HelpPanel.Section title=\"When should I bypass the cache?\">\n        <p>Bypass it for responses that change per user, such as carts and account pages.</p>\n      </HelpPanel.Section>\n      <HelpPanel.Links>\n        <Link\n          label=\"Cache settings documentation\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n        <Link\n          label=\"Purging cached content\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n      </HelpPanel.Links>\n    </HelpPanel>\n  </div>\n</template>"
  },
  {
   "name": "Tutorial",
   "summary": "Tutorial mode: three tasks, one complete, one current and one not started, with the progress line derived from them and a Continue action.",
   "sfc": "<script setup>\n  import HelpPanel from '@aziontech/webkit/help-panel'\n  import Button from '@aziontech/webkit/button'\n</script>\n\n<template>\n  <div class=\"max-w-(--container-xs)\">\n    <HelpPanel aria-label=\"Help: Get started\">\n      <HelpPanel.Header\n        title=\"Get started\"\n        description=\"Put your first site online.\"\n      />\n      <HelpPanel.Tutorial\n        title=\"Put your first site online\"\n        description=\"Three tasks, about five minutes.\"\n      >\n        <HelpPanel.Task\n          title=\"Create an application\"\n          status=\"complete\"\n        >\n          Choose a template or start from an empty application.\n        </HelpPanel.Task>\n        <HelpPanel.Task\n          title=\"Create a workload\"\n          status=\"current\"\n        >\n          Bind your domain to the application you just created.\n        </HelpPanel.Task>\n        <HelpPanel.Task title=\"Point your DNS\">\n          Add the CNAME record shown on the workload page.\n        </HelpPanel.Task>\n        <template #actions>\n          <Button\n            label=\"Continue\"\n            size=\"medium\"\n          />\n        </template>\n      </HelpPanel.Tutorial>\n    </HelpPanel>\n  </div>\n</template>"
  },
  {
   "name": "Loading",
   "summary": "While the topic loads, skeleton lines reserve the space and the landmark is marked busy.",
   "sfc": "<script setup>\n  import HelpPanel from '@aziontech/webkit/help-panel'\n  import Link from '@aziontech/webkit/link'\n</script>\n\n<template>\n  <div class=\"max-w-(--container-xs)\">\n    <HelpPanel\n      aria-label=\"Help: Cache settings\"\n      loading\n    >\n      <HelpPanel.Header\n        title=\"Cache settings\"\n        description=\"How long content stays at the edge before it is fetched again.\"\n      />\n      <HelpPanel.Section title=\"What does the cache TTL control?\">\n        <p>\n          The TTL sets how many seconds an object is served from the edge before the origin is asked\n          for a fresh copy.\n        </p>\n      </HelpPanel.Section>\n      <HelpPanel.Section title=\"When should I bypass the cache?\">\n        <p>Bypass it for responses that change per user, such as carts and account pages.</p>\n      </HelpPanel.Section>\n      <HelpPanel.Links>\n        <Link\n          label=\"Cache settings documentation\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n        <Link\n          label=\"Purging cached content\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n      </HelpPanel.Links>\n    </HelpPanel>\n  </div>\n</template>"
  }
