 "examples": [
  {
   "name": "Default",
   "summary": "A help topic: a header, two sections that each answer one question, and the Learn more links at the end.",
   "sfc": "<script setup>\n  import HelpPanel from '@aziontech/webkit/help-panel'\n  import Link from '@aziontech/webkit/link'\n</script>\n\n<template>\n  <div class=\"max-w-(--container-xs)\">\n    <HelpPanel aria-label=\"Help: Cache settings\">\n      <HelpPanel.Header\n        title=\"Cache settings\"\n        description=\"How long content stays at the edge before it is fetched again.\"\n      />\n      <HelpPanel.Group label=\"What does the cache TTL control?\">\n        <p>\n          The TTL sets how many seconds an object is served from the edge before the origin is asked\n          for a fresh copy.\n        </p>\n      </HelpPanel.Group>\n      <HelpPanel.Group label=\"When should I bypass the cache?\">\n        <p>Bypass it for responses that change per user, such as carts and account pages.</p>\n      </HelpPanel.Group>\n      <HelpPanel.Footer>\n        <Link\n          label=\"Cache settings documentation\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n        <Link\n          label=\"Purging cached content\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n      </HelpPanel.Footer>\n    </HelpPanel>\n  </div>\n</template>"
  },
  {
   "name": "Loading",
   "summary": "While the topic loads, skeleton lines reserve the space and the landmark is marked busy.",
   "sfc": "<script setup>\n  import HelpPanel from '@aziontech/webkit/help-panel'\n  import Link from '@aziontech/webkit/link'\n</script>\n\n<template>\n  <div class=\"max-w-(--container-xs)\">\n    <HelpPanel\n      aria-label=\"Help: Cache settings\"\n      loading\n    >\n      <HelpPanel.Header\n        title=\"Cache settings\"\n        description=\"How long content stays at the edge before it is fetched again.\"\n      />\n      <HelpPanel.Group label=\"What does the cache TTL control?\">\n        <p>\n          The TTL sets how many seconds an object is served from the edge before the origin is asked\n          for a fresh copy.\n        </p>\n      </HelpPanel.Group>\n      <HelpPanel.Group label=\"When should I bypass the cache?\">\n        <p>Bypass it for responses that change per user, such as carts and account pages.</p>\n      </HelpPanel.Group>\n      <HelpPanel.Footer>\n        <Link\n          label=\"Cache settings documentation\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n        <Link\n          label=\"Purging cached content\"\n          href=\"https://www.azion.com/en/documentation/\"\n          target=\"_blank\"\n        />\n      </HelpPanel.Footer>\n    </HelpPanel>\n  </div>\n</template>"
  }
 ]
