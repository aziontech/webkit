   "name": "Default",
   "summary": "Default empty input at medium size.",
   "sfc": "<script setup>\n  import Input from '@aziontech/webkit/input'\n  import { ref } from 'vue'\n\n  const value = ref('')\n</script>\n\n<template>\n  <Input\n    v-model=\"value\"\n    placeholder=\"Type something\"\n  />\n</template>"
