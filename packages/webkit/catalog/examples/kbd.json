 "examples": [
  {
   "name": "Default",
   "summary": "A single keycap driven by the controls.",
   "sfc": "<script setup>\n  import Kbd from '@aziontech/webkit/kbd'\n</script>\n\n<template>\n  <Kbd meta>K</Kbd>\n</template>"
  },
  {
   "name": "Sizes",
   "summary": "All sizes side by side.",
   "sfc": "<script setup>\n  import Kbd from '@aziontech/webkit/kbd'\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-center gap-4\">\n    <Kbd\n      meta\n      size=\"small\"\n      >K</Kbd\n    >\n    <Kbd\n      meta\n      size=\"medium\"\n      >K</Kbd\n    >\n  </div>\n</template>"
  },
  {
   "name": "Keys",
   "summary": "A `keys` list drawn as one keycap (`combined`) and as one keycap per key (`separate`), with the arrow keys and the Return glyph in a navigation hint.",
   "sfc": "<script setup>\n  import Kbd from '@aziontech/webkit/kbd'\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-(--spacing-sm) text-body-sm text-(--text-default)\">\n    <div class=\"flex flex-wrap items-center gap-(--spacing-xs)\">\n      <Kbd :keys=\"['meta', 'shift', 'p']\" />\n      <Kbd\n        :keys=\"['meta', 'shift', 'p']\"\n        kind=\"separate\"\n      />\n    </div>\n    <div class=\"flex flex-wrap items-center gap-(--spacing-xs)\">\n      <Kbd\n        :keys=\"['arrow-up', 'arrow-down']\"\n        kind=\"separate\"\n        size=\"small\"\n      />\n      <span>to navigate</span>\n      <Kbd\n        key-name=\"return\"\n        size=\"small\"\n      />\n      <span>to select</span>\n      <Kbd\n        key-name=\"escape\"\n        size=\"small\"\n      />\n      <span>to close</span>\n    </div>\n    <div class=\"flex flex-wrap items-center gap-(--spacing-xs)\">\n      <Kbd\n        :keys=\"['arrow-left', 'arrow-right']\"\n        kind=\"separate\"\n      />\n      <span>to switch tabs</span>\n    </div>\n  </div>\n</template>"
  }
 ]
