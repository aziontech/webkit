 "examples": [
  {
   "name": "Default",
   "summary": "The facts band of a resource detail page: an ID with its copy button, a status, the creation date, a region and a linked domain, in one column.",
   "sfc": "<script setup>\n  import CopyButton from '@aziontech/webkit/copy-button'\n  import KeyValuePairs from '@aziontech/webkit/key-value-pairs'\n  import Link from '@aziontech/webkit/link'\n  import StatusIndicator from '@aziontech/webkit/status-indicator'\n</script>\n\n<template>\n  <KeyValuePairs aria-label=\"Workload details\">\n    <KeyValuePairs.Item label=\"Workload ID\">\n      <span>1752167890</span>\n      <CopyButton\n        value=\"1752167890\"\n        aria-label=\"Copy workload ID\"\n      />\n    </KeyValuePairs.Item>\n    <KeyValuePairs.Item label=\"Status\">\n      <StatusIndicator\n        severity=\"success\"\n        label=\"Active\"\n      />\n    </KeyValuePairs.Item>\n    <KeyValuePairs.Item label=\"Created\">Nov 10, 2026, 14:32</KeyValuePairs.Item>\n    <KeyValuePairs.Item label=\"Region\">US East (Virginia)</KeyValuePairs.Item>\n    <KeyValuePairs.Item label=\"Domain\">\n      <Link\n        label=\"shop.example.com\"\n        href=\"https://shop.example.com\"\n        size=\"small\"\n      />\n    </KeyValuePairs.Item>\n  </KeyValuePairs>\n</template>"
  },
  {
   "name": "Columns",
   "summary": "The same facts at 2, 3 and 4 columns. Below md every grid collapses to one column, and 3 or 4 columns fall back to two at md.",
   "sfc": "<script setup>\n  import CopyButton from '@aziontech/webkit/copy-button'\n  import KeyValuePairs from '@aziontech/webkit/key-value-pairs'\n  import Link from '@aziontech/webkit/link'\n  import StatusIndicator from '@aziontech/webkit/status-indicator'\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-(--spacing-xl)\">\n    <KeyValuePairs\n      :columns=\"2\"\n      aria-label=\"Workload details in two columns\"\n    >\n      <KeyValuePairs.Item label=\"Workload ID\">\n        <span>1752167890</span>\n        <CopyButton\n          value=\"1752167890\"\n          aria-label=\"Copy workload ID\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Status\">\n        <StatusIndicator\n          severity=\"success\"\n          label=\"Active\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Created\">Nov 10, 2026, 14:32</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Region\">US East (Virginia)</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Domain\">\n        <Link\n          label=\"shop.example.com\"\n          href=\"https://shop.example.com\"\n          size=\"small\"\n        />\n      </KeyValuePairs.Item>\n    </KeyValuePairs>\n    <KeyValuePairs\n      :columns=\"3\"\n      aria-label=\"Workload details in three columns\"\n    >\n      <KeyValuePairs.Item label=\"Workload ID\">\n        <span>1752167890</span>\n        <CopyButton\n          value=\"1752167890\"\n          aria-label=\"Copy workload ID\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Status\">\n        <StatusIndicator\n          severity=\"success\"\n          label=\"Active\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Created\">Nov 10, 2026, 14:32</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Region\">US East (Virginia)</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Domain\">\n        <Link\n          label=\"shop.example.com\"\n          href=\"https://shop.example.com\"\n          size=\"small\"\n        />\n      </KeyValuePairs.Item>\n    </KeyValuePairs>\n    <KeyValuePairs\n      :columns=\"4\"\n      aria-label=\"Workload details in four columns\"\n    >\n      <KeyValuePairs.Item label=\"Workload ID\">\n        <span>1752167890</span>\n        <CopyButton\n          value=\"1752167890\"\n          aria-label=\"Copy workload ID\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Status\">\n        <StatusIndicator\n          severity=\"success\"\n          label=\"Active\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Created\">Nov 10, 2026, 14:32</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Region\">US East (Virginia)</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Domain\">\n        <Link\n          label=\"shop.example.com\"\n          href=\"https://shop.example.com\"\n          size=\"small\"\n        />\n      </KeyValuePairs.Item>\n    </KeyValuePairs>\n  </div>\n</template>"
  },
  {
   "name": "Groups",
   "summary": "Facts split into titled columns, one group per column. The Region key carries an info hint, and the custom certificate has no value, so it shows the empty-value marker.",
   "sfc": "<script setup>\n  import CopyButton from '@aziontech/webkit/copy-button'\n  import Hint from '@aziontech/webkit/hint'\n  import KeyValuePairs from '@aziontech/webkit/key-value-pairs'\n  import Link from '@aziontech/webkit/link'\n  import StatusIndicator from '@aziontech/webkit/status-indicator'\n</script>\n\n<template>\n  <KeyValuePairs\n    :columns=\"3\"\n    aria-label=\"Workload details\"\n  >\n    <KeyValuePairs.Group title=\"General\">\n      <KeyValuePairs.Item label=\"Workload ID\">\n        <span>1752167890</span>\n        <CopyButton\n          value=\"1752167890\"\n          aria-label=\"Copy workload ID\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Status\">\n        <StatusIndicator\n          severity=\"success\"\n          label=\"Active\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Created\">Nov 10, 2026, 14:32</KeyValuePairs.Item>\n    </KeyValuePairs.Group>\n    <KeyValuePairs.Group title=\"Networking\">\n      <KeyValuePairs.Item label=\"Domain\">\n        <Link\n          label=\"shop.example.com\"\n          href=\"https://shop.example.com\"\n          size=\"small\"\n        />\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Region\">\n        <template #info>\n          <Hint text=\"Where the workload was first provisioned.\" />\n        </template>\n        US East (Virginia)\n      </KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Custom certificate\" />\n    </KeyValuePairs.Group>\n    <KeyValuePairs.Group title=\"Source\">\n      <KeyValuePairs.Item label=\"Repository\">acme/storefront</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Branch\">main</KeyValuePairs.Item>\n      <KeyValuePairs.Item label=\"Framework\">Next.js</KeyValuePairs.Item>\n    </KeyValuePairs.Group>\n  </KeyValuePairs>\n</template>"
  }
 ]
}
