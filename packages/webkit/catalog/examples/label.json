  {
   "name": "Hinted",
   "summary": "Hinted label — `hint` appends a Hint glyph after the text. Hover or focus it to read the explanation. The label points at its input with `for`.",
   "sfc": "<script setup>\n  import Input from '@aziontech/webkit/input'\n  import Label from '@aziontech/webkit/label'\n  import { ref } from 'vue'\n\n  const value = ref('')\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-xs) flex-col gap-(--spacing-xs)\">\n    <Label\n      for=\"label-hinted-secret\"\n      label=\"Sensitive\"\n      hint=\"Values are encrypted at rest and never displayed again after saving.\"\n    />\n    <Input\n      id=\"label-hinted-secret\"\n      v-model=\"value\"\n    />\n  </div>\n</template>"
