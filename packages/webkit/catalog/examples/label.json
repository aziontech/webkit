   "name": "Default",
   "summary": "Default label without the required indicator. The label points at its input with `for`.",
   "sfc": "<script setup>\n  import Input from '@aziontech/webkit/input'\n  import Label from '@aziontech/webkit/label'\n  import { ref } from 'vue'\n\n  const value = ref('')\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-xs) flex-col gap-(--spacing-xs)\">\n    <Label\n      for=\"label-default-field\"\n      label=\"Label\"\n    />\n    <Input\n      id=\"label-default-field\"\n      v-model=\"value\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Required",
   "summary": "Required label — appends the inline `* (Required)` indicator. The label points at its input with `for`.",
   "sfc": "<script setup>\n  import Input from '@aziontech/webkit/input'\n  import Label from '@aziontech/webkit/label'\n  import { ref } from 'vue'\n\n  const value = ref('')\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-xs) flex-col gap-(--spacing-xs)\">\n    <Label\n      for=\"label-required-field\"\n      label=\"Label\"\n      required\n    />\n    <Input\n      id=\"label-required-field\"\n      v-model=\"value\"\n    />\n  </div>\n</template>"
