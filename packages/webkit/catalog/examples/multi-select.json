{
 "examples": [
  {
   "name": "Default",
   "summary": "Multi-select over a flat option list; one option is pre-selected through v-model.",
   "sfc": "<script setup>\n  import MultiSelectContent from '@aziontech/webkit/multi-select-content'\n  import MultiSelectOption from '@aziontech/webkit/multi-select-option'\n  import MultiSelectRoot from '@aziontech/webkit/multi-select-root'\n  import MultiSelectTrigger from '@aziontech/webkit/multi-select-trigger'\n  import { ref } from 'vue'\n\n  const value = ref(['opt-1'])\n  const options = [\n    { value: 'opt-1', label: 'Option 1' },\n    { value: 'opt-2', label: 'Option 2' },\n    { value: 'opt-3', label: 'Option 3' },\n    { value: 'opt-4', label: 'Option 4' }\n  ]\n</script>\n\n<template>\n  <div style=\"width: 280px\">\n    <MultiSelectRoot\n      aria-label=\"Options\"\n      v-model=\"value\"\n      placeholder=\"Select options\"\n    >\n      <MultiSelectTrigger />\n      <MultiSelectContent>\n        <MultiSelectOption\n          v-for=\"o in options\"\n          :key=\"o.value\"\n          :value=\"o.value\"\n          >{{ o.label }}</MultiSelectOption\n        >\n      </MultiSelectContent>\n    </MultiSelectRoot>\n  </div>\n</template>"
  },
  {
   "name": "Sizes",
   "summary": "The three trigger sizes (small, medium, large) matching Input.",
   "sfc": "<script setup>\n  import MultiSelectContent from '@aziontech/webkit/multi-select-content'\n  import MultiSelectOption from '@aziontech/webkit/multi-select-option'\n  import MultiSelectRoot from '@aziontech/webkit/multi-select-root'\n  import MultiSelectTrigger from '@aziontech/webkit/multi-select-trigger'\n  import { ref } from 'vue'\n\n  const value = ref([])\n  const options = [\n    { value: 'a', label: 'Option A' },\n    { value: 'b', label: 'Option B' }\n  ]\n  const sizes = ['small', 'medium', 'large']\n</script>\n\n<template>\n  <div\n    class=\"flex flex-col gap-4\"\n    style=\"width: 280px\"\n  >\n    <MultiSelectRoot\n      :aria-label=\"`Option, ${s}`\"\n      v-for=\"s in sizes\"\n      :key=\"s\"\n      v-model=\"value\"\n      :size=\"s\"\n      :placeholder=\"s.charAt(0).toUpperCase() + s.slice(1)\"\n    >\n      <MultiSelectTrigger />\n      <MultiSelectContent>\n        <MultiSelectOption\n          v-for=\"o in options\"\n          :key=\"o.value\"\n          :value=\"o.value\"\n          >{{ o.label }}</MultiSelectOption\n        >\n      </MultiSelectContent>\n    </MultiSelectRoot>\n  </div>\n</template>"
  },
  {
   "name": "WithGroups",
   "summary": "Options organised into labelled sections via MultiSelectGroup.",
   "sfc": "<script setup>\n  import MultiSelectContent from '@aziontech/webkit/multi-select-content'\n  import MultiSelectGroup from '@aziontech/webkit/multi-select-group'\n  import MultiSelectOption from '@aziontech/webkit/multi-select-option'\n  import MultiSelectRoot from '@aziontech/webkit/multi-select-root'\n  import MultiSelectTrigger from '@aziontech/webkit/multi-select-trigger'\n  import { ref } from 'vue'\n\n  const value = ref([])\n  const groups = [\n    {\n      label: 'Group A',\n      options: [\n        { value: 'a-1', label: 'Option 1' },\n        { value: 'a-2', label: 'Option 2' }\n      ]\n    },\n    {\n      label: 'Group B',\n      options: [\n        { value: 'b-1', label: 'Option 1' },\n        { value: 'b-2', label: 'Option 2' }\n      ]\n    }\n  ]\n</script>\n\n<template>\n  <div style=\"width: 280px\">\n    <MultiSelectRoot\n      aria-label=\"Options\"\n      v-model=\"value\"\n      placeholder=\"Select options\"\n    >\n      <MultiSelectTrigger />\n      <MultiSelectContent>\n        <MultiSelectGroup\n          v-for=\"g in groups\"\n          :key=\"g.label\"\n          :label=\"g.label\"\n        >\n          <MultiSelectOption\n            v-for=\"o in g.options\"\n            :key=\"o.value\"\n            :value=\"o.value\"\n            >{{ o.label }}</MultiSelectOption\n          >\n        </MultiSelectGroup>\n      </MultiSelectContent>\n    </MultiSelectRoot>\n  </div>\n</template>"
  }
 ]
}
