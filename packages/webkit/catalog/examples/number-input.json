 "examples": [
  {
   "name": "Default",
   "summary": "Default numeric input at medium size with a placeholder.",
   "sfc": "<script setup>\n  import NumberInput from '@aziontech/webkit/number-input'\n  import { ref } from 'vue'\n\n  const value = ref(1)\n</script>\n\n<template>\n  <div class=\"w-[20rem]\">\n    <NumberInput\n      v-model=\"value\"\n      :min=\"0\"\n      :max=\"100\"\n      :step=\"1\"\n      placeholder=\"Quantity\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Sizes",
   "summary": "All size variants stacked vertically. Each input has its own `ref`, its own bounds (`min`/`max`), and its own step.",
   "sfc": "<script setup>\n  import NumberInput from '@aziontech/webkit/number-input'\n  import { ref } from 'vue'\n\n  const small = ref(1)\n  const medium = ref(10)\n  const large = ref(100)\n</script>\n\n<template>\n  <div class=\"flex w-[20rem] flex-col gap-(--spacing-md)\">\n    <NumberInput\n      v-model=\"small\"\n      size=\"small\"\n      :min=\"0\"\n      :max=\"9\"\n      :step=\"1\"\n    />\n    <NumberInput\n      v-model=\"medium\"\n      size=\"medium\"\n      :min=\"0\"\n      :max=\"99\"\n      :step=\"5\"\n    />\n    <NumberInput\n      v-model=\"large\"\n      size=\"large\"\n      :min=\"0\"\n      :max=\"1000\"\n      :step=\"50\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Disabled",
   "summary": "Disabled state — interaction (typing, spinner, arrow keys) is fully blocked.",
   "sfc": "<script setup>\n  import NumberInput from '@aziontech/webkit/number-input'\n  import { ref } from 'vue'\n\n  const value = ref(42)\n</script>\n\n<template>\n  <div class=\"w-[20rem]\">\n    <NumberInput\n      v-model=\"value\"\n      disabled\n    />\n  </div>\n</template>"
  }
