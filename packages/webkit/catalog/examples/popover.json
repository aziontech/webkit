{
 "examples": [
  {
   "name": "Default",
   "summary": "A `Button` trigger that opens the popover. The panel content is composed by part — here a header (title + close) and a free-form body.",
   "sfc": "<script setup>\n  import Popover, {\n    PopoverTrigger,\n    PopoverContent,\n    PopoverHeader,\n    PopoverTitle,\n    PopoverDescription,\n    PopoverClose,\n    PopoverFooter\n  } from '@aziontech/webkit/popover'\n  import Button from '@aziontech/webkit/button'\n</script>\n\n<template>\n  <Popover>\n    <PopoverTrigger>\n      <Button\n        kind=\"secondary\"\n        label=\"Open popover\"\n      />\n    </PopoverTrigger>\n\n    <PopoverContent>\n      <PopoverHeader>\n        <PopoverTitle>Popover title</PopoverTitle>\n        <PopoverClose />\n      </PopoverHeader>\n\n      <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">\n        This content is rendered inside the popover panel.\n      </div>\n    </PopoverContent>\n  </Popover>\n</template>"
  },
  {
   "name": "Placements",
   "summary": "All four explicit `placement` values side-by-side. Click a trigger to open its panel and see how it anchors against the trigger.",
   "sfc": "<script setup>\n  import Popover, {\n    PopoverTrigger,\n    PopoverContent,\n    PopoverHeader,\n    PopoverTitle,\n    PopoverDescription,\n    PopoverClose,\n    PopoverFooter\n  } from '@aziontech/webkit/popover'\n  import Button from '@aziontech/webkit/button'\n</script>\n\n<template>\n  <div\n    class=\"grid grid-cols-2 gap-(--spacing-xxl) place-items-center min-h-[24rem] p-(--spacing-xxl)\"\n  >\n    <Popover placement=\"bottom-start\">\n      <PopoverTrigger>\n        <Button\n          kind=\"secondary\"\n          label=\"bottom-start\"\n        />\n      </PopoverTrigger>\n      <PopoverContent>\n        <PopoverHeader>\n          <PopoverTitle>bottom-start</PopoverTitle>\n          <PopoverClose />\n        </PopoverHeader>\n        <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n      </PopoverContent>\n    </Popover>\n\n    <Popover placement=\"bottom-end\">\n      <PopoverTrigger>\n        <Button\n          kind=\"secondary\"\n          label=\"bottom-end\"\n        />\n      </PopoverTrigger>\n      <PopoverContent>\n        <PopoverHeader>\n          <PopoverTitle>bottom-end</PopoverTitle>\n          <PopoverClose />\n        </PopoverHeader>\n        <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n      </PopoverContent>\n    </Popover>\n\n    <Popover placement=\"top-start\">\n      <PopoverTrigger>\n        <Button\n          kind=\"secondary\"\n          label=\"top-start\"\n        />\n      </PopoverTrigger>\n      <PopoverContent>\n        <PopoverHeader>\n          <PopoverTitle>top-start</PopoverTitle>\n          <PopoverClose />\n        </PopoverHeader>\n        <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n      </PopoverContent>\n    </Popover>\n\n    <Popover placement=\"top-end\">\n      <PopoverTrigger>\n        <Button\n          kind=\"secondary\"\n          label=\"top-end\"\n        />\n      </PopoverTrigger>\n      <PopoverContent>\n        <PopoverHeader>\n          <PopoverTitle>top-end</PopoverTitle>\n          <PopoverClose />\n        </PopoverHeader>\n        <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n      </PopoverContent>\n    </Popover>\n  </div>\n</template>"
  },
  {
   "name": "AutoPlacement",
   "summary": "`placement=\"auto\"` lets the popover choose the best-fitting corner at open time. The four triggers below all use the same value — each, anchored near a different viewport corner and forced open, resolves toward the corner with the most available space.",
   "sfc": "<script setup>\n  import Popover, {\n    PopoverTrigger,\n    PopoverContent,\n    PopoverHeader,\n    PopoverTitle,\n    PopoverDescription,\n    PopoverClose,\n    PopoverFooter\n  } from '@aziontech/webkit/popover'\n  import Button from '@aziontech/webkit/button'\n</script>\n\n<template>\n  <div class=\"relative h-[30rem] w-full border border-dashed border-(--border-muted)\">\n    <p\n      class=\"absolute top-(--spacing-md) left-1/2 -translate-x-1/2 text-body-sm text-(--text-muted) text-center max-w-md\"\n    >\n      All triggers use placement=\"auto\". Each panel resolves to the best-fitting corner based on its\n      position in the viewport.\n    </p>\n\n    <div class=\"absolute top-(--spacing-md) start-(--spacing-md)\">\n      <Popover\n        :open=\"true\"\n        placement=\"auto\"\n      >\n        <PopoverTrigger>\n          <Button\n            kind=\"secondary\"\n            label=\"top-left\"\n          />\n        </PopoverTrigger>\n        <PopoverContent>\n          <PopoverHeader>\n            <PopoverTitle>Popover</PopoverTitle>\n            <PopoverClose />\n          </PopoverHeader>\n          <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n        </PopoverContent>\n      </Popover>\n    </div>\n\n    <div class=\"absolute top-(--spacing-md) end-(--spacing-md)\">\n      <Popover\n        :open=\"true\"\n        placement=\"auto\"\n      >\n        <PopoverTrigger>\n          <Button\n            kind=\"secondary\"\n            label=\"top-right\"\n          />\n        </PopoverTrigger>\n        <PopoverContent>\n          <PopoverHeader>\n            <PopoverTitle>Popover</PopoverTitle>\n            <PopoverClose />\n          </PopoverHeader>\n          <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n        </PopoverContent>\n      </Popover>\n    </div>\n\n    <div class=\"absolute bottom-(--spacing-md) start-(--spacing-md)\">\n      <Popover\n        :open=\"true\"\n        placement=\"auto\"\n      >\n        <PopoverTrigger>\n          <Button\n            kind=\"secondary\"\n            label=\"bottom-left\"\n          />\n        </PopoverTrigger>\n        <PopoverContent>\n          <PopoverHeader>\n            <PopoverTitle>Popover</PopoverTitle>\n            <PopoverClose />\n          </PopoverHeader>\n          <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n        </PopoverContent>\n      </Popover>\n    </div>\n\n    <div class=\"absolute bottom-(--spacing-md) end-(--spacing-md)\">\n      <Popover\n        :open=\"true\"\n        placement=\"auto\"\n      >\n        <PopoverTrigger>\n          <Button\n            kind=\"secondary\"\n            label=\"bottom-right\"\n          />\n        </PopoverTrigger>\n        <PopoverContent>\n          <PopoverHeader>\n            <PopoverTitle>Popover</PopoverTitle>\n            <PopoverClose />\n          </PopoverHeader>\n          <div class=\"p-(--spacing-md) text-body-sm text-(--text-default)\">Popover content.</div>\n        </PopoverContent>\n      </Popover>\n    </div>\n  </div>\n</template>"
  }
 ]
}
