 "examples": [
  {
   "name": "Default",
   "summary": "A framed widget, the workloads list, filling a panel the host sizes.",
   "sfc": "<script setup>\n  import ProductWidget from '@aziontech/webkit/product-widget'\n</script>\n\n<template>\n  <div class=\"h-96 w-full\">\n    <ProductWidget name=\"workloads-list\" />\n  </div>\n</template>"
  },
  {
   "name": "Types",
   "summary": "A framed widget plated as a console window, and the same widget bare, floating on the host surface.",
   "sfc": "<script setup>\n  import ProductWidget from '@aziontech/webkit/product-widget'\n</script>\n\n<template>\n  <div class=\"grid w-full grid-cols-1 gap-(--spacing-lg) md:grid-cols-2\">\n    <div class=\"h-80 w-full\">\n      <ProductWidget\n        name=\"workload-topology\"\n        kind=\"window\"\n      />\n    </div>\n    <div class=\"h-80 w-full\">\n      <ProductWidget\n        name=\"workload-topology\"\n        kind=\"bare\"\n      />\n    </div>\n  </div>\n</template>"
  },
  {
   "name": "Library",
   "summary": "Every registered widget in the cell that hosts it on the site: full screens in wide panels, fragments in grid cells that play their beat on hover. These are the only values `name` accepts.",
   "sfc": "<script setup>\n  import ProductWidget from '@aziontech/webkit/product-widget'\n  import { ref } from 'vue'\n\n  const FRAMED = [\n    'application-version',\n    'cli-terminal-deploy',\n    'cli-terminal-start',\n    'workload-deploy-logs',\n    'workload-deployments',\n    'workload-domains',\n    'workload-overview',\n    'workload-rollout-rows',\n    'workload-topology',\n    'workload-topology-chain',\n    'workload-topology-flow',\n    'workloads-list'\n  ]\n  const FRAGMENTS = [\n    'ai-inference-function',\n    'ai-inference-model',\n    'ai-inference-template',\n    'application-accelerator-cookie',\n    'application-accelerator-method',\n    'application-accelerator-query-string',\n    'application-cache',\n    'application-function',\n    'application-rule',\n    'applications-create-method',\n    'applications-device-group',\n    'applications-rule-phases',\n    'bot-manager-metrics',\n    'bot-manager-rule',\n    'bot-manager-traffic',\n    'data-stream-connector',\n    'data-stream-sampling',\n    'data-stream-source',\n    'ddos-firewall-modules',\n    'ddos-http-events',\n    'ddos-requests-metric',\n    'edge-dns-dnssec',\n    'edge-dns-nameserver',\n    'edge-dns-record',\n    'firewall-function',\n    'firewall-modules',\n    'firewall-rules-order',\n    'function-code',\n    'functions-start',\n    'image-processor-events',\n    'image-processor-module',\n    'image-processor-rule',\n    'kv-store-function',\n    'kv-store-key',\n    'kv-store-security-list',\n    'load-balancer-address',\n    'load-balancer-method',\n    'load-balancer-origins',\n    'network-shield-ip-list',\n    'network-shield-lists',\n    'network-shield-rule',\n    'object-storage-access',\n    'object-storage-browser',\n    'object-storage-buckets',\n    'real-time-events-filter',\n    'real-time-events-log',\n    'real-time-events-volume',\n    'real-time-metrics-dashboard',\n    'real-time-metrics-filter',\n    'real-time-metrics-panel',\n    'sql-database-query',\n    'sql-database-row',\n    'sql-database-table',\n    'waf-allowed-rule',\n    'waf-firewall-rule',\n    'waf-threat',\n    'workload-deploy',\n    'workload-domain'\n  ]\n  const hovered = ref('')\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-(--spacing-xl)\">\n    <div class=\"grid grid-cols-1 gap-(--spacing-lg) lg:grid-cols-2\">\n      <div\n        v-for=\"name in FRAMED\"\n        :key=\"name\"\n        class=\"flex flex-col gap-(--spacing-xs)\"\n      >\n        <span class=\"text-label-sm text-(--text-muted)\">{{ name }}</span>\n        <div class=\"aspect-[1.9/1] w-full\">\n          <ProductWidget\n            :name=\"name\"\n            fade=\"bottom\"\n          />\n        </div>\n      </div>\n    </div>\n    <div class=\"grid grid-cols-1 gap-(--spacing-lg) md:grid-cols-2 lg:grid-cols-3\">\n      <div\n        v-for=\"name in FRAGMENTS\"\n        :key=\"name\"\n        class=\"flex flex-col gap-(--spacing-xs)\"\n      >\n        <span class=\"text-label-sm text-(--text-muted)\">{{ name }}</span>\n        <div\n          class=\"h-80 w-full min-w-0 overflow-x-visible overflow-y-clip rounded-(--shape-card) border border-(--border-default) bg-(--bg-surface) px-(--spacing-xl) pt-(--spacing-xl) [--mockup-fade-color:var(--bg-surface)]\"\n          @pointerenter=\"hovered = name\"\n          @pointerleave=\"hovered = ''\"\n        >\n          <ProductWidget\n            :name=\"name\"\n            :hover=\"hovered === name\"\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n</template>"
  }
 ]
}
