  {
   "name": "Streaming",
   "summary": "Reasoning in progress: the label reads Thinking and pulses, the trace grows inside, and Skip thinking ends it early so the label shows how long it took.",
   "sfc": "<script setup>\n  import Reasoning from '@aziontech/webkit/reasoning'\n  import { onBeforeUnmount, onMounted, ref } from 'vue'\n\n  const steps = [\n    'Reading the error rate of the workload over the last hour.',\n    'The 502 responses started at 14:05, when the origin certificate expired.',\n    'Checking whether a renewed certificate is already uploaded.'\n  ]\n\n  const shown = ref([])\n  const streaming = ref(true)\n  let timer\n\n  function stop() {\n    clearInterval(timer)\n    streaming.value = false\n  }\n\n  onMounted(() => {\n    timer = setInterval(() => {\n      if (shown.value.length < steps.length) shown.value = steps.slice(0, shown.value.length + 1)\n      else stop()\n    }, 1500)\n  })\n  onBeforeUnmount(() => clearInterval(timer))\n</script>\n\n<template>\n  <div class=\"w-full max-w-(--container-3xl)\">\n    <Reasoning\n      :streaming=\"streaming\"\n      default-open\n      skippable\n      @skip=\"stop\"\n    >\n      <p\n        v-for=\"step in shown\"\n        :key=\"step\"\n      >\n        {{ step }}\n      </p>\n    </Reasoning>\n  </div>\n</template>"
  }
 ]
