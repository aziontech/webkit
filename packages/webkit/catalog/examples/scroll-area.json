   "sfc": "<script setup>\n  import ScrollArea from '@aziontech/webkit/scroll-area'\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-start gap-(--spacing-6)\">\n    <div\n      class=\"w-[280px] overflow-hidden rounded-(--shape-elements) border border-(--border-default)\"\n    >\n      <ScrollArea\n        fade\n        aria-label=\"Deployments\"\n        class=\"max-h-[240px]\"\n      >\n        <ul class=\"m-0 flex list-none flex-col gap-(--spacing-xxs) p-(--spacing-xs)\">\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            edge-app-production\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            edge-app-staging\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            marketing-site\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            docs-portal\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            image-optimizer\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            api-gateway\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            auth-service\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            checkout-function\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            search-indexer\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            media-transcoder\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            waf-rules-engine\n          </li>\n          <li\n            class=\"rounded-(--shape-elements) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n          >\n            analytics-collector\n          </li>\n        </ul>\n      </ScrollArea>\n    </div>\n    <div\n      class=\"w-[280px] overflow-hidden rounded-(--shape-elements) border border-(--border-default)\"\n    >\n      <ScrollArea\n        fade\n        orientation=\"horizontal\"\n        aria-label=\"Regions\"\n      >\n        <div class=\"flex w-max gap-(--spacing-xs) p-(--spacing-xs)\">\n          <span\n            class=\"rounded-(--shape-elements) border border-(--border-default) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n            >São Paulo</span\n          >\n          <span\n            class=\"rounded-(--shape-elements) border border-(--border-default) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n            >Miami</span\n          >\n          <span\n            class=\"rounded-(--shape-elements) border border-(--border-default) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n            >Frankfurt</span\n          >\n          <span\n            class=\"rounded-(--shape-elements) border border-(--border-default) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n            >Tokyo</span\n          >\n          <span\n            class=\"rounded-(--shape-elements) border border-(--border-default) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n            >Sydney</span\n          >\n          <span\n            class=\"rounded-(--shape-elements) border border-(--border-default) px-(--spacing-sm) py-(--spacing-xs) text-body-sm text-(--text-default)\"\n            >Mumbai</span\n          >\n        </div>\n      </ScrollArea>\n    </div>\n  </div>\n</template>"
