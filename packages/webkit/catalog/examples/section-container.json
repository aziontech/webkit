 "examples": [
  {
   "name": "Default",
   "summary": "Two bands stacked inside the column. The column draws the vertical rules; each band draws only its own horizontal ones, so no line is doubled.",
   "sfc": "<script setup>\n  import SectionContainer from '@aziontech/webkit/section-container'\n  import FrameBox from '@aziontech/webkit/frame-box'\n</script>\n\n<template>\n  <SectionContainer max-width=\"7xl\">\n    <FrameBox borders=\"y\">\n      <div class=\"p-(--spacing-xl) text-center text-body-md text-(--text-muted)\">First band</div>\n    </FrameBox>\n    <FrameBox\n      flush\n      borders=\"y\"\n      marks=\"bottom\"\n    >\n      <div class=\"p-(--spacing-xl) text-center text-body-md text-(--text-muted)\">Second band</div>\n    </FrameBox>\n  </SectionContainer>\n</template>"
  },
  {
   "name": "Widths",
   "summary": "Three caps in one view — a width only reads against another.",
   "sfc": "<script setup>\n  import SectionContainer from '@aziontech/webkit/section-container'\n  import FrameBox from '@aziontech/webkit/frame-box'\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-(--spacing-xl)\">\n    <SectionContainer max-width=\"4xl\">\n      <FrameBox borders=\"y\"\n        ><div class=\"p-(--spacing-lg) text-center text-body-md text-(--text-muted)\">\n          4xl\n        </div></FrameBox\n      >\n    </SectionContainer>\n    <SectionContainer max-width=\"6xl\">\n      <FrameBox borders=\"y\"\n        ><div class=\"p-(--spacing-lg) text-center text-body-md text-(--text-muted)\">\n          6xl\n        </div></FrameBox\n      >\n    </SectionContainer>\n    <SectionContainer max-width=\"site\">\n      <FrameBox borders=\"y\"\n        ><div class=\"p-(--spacing-lg) text-center text-body-md text-(--text-muted)\">\n          site\n        </div></FrameBox\n      >\n    </SectionContainer>\n  </div>\n</template>"
  },
  {
   "name": "Bordered",
   "summary": "With `bordered` off the column hands its sides to whatever frame encloses it.",
   "sfc": "<script setup>\n  import SectionContainer from '@aziontech/webkit/section-container'\n  import FrameBox from '@aziontech/webkit/frame-box'\n</script>\n\n<template>\n  <SectionContainer :bordered=\"false\">\n    <FrameBox borders=\"y\">\n      <div class=\"p-(--spacing-xl) text-center text-body-md text-(--text-muted)\">\n        A column inside another frame draws no sides\n      </div>\n    </FrameBox>\n  </SectionContainer>\n</template>"
  }
