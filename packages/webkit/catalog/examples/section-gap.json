 "examples": [
  {
   "name": "Default",
   "summary": "One gap between two stub sections. The gap renders `flush`, so the rule it shares with the section above is drawn once — every junction on the page stays a single hairline. Switch `size` to see the three steps.",
   "sfc": "<script setup>\n  import FrameBox from '@aziontech/webkit/frame-box'\n  import SectionGap from '@aziontech/webkit/section-gap'\n</script>\n\n<template>\n  <div>\n    <FrameBox borders=\"y\">\n      <div class=\"p-(--spacing-xl) text-center text-body-md text-(--text-muted)\">Section above</div>\n    </FrameBox>\n    <SectionGap size=\"medium\" />\n    <FrameBox\n      flush\n      marks=\"bottom\"\n      borders=\"y\"\n    >\n      <div class=\"p-(--spacing-xl) text-center text-body-md text-(--text-muted)\">Section below</div>\n    </FrameBox>\n  </div>\n</template>"
  },
  {
   "name": "Hatch",
   "summary": "The diagonal hatch drawn in the gap itself. This is the texture’s home on a framed page: the gap holds no copy, so the hatch gives the break its own identity without sitting behind a headline.",
   "sfc": "<script setup>\n  import FrameBox from '@aziontech/webkit/frame-box'\n  import SectionGap from '@aziontech/webkit/section-gap'\n</script>\n\n<template>\n  <div>\n    <FrameBox borders=\"y\">\n      <div class=\"p-(--spacing-xl) text-center text-body-md text-(--text-muted)\">Section above</div>\n    </FrameBox>\n    <SectionGap\n      hatch\n      size=\"large\"\n    />\n    <FrameBox\n      flush\n      marks=\"bottom\"\n      borders=\"y\"\n    >\n      <div class=\"p-(--spacing-xl) text-center text-body-md text-(--text-muted)\">Section below</div>\n    </FrameBox>\n  </div>\n</template>"
  },
  {
   "name": "Sizes",
   "summary": "Every `size` value in one stack, each gap labelled by the band above it: `small` keeps two related bands close, `medium` is the ordinary break between sections, `large` opens a new part of the page. The 1 : 2 : 3 ratio is what keeps the three weights unmistakable at every viewport width.",
   "sfc": "<script setup>\n  import FrameBox from '@aziontech/webkit/frame-box'\n  import SectionGap from '@aziontech/webkit/section-gap'\n</script>\n\n<template>\n  <div>\n    <FrameBox borders=\"y\">\n      <div class=\"p-(--spacing-lg) text-center text-body-md text-(--text-muted)\">\n        size=\"small\" — one --spacing-xxl below\n      </div>\n    </FrameBox>\n    <SectionGap size=\"small\" />\n    <FrameBox\n      flush\n      marks=\"bottom\"\n      borders=\"y\"\n    >\n      <div class=\"p-(--spacing-lg) text-center text-body-md text-(--text-muted)\">\n        size=\"medium\" — two below\n      </div>\n    </FrameBox>\n    <SectionGap size=\"medium\" />\n    <FrameBox\n      flush\n      marks=\"bottom\"\n      borders=\"y\"\n    >\n      <div class=\"p-(--spacing-lg) text-center text-body-md text-(--text-muted)\">\n        size=\"large\" — three below\n      </div>\n    </FrameBox>\n    <SectionGap size=\"large\" />\n    <FrameBox\n      flush\n      marks=\"bottom\"\n      borders=\"y\"\n    >\n      <div class=\"p-(--spacing-lg) text-center text-body-md text-(--text-muted)\">End</div>\n    </FrameBox>\n  </div>\n</template>"
  }
