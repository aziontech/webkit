 "examples": [
  {
   "name": "Default",
   "summary": "A header row divided from the body by one hairline. The header is a `SectionTitle`, so the module never re-implements that anatomy.",
   "sfc": "<script setup>\n  import SectionModule from '@aziontech/webkit/section-module'\n</script>\n\n<template>\n  <SectionModule\n    eyebrow=\"Platform\"\n    title=\"Build, run, and protect applications\"\n    description=\"One sentence naming what the band is about.\"\n  >\n    <p class=\"m-0 text-body-md text-(--text-muted)\">Everything the band has to say.</p>\n  </SectionModule>\n</template>"
  },
  {
   "name": "Kinds",
   "summary": "The three header layouts, stacked — they differ only in where the copy sits.",
   "sfc": "<script setup>\n  import SectionModule from '@aziontech/webkit/section-module'\n</script>\n\n<template>\n  <div>\n    <SectionModule\n      :divided=\"false\"\n      kind=\"left\"\n      eyebrow=\"Platform\"\n      title=\"Left\"\n    >\n      <p class=\"m-0 text-body-md text-(--text-muted)\">The header sits at the start edge.</p>\n    </SectionModule>\n    <SectionModule\n      kind=\"centered\"\n      eyebrow=\"Platform\"\n      title=\"Centered\"\n    >\n      <p class=\"m-0 text-body-md text-(--text-muted)\">The header is centered.</p>\n    </SectionModule>\n    <SectionModule\n      kind=\"horizontal\"\n      eyebrow=\"Platform\"\n      title=\"Horizontal\"\n      description=\"The description takes its own column.\"\n    >\n      <p class=\"m-0 text-body-md text-(--text-muted)\">\n        The headline and its description share a row.\n      </p>\n    </SectionModule>\n  </div>\n</template>"
  },
  {
   "name": "Divided",
   "summary": "Two modules, the first undivided. A shared edge is invisible on a single module — the stack is what proves the rule is drawn once.",
   "sfc": "<script setup>\n  import SectionModule from '@aziontech/webkit/section-module'\n</script>\n\n<template>\n  <div>\n    <SectionModule\n      :divided=\"false\"\n      title=\"First module\"\n    >\n      <p class=\"m-0 text-body-md text-(--text-muted)\">\n        Its top edge belongs to the hero above it, so it draws none.\n      </p>\n    </SectionModule>\n    <SectionModule title=\"Second module\">\n      <p class=\"m-0 text-body-md text-(--text-muted)\">\n        This one draws the rule that divides the two.\n      </p>\n    </SectionModule>\n  </div>\n</template>"
  }
 ]
