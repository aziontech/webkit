{
 "examples": [
  {
   "name": "Default",
   "summary": "One anchored band: the h2 with its Hint guidance and a gutter copy-link, over a flush Card of SettingRow rows.",
   "sfc": "<script setup>\n  import Card from '@aziontech/webkit/card'\n  import Item from '@aziontech/webkit/item'\n  import Select from '@aziontech/webkit/select'\n  import SettingRow from '@aziontech/webkit/setting-row'\n  import SettingsSection from '@aziontech/webkit/settings-section'\n  import { ref } from 'vue'\n\n  const fonts = [\n    { label: 'Rubik (Default)', value: 'rubik' },\n    { label: 'Inter', value: 'inter' },\n    { label: 'IBM Plex Sans', value: 'ibm-plex-sans' },\n    { label: 'Geist', value: 'geist' }\n  ]\n\n  const appearances = [\n    { label: 'System', value: 'system' },\n    { label: 'Light', value: 'light' },\n    { label: 'Dark', value: 'dark' }\n  ]\n\n  const font = ref('rubik')\n  const theme = ref('system')\n\n  const labelFor = (options) => (value) =>\n    options.find((option) => option.value === value)?.label ?? ''\n</script>\n\n<template>\n  <div class=\"layout-column-form flex min-w-0 flex-col\">\n    <SettingsSection\n      title=\"Appearance\"\n      hint=\"Preferences for this browser, applied the moment you change them and not part of Save.\"\n      anchor=\"appearance\"\n    >\n      <Card :padded=\"false\">\n        <template #content>\n          <Item.List>\n            <SettingRow\n              title=\"Font family\"\n              description=\"The primary sans typeface across the interface.\"\n            >\n              <Select\n                v-model=\"font\"\n                size=\"large\"\n                :display-value=\"labelFor(fonts)\"\n              >\n                <Select.Trigger\n                  class=\"w-full\"\n                  aria-label=\"Font family\"\n                />\n                <Select.Content>\n                  <Select.Option\n                    v-for=\"option in fonts\"\n                    :key=\"option.value\"\n                    :value=\"option.value\"\n                  >\n                    {{ option.label }}\n                  </Select.Option>\n                </Select.Content>\n              </Select>\n            </SettingRow>\n            <SettingRow\n              title=\"System appearance\"\n              description=\"Follow the operating system, or force a light or dark theme.\"\n            >\n              <Select\n                v-model=\"theme\"\n                size=\"large\"\n                :display-value=\"labelFor(appearances)\"\n              >\n                <Select.Trigger\n                  class=\"w-full\"\n                  aria-label=\"System appearance\"\n                />\n                <Select.Content>\n                  <Select.Option\n                    v-for=\"option in appearances\"\n                    :key=\"option.value\"\n                    :value=\"option.value\"\n                  >\n                    {{ option.label }}\n                  </Select.Option>\n                </Select.Content>\n              </Select>\n            </SettingRow>\n          </Item.List>\n        </template>\n      </Card>\n    </SettingsSection>\n  </div>\n</template>"
  },
  {
   "name": "Stacked",
   "summary": "A resource's Settings tab: the General and Features bands stacked one under the other at the section gap, with no rule between them.",
   "sfc": "<script setup>\n  import Card from '@aziontech/webkit/card'\n  import Input from '@aziontech/webkit/input'\n  import Item from '@aziontech/webkit/item'\n  import SettingRow from '@aziontech/webkit/setting-row'\n  import SettingsSection from '@aziontech/webkit/settings-section'\n  import Switch from '@aziontech/webkit/switch'\n  import { ref } from 'vue'\n\n  const defaultFeatures = [\n    {\n      key: 'compression',\n      title: 'Compression',\n      description: 'Compress text responses with gzip or Brotli.'\n    },\n    { key: 'cache', title: 'Cache', description: 'Customize advanced cache settings.' },\n    {\n      key: 'image_optimization',\n      title: 'Image Optimization',\n      description: 'Enable dynamic image resizing and format conversion.'\n    }\n  ]\n\n  const name = ref('web-app')\n  const active = ref(true)\n  const features = ref({ compression: true, cache: true, image_optimization: false })\n</script>\n\n<template>\n  <div class=\"layout-column-form flex min-w-0 flex-col\">\n    <SettingsSection\n      title=\"General\"\n      hint=\"How this resource is identified, and whether it is serving traffic.\"\n      anchor=\"general\"\n    >\n      <Card :padded=\"false\">\n        <template #content>\n          <Item.List>\n            <SettingRow\n              title=\"Name\"\n              description=\"A unique and descriptive name to identify the resource.\"\n            >\n              <Input\n                v-model=\"name\"\n                size=\"large\"\n                class=\"w-full\"\n                aria-label=\"Name\"\n              />\n            </SettingRow>\n            <SettingRow\n              title=\"Active\"\n              description=\"When disabled, the resource stops serving traffic.\"\n              kind=\"compact\"\n            >\n              <Switch\n                v-model=\"active\"\n                aria-label=\"Active\"\n              />\n            </SettingRow>\n          </Item.List>\n        </template>\n      </Card>\n    </SettingsSection>\n    <SettingsSection\n      title=\"Features\"\n      hint=\"The capabilities this resource runs with, each of which can be toggled here.\"\n      anchor=\"features\"\n    >\n      <Card :padded=\"false\">\n        <template #content>\n          <Item.List>\n            <SettingRow\n              v-for=\"feature in defaultFeatures\"\n              :key=\"feature.key\"\n              :title=\"feature.title\"\n              :description=\"feature.description\"\n              kind=\"compact\"\n            >\n              <Switch\n                v-model=\"features[feature.key]\"\n                :aria-label=\"feature.title\"\n              />\n            </SettingRow>\n          </Item.List>\n        </template>\n      </Card>\n    </SettingsSection>\n  </div>\n</template>"
  },
  {
   "name": "Collapsible",
   "summary": "The collapsible Advanced band, closed: the cog glyph and the title are the disclosure trigger, and the body unfolds along the grid track when it opens.",
   "sfc": "<script setup>\n  import Card from '@aziontech/webkit/card'\n  import Item from '@aziontech/webkit/item'\n  import SettingRow from '@aziontech/webkit/setting-row'\n  import SettingsSection from '@aziontech/webkit/settings-section'\n  import Switch from '@aziontech/webkit/switch'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n  const active = ref(true)\n</script>\n\n<template>\n  <div class=\"layout-column-form flex min-w-0 flex-col\">\n    <SettingsSection\n      v-model:open=\"open\"\n      title=\"Advanced\"\n      icon=\"pi pi-cog\"\n      collapsible\n    >\n      <Card :padded=\"false\">\n        <template #content>\n          <Item.List>\n            <SettingRow\n              title=\"Active\"\n              description=\"Inactive teams keep their permissions but can't be assigned.\"\n              kind=\"compact\"\n            >\n              <Switch\n                v-model=\"active\"\n                aria-label=\"Active\"\n              />\n            </SettingRow>\n          </Item.List>\n        </template>\n      </Card>\n    </SettingsSection>\n  </div>\n</template>"
  }
 ]
}
