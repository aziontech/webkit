   "name": "Default",
   "summary": "A window mockup with the console rail, a breadcrumb title and three parts on successive beats, fading at the bottom. The host sets the height; the frame scales the 860 design width to fit it.",
   "sfc": "<script setup>\n  import ShellMockup from '@aziontech/webkit/shell-mockup'\n  import Button from '@aziontech/webkit/button'\n  import Input from '@aziontech/webkit/input'\n  import Table from '@aziontech/webkit/table'\n  import Tag from '@aziontech/webkit/tag'\n</script>\n\n<template>\n  <div class=\"h-96 w-full\">\n    <ShellMockup\n      title=\"Workloads › my-workload\"\n      rail=\"workloads\"\n      fade=\"bottom\"\n    >\n      <div class=\"flex flex-col gap-(--spacing-md) p-(--spacing-lg)\">\n        <ShellMockup.Part :order=\"0\">\n          <div class=\"flex items-center justify-between gap-(--spacing-md)\">\n            <span class=\"text-heading-sm text-(--text-default)\">Workloads</span>\n            <Button\n              label=\"Create workload\"\n              icon=\"pi pi-plus\"\n              size=\"medium\"\n            />\n          </div>\n        </ShellMockup.Part>\n        <ShellMockup.Part :order=\"1\">\n          <div class=\"flex items-center gap-(--spacing-sm)\">\n            <Input\n              placeholder=\"Search workloads\"\n              size=\"small\"\n            />\n            <Tag\n              label=\"3 active\"\n              severity=\"success\"\n              size=\"small\"\n            />\n          </div>\n        </ShellMockup.Part>\n        <ShellMockup.Part :order=\"2\">\n          <Table bordered>\n            <Table.Header>\n              <Table.Row>\n                <Table.HeadCell principal>Name</Table.HeadCell>\n                <Table.HeadCell>Domain</Table.HeadCell>\n                <Table.HeadCell>Status</Table.HeadCell>\n              </Table.Row>\n            </Table.Header>\n            <Table.Body>\n              <Table.Row>\n                <Table.Cell principal>my-workload</Table.Cell>\n                <Table.Cell>my-workload.azion.app</Table.Cell>\n                <Table.Cell\n                  ><Tag\n                    label=\"Active\"\n                    severity=\"success\"\n                    size=\"small\"\n                /></Table.Cell>\n              </Table.Row>\n              <Table.Row>\n                <Table.Cell principal>storefront</Table.Cell>\n                <Table.Cell>shop.example.com</Table.Cell>\n                <Table.Cell\n                  ><Tag\n                    label=\"Active\"\n                    severity=\"success\"\n                    size=\"small\"\n                /></Table.Cell>\n              </Table.Row>\n              <Table.Row>\n                <Table.Cell principal>docs-portal</Table.Cell>\n                <Table.Cell>docs.example.com</Table.Cell>\n                <Table.Cell\n                  ><Tag\n                    label=\"Deploying\"\n                    severity=\"warning\"\n                    size=\"small\"\n                /></Table.Cell>\n              </Table.Row>\n            </Table.Body>\n          </Table>\n        </ShellMockup.Part>\n      </div>\n    </ShellMockup>\n  </div>\n</template>"
  },
