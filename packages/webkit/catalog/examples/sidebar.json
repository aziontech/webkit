{
 "examples": [
  {
   "name": "Default",
   "summary": "The console rail, whole: a header whose search field opens a ⌘K palette, grouped navigation composed with `Menu`, and a footer carrying the account identity and its menu. The navigation scrolls inside the built-in `ScrollArea` while the header and footer stay put. `Menu` takes `role=\"presentation\"` because the sidebar is already the `<nav>` landmark — it drops its accessible name with the role, so the region has exactly one name. Expand \"Edge Functions\" for a level that opens in place behind the indent rail; activate \"Settings\" for a drill level that replaces the menu.",
   "sfc": "<script setup>\n  import Avatar from '@aziontech/webkit/avatar'\n  import CommandEmpty from '@aziontech/webkit/command-empty'\n  import CommandGroup from '@aziontech/webkit/command-group'\n  import CommandInput from '@aziontech/webkit/command-input'\n  import CommandItem from '@aziontech/webkit/command-item'\n  import CommandList from '@aziontech/webkit/command-list'\n  import Command from '@aziontech/webkit/command-root'\n  import CommandSeparator from '@aziontech/webkit/command-separator'\n  import DropdownMenuGroup from '@aziontech/webkit/dropdown-menu-group'\n  import DropdownMenuOption from '@aziontech/webkit/dropdown-menu-option'\n  import DropdownMenu from '@aziontech/webkit/dropdown-menu-root'\n  import DropdownMenuTrigger from '@aziontech/webkit/dropdown-menu-trigger'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import MenuBack from '@aziontech/webkit/menu-back'\n  import MenuGroup from '@aziontech/webkit/menu-group'\n  import MenuItem from '@aziontech/webkit/menu-item'\n  import Menu from '@aziontech/webkit/menu-root'\n  import MenuSub from '@aziontech/webkit/menu-sub'\n  import MenuSubContent from '@aziontech/webkit/menu-sub-content'\n  import MenuSubTrigger from '@aziontech/webkit/menu-sub-trigger'\n  import SearchTrigger from '@aziontech/webkit/search-trigger'\n  import Sidebar from '@aziontech/webkit/sidebar'\n  import SidebarFooter from '@aziontech/webkit/sidebar-footer'\n  import SidebarHeader from '@aziontech/webkit/sidebar-header'\n  import { ref } from 'vue'\n\n  const accountMenuOpen = ref(false)\n  const paletteOpen = ref(false)\n</script>\n\n<template>\n  <div class=\"h-screen w-[280px]\">\n    <Sidebar aria-label=\"Console\">\n      <template #header>\n        <SidebarHeader>\n          <SearchTrigger\n            class=\"w-full\"\n            @open=\"paletteOpen = true\"\n          />\n\n          <Command v-model:open=\"paletteOpen\">\n            <CommandInput placeholder=\"Search navigation and commands\" />\n            <CommandList>\n              <CommandGroup heading=\"Build\">\n                <CommandItem value=\"nav:applications\">\n                  <template #prefix\n                    ><i\n                      class=\"ai ai-edge-application\"\n                      aria-hidden=\"true\"\n                  /></template>\n                  Applications\n                </CommandItem>\n                <CommandItem value=\"nav:variables\">\n                  <template #prefix\n                    ><i\n                      class=\"ai ai-variables\"\n                      aria-hidden=\"true\"\n                  /></template>\n                  Variables\n                </CommandItem>\n              </CommandGroup>\n\n              <CommandSeparator />\n\n              <CommandGroup heading=\"Account\">\n                <CommandItem value=\"cmd:settings\">\n                  <template #prefix\n                    ><i\n                      class=\"pi pi-cog\"\n                      aria-hidden=\"true\"\n                  /></template>\n                  Account Settings\n                </CommandItem>\n              </CommandGroup>\n\n              <CommandEmpty>No navigation or command matches your search.</CommandEmpty>\n            </CommandList>\n          </Command>\n        </SidebarHeader>\n      </template>\n      <Menu role=\"presentation\">\n        <MenuBack />\n        <MenuGroup>\n          <MenuItem\n            label=\"Home\"\n            icon=\"ai ai-home\"\n            href=\"/\"\n            selected\n          />\n          <MenuItem\n            label=\"Marketplace\"\n            icon=\"ai ai-marketplace\"\n            href=\"/marketplace\"\n          />\n        </MenuGroup>\n        <MenuGroup label=\"Build\">\n          <MenuItem\n            label=\"Applications\"\n            icon=\"ai ai-edge-application\"\n            href=\"/applications\"\n          />\n          <MenuSub default-open>\n            <MenuSubTrigger\n              label=\"Edge Functions\"\n              kind=\"inline\"\n            />\n            <MenuSubContent>\n              <MenuItem\n                label=\"Runtime APIs\"\n                href=\"/functions/runtime-apis\"\n              />\n              <MenuItem\n                label=\"Bundlers\"\n                href=\"/functions/bundlers\"\n              />\n            </MenuSubContent>\n          </MenuSub>\n          <MenuItem\n            label=\"Variables\"\n            icon=\"ai ai-variables\"\n            href=\"/variables\"\n          />\n        </MenuGroup>\n        <MenuGroup label=\"Store\">\n          <MenuItem\n            label=\"Object Storage\"\n            icon=\"ai ai-edge-storage\"\n            href=\"/object-storage\"\n          />\n          <MenuItem\n            label=\"SQL Database\"\n            icon=\"ai ai-edge-sql\"\n            href=\"/sql-database\"\n            tag-value=\"Preview\"\n            tag-severity=\"primary\"\n          />\n        </MenuGroup>\n        <MenuGroup label=\"Account\">\n          <MenuSub>\n            <MenuSubTrigger\n              label=\"Settings\"\n              icon=\"pi pi-cog\"\n              kind=\"drill\"\n            />\n            <MenuSubContent>\n              <MenuGroup label=\"Organization\">\n                <MenuItem\n                  label=\"General\"\n                  href=\"/settings/general\"\n                />\n                <MenuItem\n                  label=\"Members\"\n                  href=\"/settings/members\"\n                />\n                <MenuItem\n                  label=\"Billing\"\n                  href=\"/settings/billing\"\n                />\n              </MenuGroup>\n            </MenuSubContent>\n          </MenuSub>\n        </MenuGroup>\n      </Menu>\n      <template #footer>\n        <SidebarFooter>\n          <div class=\"flex items-center gap-(--spacing-xs)\">\n            <Avatar\n              kind=\"square\"\n              size=\"small\"\n              label=\"AM\"\n              alt=\"Alex Morgan\"\n            />\n            <span class=\"min-w-0 flex-1 truncate text-label-sm text-(--text-default)\"\n              >Alex Morgan</span\n            >\n            <DropdownMenu\n              v-model:open=\"accountMenuOpen\"\n              placement=\"top-end\"\n            >\n              <DropdownMenuTrigger>\n                <IconButton\n                  icon=\"pi pi-ellipsis-v\"\n                  aria-label=\"Account menu\"\n                  kind=\"outlined\"\n                  size=\"small\"\n                />\n              </DropdownMenuTrigger>\n              <DropdownMenuGroup>\n                <template #top>\n                  <div class=\"flex min-w-0 flex-col\">\n                    <span class=\"truncate text-label-md text-(--text-default)\">Alex Morgan</span>\n                    <span class=\"truncate text-body-xs text-(--text-muted)\"\n                      >rafael.umman@example.com</span\n                    >\n                  </div>\n                </template>\n                <DropdownMenuOption\n                  value=\"settings\"\n                  label=\"Account Settings\"\n                />\n                <DropdownMenuOption\n                  value=\"personal-tokens\"\n                  label=\"Personal Tokens\"\n                />\n              </DropdownMenuGroup>\n              <DropdownMenuGroup>\n                <DropdownMenuOption\n                  value=\"logout\"\n                  label=\"Log Out\"\n                >\n                  <template #right\n                    ><i\n                      class=\"pi pi-sign-out\"\n                      aria-hidden=\"true\"\n                  /></template>\n                </DropdownMenuOption>\n              </DropdownMenuGroup>\n            </DropdownMenu>\n          </div>\n        </SidebarFooter>\n      </template>\n    </Sidebar>\n  </div>\n</template>"
  }
 ]
}
