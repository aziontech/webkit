   "sfc": "<script setup>\n  import Skeleton from '@aziontech/webkit/skeleton'\n</script>\n\n<template>\n  <Skeleton\n    kind=\"shape\"\n    width=\"240px\"\n    height=\"100px\"\n    animated\n  />\n</template>"
