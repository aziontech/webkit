   "sfc": "<script setup>\n  import Skeleton from '@aziontech/webkit/skeleton'\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-center gap-4\">\n    <Skeleton\n      kind=\"shape\"\n      width=\"240px\"\n      height=\"100px\"\n    />\n    <Skeleton\n      kind=\"circle\"\n      width=\"100px\"\n      height=\"100px\"\n    />\n  </div>\n</template>"
