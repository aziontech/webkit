  {
   "name": "OnSurfaces",
   "summary": "The same placeholder on all four surface layers. The fill is `var(--bg-placeholder)`, a translucent role rather than an opaque surface, so it composites over whatever sits behind it and holds its contrast on every layer — in both themes. Built from a surface token instead, a placeholder is only legible on the one surface it was picked against.",
   "sfc": "<script setup>\n  import Skeleton from '@aziontech/webkit/skeleton'\n</script>\n\n<template>\n  <div class=\"grid grid-cols-2 gap-(--spacing-md)\">\n    <div\n      class=\"flex flex-col gap-(--spacing-sm) rounded-(--shape-card) bg-(--bg-canvas) p-(--spacing-md)\"\n    >\n      <span class=\"text-label-sm text-(--text-muted)\">--bg-canvas</span>\n      <Skeleton\n        kind=\"shape\"\n        width=\"100%\"\n        height=\"16px\"\n      />\n      <Skeleton\n        kind=\"shape\"\n        width=\"60%\"\n        height=\"16px\"\n      />\n    </div>\n    <div\n      class=\"flex flex-col gap-(--spacing-sm) rounded-(--shape-card) bg-(--bg-surface) p-(--spacing-md)\"\n    >\n      <span class=\"text-label-sm text-(--text-muted)\">--bg-surface</span>\n      <Skeleton\n        kind=\"shape\"\n        width=\"100%\"\n        height=\"16px\"\n      />\n      <Skeleton\n        kind=\"shape\"\n        width=\"60%\"\n        height=\"16px\"\n      />\n    </div>\n    <div\n      class=\"flex flex-col gap-(--spacing-sm) rounded-(--shape-card) bg-(--bg-surface-raised) p-(--spacing-md)\"\n    >\n      <span class=\"text-label-sm text-(--text-muted)\">--bg-surface-raised</span>\n      <Skeleton\n        kind=\"shape\"\n        width=\"100%\"\n        height=\"16px\"\n      />\n      <Skeleton\n        kind=\"shape\"\n        width=\"60%\"\n        height=\"16px\"\n      />\n    </div>\n    <div\n      class=\"flex flex-col gap-(--spacing-sm) rounded-(--shape-card) bg-(--bg-surface-overlay) p-(--spacing-md)\"\n    >\n      <span class=\"text-label-sm text-(--text-muted)\">--bg-surface-overlay</span>\n      <Skeleton\n        kind=\"shape\"\n        width=\"100%\"\n        height=\"16px\"\n      />\n      <Skeleton\n        kind=\"shape\"\n        width=\"60%\"\n        height=\"16px\"\n      />\n    </div>\n  </div>\n</template>"
