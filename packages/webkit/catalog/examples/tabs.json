{
 "examples": [
  {
   "name": "Default",
   "summary": "Three tabs with sliding indicator and horizontally animated panels. The active tab is held in `v-model`; clicking a tab or using Arrow / Home / End keys updates it.",
   "sfc": "<script setup>\n  import Tabs from '@aziontech/webkit/tabs'\n  import { ref } from 'vue'\n\n  const active = ref('tab-1')\n</script>\n\n<template>\n  <Tabs\n    v-model=\"active\"\n    class=\"w-full max-w-[40rem]\"\n  >\n    <Tabs.List>\n      <Tabs.Trigger\n        value=\"tab-1\"\n        label=\"Tab Item\"\n      />\n      <Tabs.Trigger\n        value=\"tab-2\"\n        label=\"Tab Item\"\n      />\n      <Tabs.Trigger\n        value=\"tab-3\"\n        label=\"Tab Item\"\n      />\n    </Tabs.List>\n    <div class=\"mt-(--spacing-4) w-full\">\n      <Tabs.Content value=\"tab-1\">\n        <div class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\">\n          <p class=\"text-body-sm text-(--text-default)\">Content for tab 1</p>\n        </div>\n      </Tabs.Content>\n      <Tabs.Content value=\"tab-2\">\n        <div class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\">\n          <p class=\"text-body-sm text-(--text-default)\">Content for tab 2</p>\n        </div>\n      </Tabs.Content>\n      <Tabs.Content value=\"tab-3\">\n        <div class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\">\n          <p class=\"text-body-sm text-(--text-default)\">Content for tab 3</p>\n        </div>\n      </Tabs.Content>\n    </div>\n  </Tabs>\n</template>"
  },
  {
   "name": "Centered",
   "summary": "`Tabs.List align=\"center\"` centres the tabs over a centred catalog, as the Marketplace page does. The row still scrolls from its first tab when it overflows.",
   "sfc": "<script setup>\n  import Tabs from '@aziontech/webkit/tabs'\n  import { ref } from 'vue'\n\n  const active = ref('templates')\n</script>\n\n<template>\n  <Tabs\n    v-model=\"active\"\n    class=\"w-full max-w-[40rem]\"\n  >\n    <Tabs.List align=\"center\">\n      <Tabs.Trigger\n        value=\"templates\"\n        label=\"Templates\"\n      />\n      <Tabs.Trigger\n        value=\"integrations\"\n        label=\"Integrations\"\n      />\n    </Tabs.List>\n    <div class=\"mt-(--spacing-lg) w-full\">\n      <Tabs.Content value=\"templates\">\n        <p class=\"text-center text-body-sm text-(--text-muted)\">\n          Start a project from a template built for the edge.\n        </p>\n      </Tabs.Content>\n      <Tabs.Content value=\"integrations\">\n        <p class=\"text-center text-body-sm text-(--text-muted)\">\n          Connect the services your applications already use.\n        </p>\n      </Tabs.Content>\n    </div>\n  </Tabs>\n</template>"
  },
  {
   "name": "Scrollable",
   "summary": "More tabs than fit the container: on narrow (mobile) widths the tab bar scrolls horizontally instead of overflowing or wrapping, the scrollbar is hidden, and the active indicator stays aligned while scrolling.",
   "sfc": "<script setup>\n  import Tabs from '@aziontech/webkit/tabs'\n  import { ref } from 'vue'\n\n  const tabs = [\n    {\n      value: 'tab-1',\n      label: 'Overview'\n    },\n    {\n      value: 'tab-2',\n      label: 'Metrics'\n    },\n    {\n      value: 'tab-3',\n      label: 'Logs'\n    },\n    {\n      value: 'tab-4',\n      label: 'Settings'\n    },\n    {\n      value: 'tab-5',\n      label: 'Security'\n    },\n    {\n      value: 'tab-6',\n      label: 'Integrations'\n    },\n    {\n      value: 'tab-7',\n      label: 'Billing'\n    },\n    {\n      value: 'tab-8',\n      label: 'Advanced'\n    }\n  ]\n  const active = ref('tab-1')\n</script>\n\n<template>\n  <Tabs\n    v-model=\"active\"\n    class=\"w-full max-w-[20rem]\"\n  >\n    <Tabs.List>\n      <Tabs.Trigger\n        v-for=\"tab in tabs\"\n        :key=\"tab.value\"\n        :value=\"tab.value\"\n        :label=\"tab.label\"\n      />\n    </Tabs.List>\n    <div class=\"mt-(--spacing-4) w-full\">\n      <Tabs.Content\n        v-for=\"tab in tabs\"\n        :key=\"tab.value\"\n        :value=\"tab.value\"\n      >\n        <div class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\">\n          <p class=\"text-body-sm text-(--text-default)\">Content for {{ tab.label }}</p>\n        </div>\n      </Tabs.Content>\n    </div>\n  </Tabs>\n</template>"
  }
 ]
}
