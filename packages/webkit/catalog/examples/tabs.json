 "examples": [
  {
   "name": "Default",
   "summary": "Three tabs with sliding indicator and horizontally animated panels. The active tab is held in `v-model`; clicking a tab or using Arrow / Home / End keys updates it.",
   "sfc": "<script setup>\n  import Tabs from '@aziontech/webkit/tabs'\n  import { ref } from 'vue'\n\n  const active = ref('tab-1')\n</script>\n\n<template>\n  <Tabs.Root\n    v-model=\"active\"\n    class=\"w-full max-w-[40rem]\"\n  >\n    <Tabs.List>\n      <Tabs.Item\n        value=\"tab-1\"\n        label=\"Tab Item\"\n      />\n      <Tabs.Item\n        value=\"tab-2\"\n        label=\"Tab Item\"\n      />\n      <Tabs.Item\n        value=\"tab-3\"\n        label=\"Tab Item\"\n      />\n    </Tabs.List>\n    <Tabs.Content class=\"mt-(--spacing-4)\">\n      <Tabs.Panel\n        value=\"tab-1\"\n        class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\"\n      >\n        <p class=\"text-body-sm text-(--text-default)\">Content for tab 1</p>\n      </Tabs.Panel>\n      <Tabs.Panel\n        value=\"tab-2\"\n        class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\"\n      >\n        <p class=\"text-body-sm text-(--text-default)\">Content for tab 2</p>\n      </Tabs.Panel>\n      <Tabs.Panel\n        value=\"tab-3\"\n        class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\"\n      >\n        <p class=\"text-body-sm text-(--text-default)\">Content for tab 3</p>\n      </Tabs.Panel>\n    </Tabs.Content>\n  </Tabs.Root>\n</template>"
  },
  {
   "name": "Standalone",
   "summary": "A `Tabs.Item` used on its own, outside a `Tabs.Root` — a highlight chip rather than a tab. With no context to inject, the item reads its own `selected` prop, and it carries the pill treatment itself: the translucent mask, the hairline border and the small shadow that the List’s sliding indicator supplies in the composed case. This is the only story that renders that branch.",
   "sfc": "<script setup>\n  import Tabs from '@aziontech/webkit/tabs'\n</script>\n\n<template>\n  <div class=\"flex items-center gap-(--spacing-xxs)\">\n    <Tabs.Item\n      label=\"Selected\"\n      selected\n    />\n    <Tabs.Item label=\"Idle\" />\n    <Tabs.Item\n      label=\"Disabled\"\n      disabled\n    />\n  </div>\n</template>"
  },
  {
   "name": "Scrollable",
   "summary": "More tabs than fit the container: on narrow (mobile) widths the tab bar scrolls horizontally instead of overflowing or wrapping, the scrollbar is hidden, and the active indicator stays aligned while scrolling.",
   "sfc": "<script setup>\n  import Tabs from '@aziontech/webkit/tabs'\n  import { ref } from 'vue'\n\n  const tabs = [\n    {\n      value: 'tab-1',\n      label: 'Overview'\n    },\n    {\n      value: 'tab-2',\n      label: 'Metrics'\n    },\n    {\n      value: 'tab-3',\n      label: 'Logs'\n    },\n    {\n      value: 'tab-4',\n      label: 'Settings'\n    },\n    {\n      value: 'tab-5',\n      label: 'Security'\n    },\n    {\n      value: 'tab-6',\n      label: 'Integrations'\n    },\n    {\n      value: 'tab-7',\n      label: 'Billing'\n    },\n    {\n      value: 'tab-8',\n      label: 'Advanced'\n    }\n  ]\n  const active = ref('tab-1')\n</script>\n\n<template>\n  <Tabs.Root\n    v-model=\"active\"\n    class=\"w-full max-w-[20rem]\"\n  >\n    <Tabs.List>\n      <Tabs.Item\n        v-for=\"tab in tabs\"\n        :key=\"tab.value\"\n        :value=\"tab.value\"\n        :label=\"tab.label\"\n      />\n    </Tabs.List>\n    <Tabs.Content class=\"mt-(--spacing-4)\">\n      <Tabs.Panel\n        v-for=\"tab in tabs\"\n        :key=\"tab.value\"\n        :value=\"tab.value\"\n        class=\"rounded-(--shape-card) border border-(--border-default) p-(--spacing-4)\"\n      >\n        <p class=\"text-body-sm text-(--text-default)\">Content for {{ tab.label }}</p>\n      </Tabs.Panel>\n    </Tabs.Content>\n  </Tabs.Root>\n</template>"
  }
 ]
