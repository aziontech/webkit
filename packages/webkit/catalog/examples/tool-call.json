{
 "examples": [
  {
   "name": "States",
   "summary": "Every state of a tool call in the order an agent goes through them: waiting for authorization, running, completed, failed and denied, each with its status in text.",
   "sfc": "<script setup>\n  import ToolCall from '@aziontech/webkit/tool-call'\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-3xl) flex-col gap-(--spacing-xs)\">\n    <ToolCall\n      name=\"purge_urls\"\n      title=\"Purging one URL\"\n      state=\"pending\"\n    />\n    <ToolCall\n      name=\"list_workloads\"\n      title=\"Listing your workloads\"\n      state=\"running\"\n    />\n    <ToolCall\n      name=\"get_cache_settings\"\n      title=\"Reading the cache settings of storefront\"\n      state=\"success\"\n    />\n    <ToolCall\n      name=\"get_metrics\"\n      title=\"Reading the error rate\"\n      state=\"error\"\n    />\n    <ToolCall\n      name=\"delete_domain\"\n      title=\"Deleting www.example.com\"\n      state=\"denied\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "WithDetails",
   "summary": "A completed call whose input and output open under the row as code, and a failed call opened by default so the reader sees the error.",
   "sfc": "<script setup>\n  import CodeBlock from '@aziontech/webkit/code-block'\n  import ToolCall from '@aziontech/webkit/tool-call'\n\n  const input = JSON.stringify({ workload: 'storefront' }, null, 2)\n  const output = JSON.stringify({ cache_by_query_string: 'all', ttl: 3600 }, null, 2)\n  const failure = JSON.stringify({ error: 'metrics_unavailable', retry_after: 30 }, null, 2)\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-3xl) flex-col gap-(--spacing-xs)\">\n    <ToolCall\n      name=\"get_cache_settings\"\n      title=\"Reading the cache settings of storefront\"\n      state=\"success\"\n    >\n      <template #input>\n        <CodeBlock\n          :tabs=\"[{ label: 'JSON', value: 'input', code: input, language: 'json' }]\"\n          :show-line-numbers=\"false\"\n        />\n      </template>\n      <template #output>\n        <CodeBlock\n          :tabs=\"[{ label: 'JSON', value: 'output', code: output, language: 'json' }]\"\n          :show-line-numbers=\"false\"\n        />\n      </template>\n    </ToolCall>\n    <ToolCall\n      name=\"get_metrics\"\n      title=\"Reading the error rate\"\n      state=\"error\"\n      default-open\n    >\n      <template #output>\n        <CodeBlock\n          :tabs=\"[{ label: 'JSON', value: 'error', code: failure, language: 'json' }]\"\n          :show-line-numbers=\"false\"\n        />\n      </template>\n    </ToolCall>\n  </div>\n</template>"
  }
 ]
}
