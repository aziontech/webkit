{
 "examples": [
  {
   "name": "Default",
   "summary": "A project's deployment topology from its domains to its storage: each column is a depth, connectors join every node to the next column, and a card opens to its fields. The bound policy can be changed or removed, the unbound error page offers Bind, and the domains card adds a domain through the `actions` slot.",
   "sfc": "<script setup>\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Tooltip from '@aziontech/webkit/tooltip'\n  import TopologyDiagram from '@aziontech/webkit/topology-diagram'\n  import { ref } from 'vue'\n\n  const policies = [\n    { value: 'edge-guard', label: 'edge-guard' },\n    { value: 'strict-waf', label: 'strict-waf' }\n  ]\n  const errorPages = [{ value: 'maintenance', label: 'maintenance' }]\n\n  const levels = [\n    {\n      id: 'domains',\n      label: 'Domains',\n      nodes: [\n        {\n          id: 'domains',\n          type: 'Domains',\n          icon: 'ai ai-globe',\n          name: 'shop.example.com',\n          status: '2 domains',\n          severity: 'info',\n          fields: [\n            {\n              label: 'Platform domain',\n              value: 'web-app-k3x9q2.example.net',\n              href: 'https://web-app-k3x9q2.example.net',\n              copyable: true\n            },\n            {\n              label: 'Custom domain',\n              value: 'shop.example.com',\n              href: 'https://shop.example.com',\n              copyable: true\n            }\n          ]\n        }\n      ]\n    },\n    {\n      id: 'project',\n      label: 'Project',\n      nodes: [\n        {\n          id: 'project',\n          type: 'Project',\n          icon: 'ai ai-folder',\n          name: 'web-app',\n          status: 'Live',\n          severity: 'success',\n          href: '#project',\n          fields: [\n            { label: 'ID', value: '1482736015', copyable: true },\n            { label: 'Environment', value: 'Production' }\n          ]\n        }\n      ]\n    },\n    {\n      id: 'policy',\n      label: 'Policy',\n      nodes: [\n        {\n          id: 'policy',\n          type: 'Policy',\n          icon: 'ai ai-shield',\n          name: 'edge-guard',\n          status: 'Active',\n          severity: 'success',\n          href: '#policy',\n          bindable: true,\n          bindOptions: policies,\n          boundValue: 'edge-guard',\n          removable: true,\n          fields: [{ label: 'Rules', value: '12 rules, 3 rate limits' }]\n        }\n      ]\n    },\n    {\n      id: 'service',\n      label: 'Service',\n      nodes: [\n        {\n          id: 'service',\n          type: 'Service',\n          icon: 'ai ai-server',\n          name: 'web-app',\n          status: 'Active',\n          severity: 'success',\n          href: '#service',\n          fields: [{ label: 'Version', value: 'AEO25I38' }]\n        },\n        {\n          id: 'error-page',\n          type: 'Error page',\n          icon: 'ai ai-file',\n          terminal: true,\n          bindable: true,\n          bindOptions: errorPages,\n          message: 'Errors answer with the default page.'\n        }\n      ]\n    },\n    {\n      id: 'cache',\n      label: 'Cache rules',\n      nodes: [\n        {\n          id: 'cache-static',\n          type: 'Cache rule',\n          icon: 'ai ai-bolt',\n          name: 'static-assets',\n          status: 'Active',\n          severity: 'success',\n          fields: [{ label: 'Lifetime', value: '30 days' }]\n        },\n        {\n          id: 'cache-api',\n          type: 'Cache rule',\n          icon: 'ai ai-bolt',\n          name: 'api-bypass',\n          status: 'Active',\n          severity: 'success',\n          fields: [{ label: 'Lifetime', value: 'Bypass' }]\n        }\n      ]\n    },\n    {\n      id: 'integration',\n      label: 'Integration',\n      nodes: [\n        {\n          id: 'integration',\n          type: 'Integration',\n          icon: 'ai ai-link',\n          name: 'web-app-origin',\n          status: 'Active',\n          severity: 'success',\n          message:\n            'Routes traffic from the service to its origin. It can be re-pointed but not removed.',\n          fields: [{ label: 'Origin', value: 'origin.example.com', copyable: true }]\n        }\n      ]\n    },\n    {\n      id: 'storage',\n      label: 'Storage',\n      nodes: [\n        {\n          id: 'storage',\n          type: 'Storage',\n          icon: 'ai ai-inbox',\n          name: 'web-app-assets',\n          status: 'Private',\n          severity: 'neutral',\n          terminal: true,\n          fields: [{ label: 'Objects', value: '24 files, 1.2 MB' }]\n        }\n      ]\n    }\n  ]\n\n  const openKeys = ref(['project'])\n  const note = ref('')\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-(--spacing-sm)\">\n    <div class=\"rounded-(--shape-card) border border-(--border-default) bg-(--bg-surface-raised)\">\n      <TopologyDiagram\n        v-model:open-keys=\"openKeys\"\n        :levels=\"levels\"\n        @bind=\"(event, { id, value }) => (note = `Bind ${value} to ${id}.`)\"\n        @remove=\"(event, id) => (note = `Remove ${id}.`)\"\n        @create=\"(event, id) => (note = `Create a new ${id}.`)\"\n      >\n        <template #actions=\"{ node }\">\n          <Tooltip\n            v-if=\"node.id === 'domains'\"\n            content=\"Add domain\"\n          >\n            <IconButton\n              icon=\"ai ai-plus\"\n              kind=\"outlined\"\n              size=\"small\"\n              aria-label=\"Add domain\"\n              @click=\"note = 'Add a domain.'\"\n            />\n          </Tooltip>\n        </template>\n      </TopologyDiagram>\n    </div>\n    <p\n      role=\"status\"\n      class=\"text-body-sm text-(--text-muted)\"\n    >\n      {{ note }}\n    </p>\n  </div>\n</template>"
  },
  {
   "name": "Binding",
   "summary": "Binding stages a change: the slot turns dashed and Staged with Deploy to apply this policy, removing a bound policy stages Deploy to remove it, and Create opens the create flow (here a status line). Nothing is applied until the next deploy.",
   "sfc": "<script setup>\n  import TopologyDiagram from '@aziontech/webkit/topology-diagram'\n  import { computed, reactive, ref } from 'vue'\n\n  const targets = {\n    policy: {\n      type: 'Policy',\n      icon: 'ai ai-shield',\n      options: [\n        { value: 'edge-guard', label: 'edge-guard' },\n        { value: 'strict-waf', label: 'strict-waf' }\n      ],\n      unbound: 'Requests reach the service without inspection.'\n    },\n    'error-page': {\n      type: 'Error page',\n      icon: 'ai ai-file',\n      options: [{ value: 'maintenance', label: 'maintenance' }],\n      unbound: 'Errors answer with the default page.'\n    }\n  }\n\n  const deployed = { policy: 'edge-guard', 'error-page': '' }\n  const staged = reactive({})\n  const openKeys = ref(['policy'])\n  const note = ref('')\n\n  const slot = (key) => {\n    const target = targets[key]\n    const pick = staged[key]\n    const removing = pick === ''\n    const value = pick === undefined ? deployed[key] : pick\n    const base = {\n      id: key,\n      type: target.type,\n      icon: target.icon,\n      bindable: true,\n      bindOptions: target.options,\n      removable: true\n    }\n    if (!value) {\n      return {\n        ...base,\n        status: removing ? 'Staged' : '',\n        severity: removing ? 'warning' : 'neutral',\n        dashed: true,\n        message: removing ? `Deploy to remove this ${target.type.toLowerCase()}.` : target.unbound\n      }\n    }\n    return {\n      ...base,\n      name: value,\n      boundValue: value,\n      status: pick === undefined ? 'Active' : 'Staged',\n      severity: pick === undefined ? 'success' : 'warning',\n      dashed: pick !== undefined,\n      message: pick === undefined ? '' : `Deploy to apply this ${target.type.toLowerCase()}.`\n    }\n  }\n\n  const levels = computed(() => [\n    {\n      id: 'project',\n      nodes: [\n        {\n          id: 'project',\n          type: 'Project',\n          icon: 'ai ai-folder',\n          name: 'web-app',\n          status: 'Live',\n          severity: 'success'\n        }\n      ]\n    },\n    { id: 'policy', nodes: [slot('policy')] },\n    {\n      id: 'service',\n      nodes: [\n        {\n          id: 'service',\n          type: 'Service',\n          icon: 'ai ai-server',\n          name: 'web-app',\n          status: 'Active',\n          severity: 'success'\n        },\n        { ...slot('error-page'), terminal: true }\n      ]\n    }\n  ])\n\n  const stagedCount = computed(() => Object.keys(staged).length)\n\n  const bind = (event, { id: key, value }) => {\n    if (value === deployed[key]) delete staged[key]\n    else staged[key] = value\n    note.value = `${value} staged on ${targets[key].type.toLowerCase()}.`\n  }\n  const remove = (event, key) => {\n    if (deployed[key]) staged[key] = ''\n    else delete staged[key]\n    note.value = `${targets[key].type} staged for removal.`\n  }\n  const create = (event, key) => {\n    note.value = `Opens the create flow for a new ${targets[key].type.toLowerCase()}.`\n  }\n</script>\n\n<template>\n  <div class=\"flex flex-col gap-(--spacing-sm)\">\n    <div class=\"rounded-(--shape-card) border border-(--border-default) bg-(--bg-surface-raised)\">\n      <TopologyDiagram\n        v-model:open-keys=\"openKeys\"\n        :levels=\"levels\"\n        @bind=\"bind\"\n        @remove=\"remove\"\n        @create=\"create\"\n      />\n    </div>\n    <p\n      role=\"status\"\n      class=\"text-body-sm text-(--text-muted)\"\n    >\n      {{ stagedCount ? `${stagedCount} staged. ${note}` : note }}\n    </p>\n  </div>\n</template>"
  },
  {
   "name": "Loading",
   "summary": "`loading` draws placeholder cards joined by connectors, marks the diagram busy and announces it once.",
   "sfc": "<script setup>\n  import TopologyDiagram from '@aziontech/webkit/topology-diagram'\n</script>\n\n<template>\n  <div class=\"rounded-(--shape-card) border border-(--border-default) bg-(--bg-surface-raised)\">\n    <TopologyDiagram loading />\n  </div>\n</template>"
  }
 ]
}
