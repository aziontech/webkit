{
 "examples": [
  {
   "name": "Default",
   "summary": "A bucket-like file tree three levels deep, with glyphs and size descriptions. Two folders are seeded in `v-model:expanded`; the chevron and ArrowRight / ArrowLeft fold the rest.",
   "sfc": "<script setup>\n  import Tree from '@aziontech/webkit/tree'\n  import { ref } from 'vue'\n\n  const items = [\n    {\n      id: 'assets',\n      label: 'assets',\n      icon: 'pi pi-folder',\n      children: [\n        {\n          id: 'assets/images',\n          label: 'images',\n          icon: 'pi pi-folder',\n          children: [\n            {\n              id: 'assets/images/hero.webp',\n              label: 'hero.webp',\n              icon: 'pi pi-file',\n              description: '248 KB'\n            },\n            {\n              id: 'assets/images/logo.svg',\n              label: 'logo.svg',\n              icon: 'pi pi-file',\n              description: '12 KB'\n            }\n          ]\n        },\n        {\n          id: 'assets/fonts',\n          label: 'fonts',\n          icon: 'pi pi-folder',\n          children: [\n            {\n              id: 'assets/fonts/rubik.woff2',\n              label: 'rubik.woff2',\n              icon: 'pi pi-file',\n              description: '64 KB'\n            }\n          ]\n        },\n        {\n          id: 'assets/styles.css',\n          label: 'styles.css',\n          icon: 'pi pi-file',\n          description: '18 KB'\n        }\n      ]\n    },\n    {\n      id: 'reports',\n      label: 'reports',\n      icon: 'pi pi-folder',\n      children: [\n        {\n          id: 'reports/2026-10.csv',\n          label: '2026-10.csv',\n          icon: 'pi pi-file',\n          description: '1.2 MB'\n        },\n        {\n          id: 'reports/2026-11.csv',\n          label: '2026-11.csv',\n          icon: 'pi pi-file',\n          description: '840 KB'\n        }\n      ]\n    },\n    {\n      id: 'index.html',\n      label: 'index.html',\n      icon: 'pi pi-file',\n      description: '4 KB'\n    },\n    {\n      id: 'robots.txt',\n      label: 'robots.txt',\n      icon: 'pi pi-file',\n      description: '1 KB'\n    }\n  ]\n\n  const expanded = ref(['assets', 'assets/images'])\n</script>\n\n<template>\n  <div class=\"max-w-(--container-sm)\">\n    <Tree\n      v-model:expanded=\"expanded\"\n      :items=\"items\"\n      aria-label=\"Bucket objects\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Selectable",
   "summary": "With `selectable`, activating a node writes its id to `v-model:selected`, marks the row selected and sets `aria-selected`. The bound id is shown under the tree.",
   "sfc": "<script setup>\n  import Tree from '@aziontech/webkit/tree'\n  import { ref } from 'vue'\n\n  const items = [\n    {\n      id: 'assets',\n      label: 'assets',\n      icon: 'pi pi-folder',\n      children: [\n        {\n          id: 'assets/images',\n          label: 'images',\n          icon: 'pi pi-folder',\n          children: [\n            {\n              id: 'assets/images/hero.webp',\n              label: 'hero.webp',\n              icon: 'pi pi-file',\n              description: '248 KB'\n            },\n            {\n              id: 'assets/images/logo.svg',\n              label: 'logo.svg',\n              icon: 'pi pi-file',\n              description: '12 KB'\n            }\n          ]\n        },\n        {\n          id: 'assets/fonts',\n          label: 'fonts',\n          icon: 'pi pi-folder',\n          children: [\n            {\n              id: 'assets/fonts/rubik.woff2',\n              label: 'rubik.woff2',\n              icon: 'pi pi-file',\n              description: '64 KB'\n            }\n          ]\n        },\n        {\n          id: 'assets/styles.css',\n          label: 'styles.css',\n          icon: 'pi pi-file',\n          description: '18 KB'\n        }\n      ]\n    },\n    {\n      id: 'reports',\n      label: 'reports',\n      icon: 'pi pi-folder',\n      children: [\n        {\n          id: 'reports/2026-10.csv',\n          label: '2026-10.csv',\n          icon: 'pi pi-file',\n          description: '1.2 MB'\n        },\n        {\n          id: 'reports/2026-11.csv',\n          label: '2026-11.csv',\n          icon: 'pi pi-file',\n          description: '840 KB'\n        }\n      ]\n    },\n    {\n      id: 'index.html',\n      label: 'index.html',\n      icon: 'pi pi-file',\n      description: '4 KB'\n    },\n    {\n      id: 'robots.txt',\n      label: 'robots.txt',\n      icon: 'pi pi-file',\n      description: '1 KB'\n    }\n  ]\n\n  const expanded = ref(['assets', 'assets/images'])\n  const selected = ref('assets/images/hero.webp')\n</script>\n\n<template>\n  <div class=\"flex max-w-(--container-sm) flex-col gap-(--spacing-md)\">\n    <Tree\n      v-model:expanded=\"expanded\"\n      v-model:selected=\"selected\"\n      :items=\"items\"\n      selectable\n      aria-label=\"Bucket objects\"\n    />\n    <p class=\"text-body-sm text-(--text-muted)\">Selected: {{ selected || 'none' }}</p>\n  </div>\n</template>"
  },
  {
   "name": "CustomItem",
   "summary": "The `item` slot replaces the label region of every row, here adding a status `Tag`; the `actions` slot adds an end-aligned `IconButton` per row. The chevron, indentation and row states stay owned by the tree.",
   "sfc": "<script setup>\n  import Tree from '@aziontech/webkit/tree'\n  import Tag from '@aziontech/webkit/tag'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import { ref } from 'vue'\n\n  const items = [\n    {\n      id: 'assets',\n      label: 'assets',\n      icon: 'pi pi-folder',\n      children: [\n        {\n          id: 'assets/images',\n          label: 'images',\n          icon: 'pi pi-folder',\n          children: [\n            {\n              id: 'assets/images/hero.webp',\n              label: 'hero.webp',\n              icon: 'pi pi-file',\n              description: '248 KB'\n            },\n            {\n              id: 'assets/images/logo.svg',\n              label: 'logo.svg',\n              icon: 'pi pi-file',\n              description: '12 KB'\n            }\n          ]\n        },\n        {\n          id: 'assets/fonts',\n          label: 'fonts',\n          icon: 'pi pi-folder',\n          children: [\n            {\n              id: 'assets/fonts/rubik.woff2',\n              label: 'rubik.woff2',\n              icon: 'pi pi-file',\n              description: '64 KB'\n            }\n          ]\n        },\n        {\n          id: 'assets/styles.css',\n          label: 'styles.css',\n          icon: 'pi pi-file',\n          description: '18 KB'\n        }\n      ]\n    },\n    {\n      id: 'reports',\n      label: 'reports',\n      icon: 'pi pi-folder',\n      children: [\n        {\n          id: 'reports/2026-10.csv',\n          label: '2026-10.csv',\n          icon: 'pi pi-file',\n          description: '1.2 MB'\n        },\n        {\n          id: 'reports/2026-11.csv',\n          label: '2026-11.csv',\n          icon: 'pi pi-file',\n          description: '840 KB'\n        }\n      ]\n    },\n    {\n      id: 'index.html',\n      label: 'index.html',\n      icon: 'pi pi-file',\n      description: '4 KB'\n    },\n    {\n      id: 'robots.txt',\n      label: 'robots.txt',\n      icon: 'pi pi-file',\n      description: '1 KB'\n    }\n  ]\n\n  const expanded = ref(['assets', 'assets/images'])\n\n  const statuses = {\n    'assets/styles.css': {\n      label: 'Modified',\n      severity: 'warning'\n    },\n    'index.html': {\n      label: 'Published',\n      severity: 'success'\n    },\n    'robots.txt': {\n      label: 'Draft',\n      severity: 'secondary'\n    }\n  }\n</script>\n\n<template>\n  <div class=\"max-w-(--container-sm)\">\n    <Tree\n      v-model:expanded=\"expanded\"\n      :items=\"items\"\n      aria-label=\"Bucket objects\"\n    >\n      <template #item=\"{ item }\">\n        <span class=\"flex min-w-0 flex-1 items-center gap-(--spacing-xs)\">\n          <i\n            :class=\"item.icon\"\n            aria-hidden=\"true\"\n          />\n          <span class=\"min-w-0 truncate text-label-md text-(--text-default)\">{{ item.label }}</span>\n          <Tag\n            v-if=\"statuses[item.id]\"\n            :label=\"statuses[item.id].label\"\n            :severity=\"statuses[item.id].severity\"\n            size=\"small\"\n          />\n        </span>\n      </template>\n      <template #actions=\"{ item }\">\n        <IconButton\n          icon=\"pi pi-ellipsis-h\"\n          kind=\"transparent\"\n          size=\"small\"\n          :aria-label=\"'More actions for ' + item.label\"\n        />\n      </template>\n    </Tree>\n  </div>\n</template>"
  }
 ]
}
