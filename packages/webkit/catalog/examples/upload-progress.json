{
 "examples": [
  {
   "name": "Default",
   "summary": "An upload into a bucket: the header counts finished files over one overall bar, each file has its size, state and bar, and Cancel stops one file or, in the footer, all of them. Start upload replays the transfer.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import UploadProgress from '@aziontech/webkit/upload-progress'\n  import { onBeforeUnmount, ref } from 'vue'\n\n  const initial = () => [\n    { id: 'logo', name: 'logo.svg', size: 4210, status: 'done' },\n    { id: 'app', name: 'app.js', size: 248_320, status: 'running', progress: 64 },\n    { id: 'styles', name: 'styles.css', size: 52_100, status: 'running' },\n    { id: 'hero', name: 'hero.webp', size: 1_482_000, status: 'queued' }\n  ]\n\n  const items = ref(initial())\n  let timer = 0\n\n  const tick = () => {\n    let started = false\n    items.value = items.value.map((item) => {\n      if (item.status === 'running') {\n        const progress = Math.min(100, (item.progress ?? 0) + 18)\n        return progress >= 100 ? { ...item, status: 'done', progress } : { ...item, progress }\n      }\n      if (item.status === 'queued' && !started) {\n        started = true\n        return { ...item, status: 'running', progress: 0 }\n      }\n      return item\n    })\n    if (items.value.every((item) => item.status !== 'running' && item.status !== 'queued')) {\n      clearInterval(timer)\n    }\n  }\n\n  const start = () => {\n    clearInterval(timer)\n    items.value = initial()\n    timer = setInterval(tick, 600)\n  }\n\n  const cancel = (id) => {\n    items.value = items.value.map((item) =>\n      (id === undefined || item.id === id) &&\n      (item.status === 'running' || item.status === 'queued')\n        ? { ...item, status: 'canceled' }\n        : item\n    )\n  }\n\n  onBeforeUnmount(() => clearInterval(timer))\n</script>\n\n<template>\n  <div class=\"flex w-full max-w-(--container-xs) flex-col items-start gap-(--spacing-sm)\">\n    <Button\n      label=\"Start upload\"\n      kind=\"secondary\"\n      size=\"medium\"\n      icon=\"pi pi-upload\"\n      @click=\"start\"\n    />\n    <UploadProgress\n      :items=\"items\"\n      :floating=\"false\"\n      @cancel=\"(_event, id) => cancel(id)\"\n    />\n  </div>\n</template>"
  },
  {
   "name": "Finished",
   "summary": "Every file finished and one failed: the header states the outcome beside a danger mark, the failed row says why and offers Retry, Retry failed retries them all, and the `actions` slot adds Open folder beside Close.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import UploadProgress from '@aziontech/webkit/upload-progress'\n\n  const items = [\n    { id: 'logo', name: 'logo.svg', size: 4210, status: 'done' },\n    { id: 'app', name: 'app.js', size: 248_320, status: 'done' },\n    { id: 'video', name: 'intro.mp4', size: 96_400_000, status: 'error', error: 'Connection lost' },\n    { id: 'styles', name: 'styles.css', size: 52_100, status: 'done' }\n  ]\n</script>\n\n<template>\n  <div class=\"w-full max-w-(--container-xs)\">\n    <UploadProgress\n      :items=\"items\"\n      :floating=\"false\"\n    >\n      <template #actions>\n        <Button\n          label=\"Open folder\"\n          kind=\"secondary\"\n          size=\"small\"\n        />\n      </template>\n    </UploadProgress>\n  </div>\n</template>"
  },
  {
   "name": "Move",
   "summary": "A move between folders with `operation=\"move\"`, collapsed with `v-model:collapsed` so only the header and overall bar show.",
   "sfc": "<script setup>\n  import UploadProgress from '@aziontech/webkit/upload-progress'\n  import { ref } from 'vue'\n\n  const collapsed = ref(true)\n\n  const items = [\n    { id: 'a', name: 'reports/2026-10.csv', size: 18_200, status: 'done' },\n    { id: 'b', name: 'reports/2026-11.csv', size: 19_400, status: 'running', progress: 40 },\n    { id: 'c', name: 'reports/summary.pdf', size: 402_000, status: 'queued' }\n  ]\n</script>\n\n<template>\n  <div class=\"w-full max-w-(--container-xs)\">\n    <UploadProgress\n      v-model:collapsed=\"collapsed\"\n      :items=\"items\"\n      operation=\"move\"\n      :floating=\"false\"\n    />\n  </div>\n</template>"
  }
 ]
}
