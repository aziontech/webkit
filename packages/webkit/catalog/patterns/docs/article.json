{
 "sfc": "<script setup>\n  import Brand from '@aziontech/webkit/brand'\n  import Button from '@aziontech/webkit/button'\n  import CodeBlock from '@aziontech/webkit/code-block'\n  import DocCallout from '@aziontech/webkit/doc-callout'\n  import DocCard from '@aziontech/webkit/doc-card'\n  import DocCardGroup from '@aziontech/webkit/doc-card-group'\n  import DocCta from '@aziontech/webkit/doc-cta'\n  import DocHeading from '@aziontech/webkit/doc-heading'\n  import DocItem from '@aziontech/webkit/doc-item'\n  import DocOnThisPage from '@aziontech/webkit/doc-on-this-page'\n  import DocPageHeader from '@aziontech/webkit/doc-page-header'\n  import DocPagination from '@aziontech/webkit/doc-pagination'\n  import DocPrompt from '@aziontech/webkit/doc-prompt'\n  import DocProse from '@aziontech/webkit/doc-prose'\n  import DocStep from '@aziontech/webkit/doc-step'\n  import DocSteps from '@aziontech/webkit/doc-steps'\n  import Footer from '@aziontech/webkit/footer'\n  import FrameBox from '@aziontech/webkit/frame-box'\n  import GlobalHeader from '@aziontech/webkit/global-header'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import ItemList from '@aziontech/webkit/item-list'\n  import MenuGroup from '@aziontech/webkit/menu-group'\n  import MenuItem from '@aziontech/webkit/menu-item'\n  import MenuRoot from '@aziontech/webkit/menu-root'\n  import MenuSub from '@aziontech/webkit/menu-sub'\n  import MenuSubContent from '@aziontech/webkit/menu-sub-content'\n  import MenuSubTrigger from '@aziontech/webkit/menu-sub-trigger'\n  import NavigationMenu from '@aziontech/webkit/navigation-menu'\n  import ScrollArea from '@aziontech/webkit/scroll-area'\n  import SearchTrigger from '@aziontech/webkit/search-trigger'\n  import Sidebar from '@aziontech/webkit/sidebar'\n  import StatusIndicator from '@aziontech/webkit/status-indicator'\n  import ThemeSwitcher from '@aziontech/webkit/theme-switcher'\n  import { ref } from 'vue'\n\n  const sections = ['Reference', 'Guides', 'Dev tools']\n  const theme = ref('system')\n\n  const crumbs = [\n    { label: 'Fundamentals', href: '#' },\n    { label: 'Get started', href: '#' },\n    { label: 'First deploy' }\n  ]\n\n  const metaActions = [\n    { value: 'copy', label: 'Copy as Markdown', icon: 'pi pi-copy' },\n    { value: 'markdown', label: 'View as Markdown', icon: 'pi pi-eye' },\n    { value: 'agent-setup', label: 'Agent setup', icon: 'pi pi-microchip-ai', href: '#' }\n  ]\n\n  const outline = [\n    { id: 'before-you-start', text: 'Before you start', depth: 2 },\n    { id: 'deploy-a-template', text: 'Deploy a template via Console', depth: 2 },\n    { id: 'test-the-template', text: 'Test it', depth: 3 },\n    { id: 'deploy-with-cli', text: 'Deploy with Azion CLI', depth: 2 },\n    { id: 'next-steps', text: 'Next steps', depth: 2 },\n    { id: 'related-resources', text: 'Related resources', depth: 2 }\n  ]\n  const activeId = ref('before-you-start')\n\n  const railGroups = [\n    {\n      label: 'GitHub',\n      links: [\n        { label: 'Azion Docs', href: 'https://github.com/aziontech', icon: 'pi pi-github' },\n        { label: 'Contribute to this page', href: '#', icon: 'pi pi-pencil' }\n      ]\n    },\n    {\n      label: 'Community',\n      links: [\n        { label: 'Discord', href: 'https://discord.gg/azion', icon: 'pi pi-discord' },\n        { label: 'X', href: 'https://x.com/aziontech', icon: 'ai ai-x' }\n      ]\n    }\n  ]\n\n  const testTabs = [\n    {\n      label: 'Shell',\n      value: 'shell',\n      language: 'bash',\n      code: 'curl -I https://<your-azion-domain>\\n# HTTP/2 200'\n    }\n  ]\n  const installTabs = [\n    {\n      label: 'Shell',\n      value: 'shell',\n      language: 'bash',\n      code: 'curl -fsSL https://cli.azion.app/install.sh | bash'\n    }\n  ]\n  const deployTabs = [\n    { label: 'Shell', value: 'shell', language: 'bash', code: 'azion login\\nazion deploy' }\n  ]\n\n  const related = [\n    {\n      title: 'Applications',\n      icon: 'pi pi-th-large',\n      text: 'Route requests, cache responses and run code with rules.'\n    },\n    {\n      title: 'Functions',\n      icon: 'pi pi-code',\n      text: 'Serverless code that runs close to your users.'\n    },\n    { title: 'Azion CLI', icon: 'pi pi-desktop', text: 'Build and deploy from your terminal.' }\n  ]\n\n  const footerColumns = [\n    { title: 'Company', links: ['About us', 'Careers', 'Compliance', 'Privacy Policy'] },\n    { title: 'Resources', links: ['Blog', 'Learning', 'Marketplace', 'Success cases'] },\n    { title: 'Getting started', links: ['Start for free', 'Pricing', 'Contact'] },\n    { title: 'Developer', links: ['Documentation', 'API', 'Release notes'] }\n  ]\n</script>\n\n<template>\n  <div class=\"flex h-screen min-h-0 w-full flex-col bg-(--bg-canvas) text-(--text-default)\">\n    <div class=\"@container w-full\">\n      <GlobalHeader aria-label=\"Azion documentation\">\n        <GlobalHeader.Left>\n          <div class=\"flex min-w-0 items-center justify-start gap-(--spacing-xs)\">\n            <div class=\"shrink-0 lg:hidden\">\n              <IconButton\n                icon=\"pi pi-bars\"\n                kind=\"outlined\"\n                size=\"medium\"\n                aria-label=\"Open documentation navigation\"\n              />\n            </div>\n            <GlobalHeader.Brand>\n              <a\n                href=\"#\"\n                aria-label=\"Azion Docs home\"\n                class=\"inline-flex w-fit items-center gap-(--spacing-xs) rounded-(--shape-elements) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-canvas)\"\n              >\n                <Brand size=\"small\" />\n                <span\n                  class=\"rounded-(--shape-elements) border border-(--border-muted) px-(--spacing-xxs) text-overline-sm text-(--text-muted)\"\n                  >Docs</span\n                >\n              </a>\n            </GlobalHeader.Brand>\n            <div class=\"ms-(--spacing-xs) hidden shrink-0 lg:flex\">\n              <NavigationMenu aria-label=\"Documentation sections\">\n                <NavigationMenu.List>\n                  <NavigationMenu.Item\n                    v-for=\"section in sections\"\n                    :key=\"section\"\n                  >\n                    <NavigationMenu.Trigger href=\"#\">{{ section }}</NavigationMenu.Trigger>\n                  </NavigationMenu.Item>\n                </NavigationMenu.List>\n              </NavigationMenu>\n            </div>\n          </div>\n        </GlobalHeader.Left>\n        <GlobalHeader.Nav />\n        <GlobalHeader.Right>\n          <SearchTrigger\n            collapsible\n            label=\"Search docs\"\n          />\n          <IconButton\n            icon=\"pi pi-github\"\n            kind=\"outlined\"\n            size=\"medium\"\n            aria-label=\"Azion on GitHub\"\n            href=\"https://github.com/aziontech\"\n            target=\"_blank\"\n            class=\"shrink-0\"\n          />\n          <Button\n            label=\"Console\"\n            kind=\"secondary\"\n            size=\"medium\"\n            class=\"shrink-0\"\n            href=\"#\"\n          />\n        </GlobalHeader.Right>\n      </GlobalHeader>\n    </div>\n\n    <div class=\"relative flex min-h-0 flex-1\">\n      <aside class=\"hidden h-full w-(--container-2xs) shrink-0 lg:flex\">\n        <Sidebar\n          aria-label=\"Fundamentals\"\n          class=\"w-full\"\n        >\n          <template #footer>\n            <ThemeSwitcher\n              v-model=\"theme\"\n              aria-label=\"Theme\"\n            />\n          </template>\n          <MenuRoot role=\"presentation\">\n            <MenuGroup label=\"Fundamentals\">\n              <MenuItem\n                icon=\"\"\n                label=\"Overview\"\n                href=\"#\"\n              />\n              <MenuItem\n                icon=\"\"\n                label=\"How Azion works\"\n                href=\"#\"\n              />\n              <MenuSub default-open>\n                <MenuSubTrigger\n                  label=\"Get started\"\n                  kind=\"inline\"\n                />\n                <MenuSubContent>\n                  <MenuItem\n                    icon=\"\"\n                    label=\"Create an account\"\n                    href=\"#\"\n                  />\n                  <MenuItem\n                    icon=\"\"\n                    label=\"First deploy\"\n                    href=\"#\"\n                    selected\n                  />\n                  <MenuItem\n                    icon=\"\"\n                    label=\"Migrate to Azion\"\n                    href=\"#\"\n                  />\n                </MenuSubContent>\n              </MenuSub>\n              <MenuItem\n                icon=\"\"\n                label=\"Billing\"\n                href=\"#\"\n              />\n              <MenuItem\n                icon=\"\"\n                label=\"Security\"\n                href=\"#\"\n              />\n            </MenuGroup>\n          </MenuRoot>\n        </Sidebar>\n      </aside>\n\n      <main class=\"flex min-h-0 min-w-0 flex-1 flex-col\">\n        <ScrollArea class=\"w-full\">\n          <article\n            class=\"layout-column-content layout-boundary-inline flex flex-col gap-(--spacing-lg) pt-(--spacing-md) pb-(--spacing-xxl)\"\n          >\n            <DocPageHeader\n              title=\"First deploy in a few minutes\"\n              description=\"By the end of this tutorial, an application will be live on the Azion Web Platform, answering HTTP 200 on its own Azion domain.\"\n              :breadcrumb=\"crumbs\"\n              last-updated=\"2026-11-11\"\n              :meta-actions=\"metaActions\"\n            />\n            <DocProse>\n              <p>\n                Three complete paths get you there. Pick one; each ends with the same application\n                live on its domain.\n              </p>\n              <DocCardGroup :cols=\"3\">\n                <DocCard\n                  title=\"Deploy a template\"\n                  icon=\"pi pi-th-large\"\n                  href=\"#deploy-a-template\"\n                  >A ready-made project, live in a few clicks.</DocCard\n                >\n                <DocCard\n                  title=\"Import from GitHub\"\n                  icon=\"pi pi-github\"\n                  href=\"#\"\n                  >Connect a repository; every push deploys.</DocCard\n                >\n                <DocCard\n                  title=\"Deploy with CLI\"\n                  icon=\"pi pi-desktop\"\n                  href=\"#deploy-with-cli\"\n                  >Build and deploy from your terminal.</DocCard\n                >\n              </DocCardGroup>\n              <DocCallout kind=\"tip\">\n                New to Azion? Start with the template: it needs no local tooling.\n              </DocCallout>\n\n              <DocHeading\n                id=\"before-you-start\"\n                :level=\"2\"\n                >Before you start</DocHeading\n              >\n              <p>\n                You need an Azion account. The CLI path also needs a terminal with\n                <code>curl</code> and a project folder.\n              </p>\n\n              <DocHeading\n                id=\"deploy-a-template\"\n                :level=\"2\"\n                >Deploy a template via Console</DocHeading\n              >\n              <DocCallout kind=\"info\">\n                Templates create the workload, the application and the domain for you.\n              </DocCallout>\n              <DocSteps>\n                <DocStep title=\"Open Azion Console.\" />\n                <DocStep title=\"Select + Create on the home page.\" />\n                <DocStep title=\"Pick a template and fill in the fields it asks for.\" />\n                <DocStep title=\"Select Deploy and wait for the status to read Live.\" />\n              </DocSteps>\n              <DocHeading\n                id=\"test-the-template\"\n                :level=\"3\"\n                >Test it</DocHeading\n              >\n              <CodeBlock\n                :tabs=\"testTabs\"\n                default-value=\"shell\"\n              />\n\n              <DocHeading\n                id=\"deploy-with-cli\"\n                :level=\"2\"\n                >Deploy with Azion CLI</DocHeading\n              >\n              <DocPrompt title=\"AI Assistant\">\n                Install the Azion CLI, link this folder as an Azion project and deploy it. Show me\n                the domain when it is live.\n              </DocPrompt>\n              <DocSteps>\n                <DocStep title=\"Set up the Azion CLI\">\n                  <CodeBlock\n                    :tabs=\"installTabs\"\n                    default-value=\"shell\"\n                    :show-line-numbers=\"false\"\n                  />\n                </DocStep>\n                <DocStep title=\"Log in and deploy\">\n                  <CodeBlock\n                    :tabs=\"deployTabs\"\n                    default-value=\"shell\"\n                    :show-line-numbers=\"false\"\n                  />\n                </DocStep>\n              </DocSteps>\n\n              <DocHeading\n                id=\"next-steps\"\n                :level=\"2\"\n                >Next steps</DocHeading\n              >\n              <DocCardGroup :cols=\"3\">\n                <DocCard\n                  title=\"Go live\"\n                  icon=\"pi pi-globe\"\n                  href=\"#\"\n                  >Point your own domain at the workload.</DocCard\n                >\n                <DocCard\n                  title=\"Secure your application\"\n                  icon=\"pi pi-shield\"\n                  href=\"#\"\n                  >Add a firewall and WAF rules.</DocCard\n                >\n                <DocCard\n                  title=\"Observe your application\"\n                  icon=\"pi pi-chart-line\"\n                  href=\"#\"\n                  >Read metrics and events in real time.</DocCard\n                >\n              </DocCardGroup>\n\n              <DocHeading\n                id=\"related-resources\"\n                :level=\"2\"\n                >Related resources</DocHeading\n              >\n              <FrameBox class=\"w-full bg-(--bg-surface)\">\n                <ItemList>\n                  <DocItem\n                    v-for=\"item in related\"\n                    :key=\"item.title\"\n                    :title=\"item.title\"\n                    :icon=\"item.icon\"\n                    href=\"#\"\n                    >{{ item.text }}</DocItem\n                  >\n                </ItemList>\n              </FrameBox>\n            </DocProse>\n            <DocPagination\n              :previous=\"{ title: 'Create an account', href: '#' }\"\n              :next=\"{ title: 'Migrate to Azion', href: '#' }\"\n            />\n          </article>\n\n          <div class=\"w-full border-t border-(--border-default)\">\n            <Footer\n              kind=\"content\"\n              aria-label=\"Footer\"\n            >\n              <Footer.Column\n                v-for=\"column in footerColumns\"\n                :key=\"column.title\"\n                :title=\"column.title\"\n              >\n                <Footer.Link\n                  v-for=\"link in column.links\"\n                  :key=\"link\"\n                  href=\"#\"\n                  >{{ link }}</Footer.Link\n                >\n              </Footer.Column>\n              <template #status>\n                <StatusIndicator\n                  severity=\"success\"\n                  label=\"All systems operational\"\n                />\n              </template>\n            </Footer>\n          </div>\n        </ScrollArea>\n      </main>\n\n      <aside\n        class=\"hidden w-(--container-3xs) shrink-0 flex-col gap-(--spacing-lg) border-s border-(--border-default) px-(--spacing-md) pt-(--spacing-md) pb-(--spacing-lg) xl:flex\"\n      >\n        <DocOnThisPage\n          :items=\"outline\"\n          :active-id=\"activeId\"\n          :groups=\"railGroups\"\n          @select=\"(event, item) => (activeId = item.id)\"\n        />\n        <DocCta\n          title=\"Ready to build?\"\n          primary-label=\"Start for free\"\n          primary-href=\"#\"\n          secondary-label=\"See our plans\"\n          secondary-href=\"#\"\n        >\n          Deploy your first application in minutes.\n        </DocCta>\n      </aside>\n    </div>\n  </div>\n</template>",
 "variants": [
  {
   "name": "Reference",
   "summary": "A product reference page: an info callout under the masthead, two actions, the request path as a Diagram in a DocFrame, a JSON CodeBlock, a term list in DocProse and a two-column Next steps.",
   "sfc": "<script setup>\n  import Brand from '@aziontech/webkit/brand'\n  import Button from '@aziontech/webkit/button'\n  import CodeBlock from '@aziontech/webkit/code-block'\n  import Diagram from '@aziontech/webkit/diagram'\n  import DocCallout from '@aziontech/webkit/doc-callout'\n  import DocCard from '@aziontech/webkit/doc-card'\n  import DocCardGroup from '@aziontech/webkit/doc-card-group'\n  import DocCta from '@aziontech/webkit/doc-cta'\n  import DocFrame from '@aziontech/webkit/doc-frame'\n  import DocHeading from '@aziontech/webkit/doc-heading'\n  import DocOnThisPage from '@aziontech/webkit/doc-on-this-page'\n  import DocPageHeader from '@aziontech/webkit/doc-page-header'\n  import DocPagination from '@aziontech/webkit/doc-pagination'\n  import DocProse from '@aziontech/webkit/doc-prose'\n  import Footer from '@aziontech/webkit/footer'\n  import GlobalHeader from '@aziontech/webkit/global-header'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import MenuGroup from '@aziontech/webkit/menu-group'\n  import MenuItem from '@aziontech/webkit/menu-item'\n  import MenuRoot from '@aziontech/webkit/menu-root'\n  import NavigationMenu from '@aziontech/webkit/navigation-menu'\n  import ScrollArea from '@aziontech/webkit/scroll-area'\n  import SearchTrigger from '@aziontech/webkit/search-trigger'\n  import Sidebar from '@aziontech/webkit/sidebar'\n  import StatusIndicator from '@aziontech/webkit/status-indicator'\n  import ThemeSwitcher from '@aziontech/webkit/theme-switcher'\n  import { ref } from 'vue'\n\n  const sections = ['Reference', 'Guides', 'Dev tools']\n  const theme = ref('system')\n\n  const crumbs = [{ label: 'Applications', href: '#' }, { label: 'Overview' }]\n\n  const metaActions = [\n    { value: 'copy', label: 'Copy as Markdown', icon: 'pi pi-copy' },\n    { value: 'markdown', label: 'View as Markdown', icon: 'pi pi-eye' },\n    { value: 'agent-setup', label: 'Agent setup', icon: 'pi pi-microchip-ai', href: '#' }\n  ]\n\n  const outline = [\n    { id: 'request-path', text: 'Request path', depth: 2 },\n    { id: 'rule-structure', text: 'Rule structure', depth: 2 },\n    { id: 'scope-and-limits', text: 'Scope and limits', depth: 2 },\n    { id: 'next-steps', text: 'Next steps', depth: 2 }\n  ]\n  const activeId = ref('request-path')\n\n  const railGroups = [\n    {\n      label: 'GitHub',\n      links: [\n        { label: 'Azion Docs', href: 'https://github.com/aziontech', icon: 'pi pi-github' },\n        { label: 'Contribute to this page', href: '#', icon: 'pi pi-pencil' }\n      ]\n    },\n    {\n      label: 'Community',\n      links: [\n        { label: 'Discord', href: 'https://discord.gg/azion', icon: 'pi pi-discord' },\n        { label: 'X', href: 'https://x.com/aziontech', icon: 'ai ai-x' }\n      ]\n    }\n  ]\n\n  const ruleTabs = [\n    {\n      label: 'JSON',\n      value: 'json',\n      language: 'json',\n      code: '{\\n  \"name\": \"Cache images\",\\n  \"active\": true,\\n  \"criteria\": [[{ \"variable\": \"${uri}\", \"operator\": \"starts_with\", \"argument\": \"/images\" }]],\\n  \"behaviors\": [{ \"type\": \"set_cache_policy\", \"attributes\": { \"value\": 1020 } }]\\n}'\n    }\n  ]\n\n  const scope = [\n    { term: 'Phases', text: 'Request rules run before the origin, response rules after it.' },\n    { term: 'Origins', text: 'A connector names where a request goes when the cache misses.' },\n    { term: 'Functions', text: 'An instance runs your code on the request or the response.' },\n    { term: 'Limits', text: 'Up to 1,000 rules per application, evaluated in order.' }\n  ]\n\n  const footerColumns = [\n    { title: 'Company', links: ['About us', 'Careers', 'Compliance', 'Privacy Policy'] },\n    { title: 'Resources', links: ['Blog', 'Learning', 'Marketplace', 'Success cases'] },\n    { title: 'Getting started', links: ['Start for free', 'Pricing', 'Contact'] },\n    { title: 'Developer', links: ['Documentation', 'API', 'Release notes'] }\n  ]\n</script>\n\n<template>\n  <div class=\"flex h-screen min-h-0 w-full flex-col bg-(--bg-canvas) text-(--text-default)\">\n    <div class=\"@container w-full\">\n      <GlobalHeader aria-label=\"Azion documentation\">\n        <GlobalHeader.Left>\n          <div class=\"flex min-w-0 items-center justify-start gap-(--spacing-xs)\">\n            <div class=\"shrink-0 lg:hidden\">\n              <IconButton\n                icon=\"pi pi-bars\"\n                kind=\"outlined\"\n                size=\"medium\"\n                aria-label=\"Open documentation navigation\"\n              />\n            </div>\n            <GlobalHeader.Brand>\n              <a\n                href=\"#\"\n                aria-label=\"Azion Docs home\"\n                class=\"inline-flex w-fit items-center gap-(--spacing-xs) rounded-(--shape-elements) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-canvas)\"\n              >\n                <Brand size=\"small\" />\n                <span\n                  class=\"rounded-(--shape-elements) border border-(--border-muted) px-(--spacing-xxs) text-overline-sm text-(--text-muted)\"\n                  >Docs</span\n                >\n              </a>\n            </GlobalHeader.Brand>\n            <div class=\"ms-(--spacing-xs) hidden shrink-0 lg:flex\">\n              <NavigationMenu aria-label=\"Documentation sections\">\n                <NavigationMenu.List>\n                  <NavigationMenu.Item\n                    v-for=\"section in sections\"\n                    :key=\"section\"\n                  >\n                    <NavigationMenu.Trigger href=\"#\">{{ section }}</NavigationMenu.Trigger>\n                  </NavigationMenu.Item>\n                </NavigationMenu.List>\n              </NavigationMenu>\n            </div>\n          </div>\n        </GlobalHeader.Left>\n        <GlobalHeader.Nav />\n        <GlobalHeader.Right>\n          <SearchTrigger\n            collapsible\n            label=\"Search docs\"\n          />\n          <IconButton\n            icon=\"pi pi-github\"\n            kind=\"outlined\"\n            size=\"medium\"\n            aria-label=\"Azion on GitHub\"\n            href=\"https://github.com/aziontech\"\n            target=\"_blank\"\n            class=\"shrink-0\"\n          />\n          <Button\n            label=\"Console\"\n            kind=\"secondary\"\n            size=\"medium\"\n            class=\"shrink-0\"\n            href=\"#\"\n          />\n        </GlobalHeader.Right>\n      </GlobalHeader>\n    </div>\n\n    <div class=\"relative flex min-h-0 flex-1\">\n      <aside class=\"hidden h-full w-(--container-2xs) shrink-0 lg:flex\">\n        <Sidebar\n          aria-label=\"Applications\"\n          class=\"w-full\"\n        >\n          <template #footer>\n            <ThemeSwitcher\n              v-model=\"theme\"\n              aria-label=\"Theme\"\n            />\n          </template>\n          <MenuRoot role=\"presentation\">\n            <MenuGroup label=\"Applications\">\n              <MenuItem\n                icon=\"\"\n                label=\"Overview\"\n                href=\"#\"\n                selected\n              />\n              <MenuItem\n                icon=\"\"\n                v-for=\"page in ['Quickstart', 'How it works', 'Cache', 'Limits', 'Troubleshooting']\"\n                :key=\"page\"\n                :label=\"page\"\n                href=\"#\"\n              />\n            </MenuGroup>\n          </MenuRoot>\n        </Sidebar>\n      </aside>\n\n      <main class=\"flex min-h-0 min-w-0 flex-1 flex-col\">\n        <ScrollArea class=\"w-full\">\n          <article\n            class=\"layout-column-content layout-boundary-inline flex flex-col gap-(--spacing-lg) pt-(--spacing-md) pb-(--spacing-xxl)\"\n          >\n            <DocPageHeader\n              title=\"Applications\"\n              description=\"Route requests to your origins, cache responses, and run code with the rules of an Application.\"\n              :breadcrumb=\"crumbs\"\n              last-updated=\"2026-11-11\"\n              :meta-actions=\"metaActions\"\n            />\n            <DocProse>\n              <DocCallout kind=\"info\">\n                Rolling out: this page describes API v4. Accounts still on v3 keep the previous\n                reference.\n              </DocCallout>\n              <p>\n                An application holds the rules a <a href=\"#\">workload</a> applies to every request:\n                where it goes, what is cached and which <a href=\"#\">function</a> runs.\n              </p>\n              <div\n                data-doc-chrome\n                class=\"flex flex-wrap gap-(--spacing-sm)\"\n              >\n                <Button\n                  label=\"Quickstart\"\n                  kind=\"primary\"\n                  size=\"medium\"\n                  href=\"#\"\n                />\n                <Button\n                  label=\"Applications reference\"\n                  kind=\"secondary\"\n                  size=\"medium\"\n                  href=\"#\"\n                />\n              </div>\n\n              <DocHeading\n                id=\"request-path\"\n                :level=\"2\"\n                >Request path</DocHeading\n              >\n              <DocFrame caption=\"A request through a workload, its firewall and its application\">\n                <Diagram name=\"applications\" />\n              </DocFrame>\n\n              <DocHeading\n                id=\"rule-structure\"\n                :level=\"2\"\n                >Rule structure</DocHeading\n              >\n              <p>\n                Create a rule with\n                <code>POST /v4/workspace/applications/&lt;id&gt;/request_rules</code>.\n              </p>\n              <CodeBlock\n                :tabs=\"ruleTabs\"\n                default-value=\"json\"\n              />\n\n              <DocHeading\n                id=\"scope-and-limits\"\n                :level=\"2\"\n                >Scope and limits</DocHeading\n              >\n              <ul>\n                <li\n                  v-for=\"item in scope\"\n                  :key=\"item.term\"\n                >\n                  <strong>{{ item.term }}.</strong> {{ item.text }}\n                </li>\n              </ul>\n\n              <DocHeading\n                id=\"next-steps\"\n                :level=\"2\"\n                >Next steps</DocHeading\n              >\n              <DocCardGroup :cols=\"2\">\n                <DocCard\n                  title=\"Quickstart\"\n                  icon=\"pi pi-bolt\"\n                  href=\"#\"\n                  >Create an application and bind it to a workload.</DocCard\n                >\n                <DocCard\n                  title=\"Rules Engine\"\n                  icon=\"pi pi-sliders-h\"\n                  href=\"#\"\n                  >Criteria and behaviors, phase by phase.</DocCard\n                >\n              </DocCardGroup>\n            </DocProse>\n            <DocPagination :next=\"{ title: 'Quickstart', href: '#' }\" />\n          </article>\n\n          <div class=\"w-full border-t border-(--border-default)\">\n            <Footer\n              kind=\"content\"\n              aria-label=\"Footer\"\n            >\n              <Footer.Column\n                v-for=\"column in footerColumns\"\n                :key=\"column.title\"\n                :title=\"column.title\"\n              >\n                <Footer.Link\n                  v-for=\"link in column.links\"\n                  :key=\"link\"\n                  href=\"#\"\n                  >{{ link }}</Footer.Link\n                >\n              </Footer.Column>\n              <template #status>\n                <StatusIndicator\n                  severity=\"success\"\n                  label=\"All systems operational\"\n                />\n              </template>\n            </Footer>\n          </div>\n        </ScrollArea>\n      </main>\n\n      <aside\n        class=\"hidden w-(--container-3xs) shrink-0 flex-col gap-(--spacing-lg) border-s border-(--border-default) px-(--spacing-md) pt-(--spacing-md) pb-(--spacing-lg) xl:flex\"\n      >\n        <DocOnThisPage\n          :items=\"outline\"\n          :active-id=\"activeId\"\n          :groups=\"railGroups\"\n          @select=\"(event, item) => (activeId = item.id)\"\n        />\n        <DocCta\n          title=\"Ready to build?\"\n          primary-label=\"Start for free\"\n          primary-href=\"#\"\n          secondary-label=\"See our plans\"\n          secondary-href=\"#\"\n        >\n          Deploy your first application in minutes.\n        </DocCta>\n      </aside>\n    </div>\n  </div>\n</template>"
