   "sfc": "<script setup lang=\"ts\">\n  import Avatar from '@aziontech/webkit/avatar'\n  import Brand from '@aziontech/webkit/brand'\n  import DropdownMenu from '@aziontech/webkit/dropdown-menu'\n  import GlobalHeader from '@aziontech/webkit/global-header'\n\n  const account = { name: 'Amy Chen', email: 'amy.chen@example.com' }\n</script>\n\n<template>\n  <div class=\"w-full bg-(--bg-canvas)\">\n    <GlobalHeader aria-label=\"Console\">\n      <GlobalHeader.Left>\n        <GlobalHeader.Brand>\n          <a\n            href=\"/home\"\n            aria-label=\"Azion home\"\n            class=\"inline-flex shrink-0 items-center self-center rounded-(--shape-elements) transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-surface) motion-reduce:transition-none\"\n          >\n            <Brand\n              kind=\"default\"\n              size=\"small\"\n            />\n          </a>\n        </GlobalHeader.Brand>\n      </GlobalHeader.Left>\n      <GlobalHeader.Middle />\n      <GlobalHeader.Right>\n        <DropdownMenu placement=\"bottom-end\">\n          <DropdownMenu.Trigger>\n            <button\n              type=\"button\"\n              aria-label=\"Account menu\"\n              class=\"rounded-(--shape-button) transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-surface) motion-reduce:transition-none\"\n            >\n              <Avatar\n                :label=\"account.name\"\n                size=\"medium\"\n                kind=\"square\"\n              />\n            </button>\n          </DropdownMenu.Trigger>\n          <DropdownMenu.Group>\n            <template #top>\n              <div class=\"flex min-w-0 flex-col\">\n                <span class=\"truncate text-label-md text-(--text-default)\">{{ account.name }}</span>\n                <span class=\"truncate text-body-xs text-(--text-muted)\">{{ account.email }}</span>\n              </div>\n            </template>\n            <DropdownMenu.Option\n              value=\"settings\"\n              label=\"Account settings\"\n            >\n              <template #right>\n                <i\n                  class=\"pi pi-cog\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n          </DropdownMenu.Group>\n          <DropdownMenu.Group>\n            <DropdownMenu.Option\n              value=\"docs\"\n              label=\"Docs\"\n            >\n              <template #right>\n                <i\n                  class=\"pi pi-book\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n            <DropdownMenu.Option\n              value=\"logout\"\n              label=\"Log out\"\n            >\n              <template #right>\n                <i\n                  class=\"pi pi-sign-out\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n          </DropdownMenu.Group>\n        </DropdownMenu>\n      </GlobalHeader.Right>\n    </GlobalHeader>\n  </div>\n</template>"
