           <i\n                  class=\"pi pi-sign-out\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n          </DropdownMenu.Group>\n        </DropdownMenu>\n      </GlobalHeader.Right>\n    </GlobalHeader>\n    <Command v-model:open=\"searchOpen\">\n      <Command.Input placeholder=\"Search\" />\n      <Command.List>\n        <Command.Empty>No page matches your search.</Command.Empty>\n        <Command.Group heading=\"Pages\">\n          <Command.Item\n            v-for=\"page in searchPages\"\n            :key=\"page\"\n            :value=\"page\"\n            >{{ page }}</Command.Item\n          >\n        </Command.Group>\n      </Command.List>\n    </Command>\n  </div>\n</template>"
