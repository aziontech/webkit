       </DropdownMenu.Trigger>\n          <DropdownMenu.Group>\n            <template #top>\n              <div class=\"flex min-w-0 flex-col\">\n                <span class=\"truncate text-label-md text-(--text-default)\">{{ account.name }}</span>\n                <span class=\"truncate text-body-xs text-(--text-muted)\">{{ account.email }}</span>\n              </div>\n            </template>\n            <DropdownMenu.Option\n              value=\"settings\"\n              label=\"Account settings\"\n            >\n              <template #right>\n                <i\n                  class=\"pi pi-cog\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n            <DropdownMenu.Option\n              value=\"personal-tokens\"\n              label=\"Personal tokens\"\n            >\n              <template #right>\n                <i\n                  class=\"pi pi-key\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n          </DropdownMenu.Group>\n          <DropdownMenu.Group>\n            <DropdownMenu.Option\n              value=\"docs\"\n              label=\"Docs\"\n            >\n              <template #right>\n                <i\n                  class=\"pi pi-book\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n            <DropdownMenu.Option\n              value=\"logout\"\n              label=\"Log out\"\n            >\n              <template #right>\n                <i\n                  class=\"pi pi-sign-out\"\n                  aria-hidden=\"true\"\n                />\n              </template>\n            </DropdownMenu.Option>\n          </DropdownMenu.Group>\n        </DropdownMenu>\n      </GlobalHeader.Right>\n    </GlobalHeader>\n    <Command v-model:open=\"searchOpen\">\n      <Command.Input placeholder=\"Search\" />\n      <Command.List>\n        <Command.Empty>No page matches your search.</Command.Empty>\n        <Command.Group heading=\"Pages\">\n          <Command.Item\n            v-for=\"page in searchPages\"\n            :key=\"page\"\n            :value=\"page\"\n            >{{ page }}</Command.Item\n          >\n        </Command.Group>\n      </Command.List>\n    </Command>\n  </div>\n</template>",
