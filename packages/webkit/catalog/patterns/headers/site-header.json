{
 "sfc": "<script setup>\n  import Brand from '@aziontech/webkit/brand'\n  import Button from '@aziontech/webkit/button'\n  import GlobalHeader from '@aziontech/webkit/global-header'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import NavigationMenu from '@aziontech/webkit/navigation-menu'\n\n  const links = ['Solutions', 'Products', 'Developer', 'Resources', 'Pricing']\n</script>\n\n<template>\n  <div class=\"w-full bg-(--bg-canvas)\">\n    <div class=\"sticky top-0 z-40\">\n      <GlobalHeader\n        kind=\"site\"\n        aria-label=\"Azion\"\n      >\n        <GlobalHeader.Left>\n          <div class=\"flex min-w-0 items-center justify-start gap-(--spacing-xs)\">\n            <div class=\"shrink-0 xl:hidden\">\n              <IconButton\n                icon=\"pi pi-bars\"\n                kind=\"outlined\"\n                size=\"medium\"\n                aria-label=\"Open navigation\"\n              />\n            </div>\n            <GlobalHeader.Brand>\n              <a\n                href=\"#\"\n                aria-label=\"Azion home\"\n                class=\"inline-flex w-fit items-center rounded-(--shape-elements) transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-canvas)\"\n              >\n                <Brand\n                  kind=\"default\"\n                  size=\"small\"\n                />\n              </a>\n            </GlobalHeader.Brand>\n          </div>\n        </GlobalHeader.Left>\n\n        <GlobalHeader.Middle>\n          <div class=\"hidden w-full min-w-0 items-center justify-start xl:flex\">\n            <div class=\"min-w-0\">\n              <NavigationMenu\n                aria-label=\"Azion\"\n                class=\"w-full\"\n              >\n                <NavigationMenu.List>\n                  <NavigationMenu.Item\n                    v-for=\"link in links\"\n                    :key=\"link\"\n                  >\n                    <NavigationMenu.Trigger href=\"#\">{{ link }}</NavigationMenu.Trigger>\n                  </NavigationMenu.Item>\n                </NavigationMenu.List>\n                <NavigationMenu.Portal>\n                  <NavigationMenu.Positioner\n                    side=\"bottom\"\n                    align=\"start\"\n                    :side-offset=\"12\"\n                  >\n                    <NavigationMenu.Popup kind=\"contrast\">\n                      <NavigationMenu.Arrow />\n                      <NavigationMenu.Viewport />\n                    </NavigationMenu.Popup>\n                  </NavigationMenu.Positioner>\n                </NavigationMenu.Portal>\n              </NavigationMenu>\n            </div>\n          </div>\n        </GlobalHeader.Middle>\n\n        <GlobalHeader.Right>\n          <div class=\"hidden xl:flex\">\n            <Button\n              label=\"Contact\"\n              kind=\"transparent\"\n              size=\"medium\"\n              href=\"#\"\n            />\n          </div>\n          <Button\n            label=\"Login\"\n            kind=\"secondary\"\n            size=\"medium\"\n            href=\"#\"\n          />\n          <Button\n            label=\"Start for free\"\n            kind=\"primary\"\n            size=\"medium\"\n            class=\"shrink-0\"\n            href=\"#\"\n          />\n          <IconButton\n            icon=\"pi pi-search\"\n            kind=\"outlined\"\n            size=\"medium\"\n            aria-label=\"Search\"\n            class=\"shrink-0\"\n          />\n        </GlobalHeader.Right>\n      </GlobalHeader>\n    </div>\n  </div>\n</template>",
