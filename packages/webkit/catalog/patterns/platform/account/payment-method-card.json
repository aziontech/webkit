n          />\n        </div>\n        <template v-else>\n          <fieldset class=\"m-0 flex min-w-0 flex-col gap-(--spacing-lg) border-0 p-0\">\n            <legend class=\"sr-only\">Payment Method</legend>\n            <Field>\n              <Field.Label>Cardholder's full name</Field.Label>\n              <Input\n                v-model=\"cardForm.holder\"\n                name=\"cardholderName\"\n                size=\"large\"\n                placeholder=\"Jane A. Doe\"\n                autocomplete=\"cc-name\"\n              />\n            </Field>\n            <Field>\n              <Field.Label>Country/Region</Field.Label>\n              <Select\n                v-model=\"cardForm.country\"\n                size=\"large\"\n              >\n                <Select.Trigger />\n                <Select.Content>\n                  <Select.Option\n                    v-for=\"option in countryOptions\"\n                    :key=\"String(option.value)\"\n                    :value=\"option.value\"\n                    :disabled=\"option.disabled\"\n                  >\n                    {{ option.label }}\n                  </Select.Option>\n                </Select.Content>\n              </Select>\n            </Field>\n            <Field>\n              <Field.Label>Credit card number</Field.Label>\n              <Input\n                v-model=\"cardForm.number\"\n                name=\"cardNumber\"\n                size=\"large\"\n                placeholder=\"1234 5678 9012 3456\"\n                autocomplete=\"cc-number\"\n                inputmode=\"numeric\"\n              />\n            </Field>\n            <div class=\"grid grid-cols-1 gap-(--spacing-lg) sm:grid-cols-2\">\n              <Field>\n                <Field.Label>Expiration Date (MM/YY)</Field.Label>\n                <Input\n                  v-model=\"cardForm.expiry\"\n                  name=\"cardExpiry\"\n                  size=\"large\"\n                  placeholder=\"08 / 26\"\n                  autocomplete=\"cc-exp\"\n                  inputmode=\"numeric\"\n                />\n              </Field>\n              <Field>\n                <Field.Label>Security Code (CVC/CVV)</Field.Label>\n                <Input\n                  v-model=\"cardForm.code\"\n                  name=\"cardSecurityCode\"\n                  size=\"large\"\n                  placeholder=\"999\"\n                  autocomplete=\"cc-csc\"\n                  inputmode=\"numeric\"\n                />\n              </Field>\n            </div>\n            <Alert\n              severity=\"info\"\n              size=\"small\"\n              label=\"Sensitive data is handled by a PCI-compliant payment partner.\"\n            />\n          </fieldset>\n          <div class=\"flex flex-col gap-(--spacing-sm) sm:flex-row sm:justify-end\">\n            <div class=\"w-full sm:w-fit\">\n              <Button\n                class=\"w-full\"\n                label=\"Cancel\"\n                kind=\"outlined\"\n                size=\"medium\"\n                @click=\"editingCard = false\"\n              />\n            </div>\n            <div class=\"w-full sm:w-fit\">\n              <Button\n                class=\"w-full\"\n                label=\"Update\"\n                kind=\"primary\"\n                size=\"medium\"\n                @click=\"updateCard\"\n              />\n            </div>\n          </div>\n        </template>\n      </div>\n    </template>\n  </Card>\n</template>",
