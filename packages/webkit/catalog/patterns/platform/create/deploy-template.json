{
 "sfc": "<script setup>\n  import Avatar from '@aziontech/webkit/avatar'\n  import Brand from '@aziontech/webkit/brand'\n  import Breadcrumb from '@aziontech/webkit/breadcrumb'\n  import Button from '@aziontech/webkit/button'\n  import Card from '@aziontech/webkit/card'\n  import EmptyState from '@aziontech/webkit/empty-state'\n  import GlobalHeader from '@aziontech/webkit/global-header'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Link from '@aziontech/webkit/link'\n\n  const breadcrumb = [\n    { label: 'Start from a Template' },\n    { label: 'Nuxt E-commerce', current: true }\n  ]\n</script>\n\n<template>\n  <div class=\"flex h-dvh flex-col overflow-hidden bg-(--bg-canvas)\">\n    <GlobalHeader aria-label=\"Console\">\n      <GlobalHeader.Left>\n        <IconButton\n          icon=\"pi pi-chevron-left\"\n          aria-label=\"Back to Creation Center\"\n          kind=\"outlined\"\n          size=\"small\"\n        />\n        <GlobalHeader.Brand>\n          <a\n            href=\"/home\"\n            aria-label=\"Azion home\"\n            class=\"inline-flex shrink-0 items-center self-center rounded-(--shape-elements) transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-surface) motion-reduce:transition-none\"\n          >\n            <Brand\n              kind=\"default\"\n              size=\"small\"\n            />\n          </a>\n        </GlobalHeader.Brand>\n        <Breadcrumb :items=\"breadcrumb\" />\n      </GlobalHeader.Left>\n      <GlobalHeader.Middle />\n      <GlobalHeader.Right>\n        <button\n          type=\"button\"\n          aria-label=\"Account settings\"\n          class=\"rounded-full transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-surface) motion-reduce:transition-none\"\n        >\n          <Avatar\n            label=\"name@example.com\"\n            size=\"medium\"\n            kind=\"square\"\n          />\n        </button>\n      </GlobalHeader.Right>\n    </GlobalHeader>\n\n    <main\n      class=\"animate-page-enter motion-reduce:animate-none relative min-w-0 flex-1 overflow-auto\"\n    >\n      <div\n        class=\"layout-column-focused relative flex min-h-full flex-col items-center gap-(--spacing-xl) px-(--spacing-md) py-(--spacing-xxl)\"\n      >\n        <div\n          class=\"flex w-full items-start gap-(--spacing-md) overflow-hidden rounded-(--shape-card) border border-(--border-default) bg-(--bg-surface) p-(--spacing-md) no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-1 focus-visible:ring-offset-(--bg-canvas) max-w-none! motion-reduce:transition-none! motion-reduce:transform-none!\"\n        >\n          <span\n            class=\"flex size-10 shrink-0 items-center justify-center rounded-(--shape-elements) border border-(--border-muted) bg-(--bg-surface-raised)\"\n          >\n            <i\n              class=\"ai-cor ai-nuxt text-body-lg leading-none text-(--text-default)\"\n              aria-hidden=\"true\"\n            />\n          </span>\n\n          <div class=\"flex min-w-0 flex-1 flex-col gap-(--spacing-md)\">\n            <div class=\"flex w-full min-w-0 flex-col overflow-hidden\">\n              <span class=\"flex items-center gap-(--spacing-xs)\">\n                <span class=\"truncate text-heading-xxs text-(--text-default)\">Nuxt E-commerce</span>\n              </span>\n              <span class=\"text-body-xs text-(--text-muted)\">\n                Launch a Nuxt e-commerce or content app in a few steps.\n              </span>\n            </div>\n\n            <div class=\"flex w-full flex-col gap-(--spacing-xxs)\">\n              <span class=\"truncate text-body-xxs text-(--text-muted)\">Cloning from Github</span>\n              <div class=\"flex items-center gap-(--spacing-md)\">\n                <span\n                  class=\"flex h-5 items-center gap-(--spacing-xxs) text-label-sm text-(--text-default)\"\n                >\n                  <i\n                    class=\"ai ai-github text-[length:inherit] leading-none\"\n                    aria-hidden=\"true\"\n                  />\n                  acme\n                </span>\n                <span\n                  class=\"flex h-5 items-center gap-(--spacing-xxs) text-label-sm text-(--text-muted)\"\n                >\n                  <i\n                    class=\"pi pi-folder text-[length:inherit] leading-none\"\n                    aria-hidden=\"true\"\n                  />\n                  templates/nuxt-ecommerce\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div\n          data-phase=\"connect\"\n          class=\"flex w-full flex-col items-center gap-(--spacing-xl) data-[phase=success]:my-auto motion-reduce:transition-none! motion-reduce:transform-none!\"\n        >\n          <Card class=\"w-full\">\n            <template #content>\n              <div\n                class=\"flex rounded-(--shape-card) border border-dashed border-(--border-default) bg-(--bg-surface-raised) lg:min-h-0 lg:flex-1\"\n              >\n                <EmptyState\n                  size=\"medium\"\n                  title=\"Connect a Git provider\"\n                  description=\"Nuxt E-commerce is cloned into a repository in your account, then deployed from it on every push.\"\n                  class=\"w-full\"\n                >\n                  <template #icon>\n                    <span class=\"relative flex size-10 items-center justify-center\">\n                      <span\n                        aria-hidden=\"true\"\n                        class=\"absolute left-1/2 top-1/2 size-14 -translate-x-1/2 -translate-y-1/2 rounded-[var(--radius-xl,12px)] border border-(--border-strong) bg-(--bg-canvas) opacity-5\"\n                      />\n                      <span\n                        aria-hidden=\"true\"\n                        class=\"absolute left-1/2 top-1/2 size-12 -translate-x-1/2 -translate-y-1/2 rounded-(--shape-card) border border-(--border-strong) bg-(--bg-canvas) opacity-10\"\n                      />\n                      <span\n                        class=\"relative flex size-10 items-center justify-center rounded-(--shape-elements) border border-(--border-default) bg-(--bg-surface)\"\n                      >\n                        <i\n                          class=\"ai ai-github text-body-md leading-none text-(--text-default)\"\n                          aria-hidden=\"true\"\n                        />\n                      </span>\n                    </span>\n                  </template>\n                  <template #actions>\n                    <Button\n                      label=\"Continue with GitHub\"\n                      icon=\"ai ai-github\"\n                      kind=\"secondary\"\n                      size=\"large\"\n                    />\n                    <Button\n                      label=\"Continue without Git\"\n                      kind=\"transparent\"\n                      size=\"large\"\n                    />\n                    <Link\n                      label=\"Manage connected providers\"\n                      href=\"#\"\n                      size=\"large\"\n                    />\n                  </template>\n                </EmptyState>\n              </div>\n            </template>\n          </Card>\n\n          <Button\n            label=\"Browse Templates\"\n            kind=\"outlined\"\n            size=\"medium\"\n          />\n        </div>\n      </div>\n    </main>\n  </div>\n</template>",
 "variants": [
  {
   "name": "Form",
   "summary": "GitHub connected: the gab-lisboa scope and the nuxt-ecommerce repository name, public by default, over the three store settings of the Nuxt E-commerce template; Deploy waits for the access token.",
   "sfc": "<script setup>\n  import Avatar from '@aziontech/webkit/avatar'\n  import Brand from '@aziontech/webkit/brand'\n  import Breadcrumb from '@aziontech/webkit/breadcrumb'\n  import Button from '@aziontech/webkit/button'\n  import Card from '@aziontech/webkit/card'\n  import Field from '@aziontech/webkit/field'\n  import GlobalHeader from '@aziontech/webkit/global-header'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Input from '@aziontech/webkit/input'\n  import InputGroupAddon from '@aziontech/webkit/input-group-addon'\n  import InputGroupRoot from '@aziontech/webkit/input-group-root'\n  import Label from '@aziontech/webkit/label'\n  import Select from '@aziontech/webkit/select'\n  import Switch from '@aziontech/webkit/switch'\n  import Tooltip from '@aziontech/webkit/tooltip'\n  import { computed, reactive, ref } from 'vue'\n\n  const breadcrumb = [\n    { label: 'Start from a Template' },\n    { label: 'Nuxt E-commerce', current: true }\n  ]\n\n  const scopes = [\n    { label: 'gab-lisboa', value: 'gab-lisboa' },\n    { label: 'acme', value: 'acme' },\n    { label: 'acme-templates', value: 'acme-templates' }\n  ]\n\n  const settings = [\n    {\n      name: 'storeAccessToken',\n      label: 'Store Access Token',\n      placeholder: 'Access Token',\n      description: 'You can find this token in the API credentials of your store.',\n      required: true\n    },\n    {\n      name: 'storeRevalidationSecret',\n      label: 'Store revalidation secret',\n      placeholder: 'Revalidation secret',\n      description: 'You can find this secret in the API credentials of your store.',\n      required: false\n    },\n    {\n      name: 'storeDomain',\n      label: 'Store Domain',\n      placeholder: 'https://shop.example.com',\n      description: 'The domain your store answers on',\n      required: false\n    }\n  ]\n\n  const scope = ref('gab-lisboa')\n  const repoName = ref('nuxt-ecommerce')\n  const isPublic = ref(true)\n  const values = reactive(Object.fromEntries(settings.map((field) => [field.name, ''])))\n\n  const canDeploy = computed(\n    () =>\n      Boolean(repoName.value.trim()) &&\n      settings.filter((field) => field.required).every((field) => (values[field.name] || '').trim())\n  )\n</script>\n\n<template>\n  <div class=\"flex h-dvh flex-col overflow-hidden bg-(--bg-canvas)\">\n    <GlobalHeader aria-label=\"Console\">\n      <GlobalHeader.Left>\n        <IconButton\n          icon=\"pi pi-chevron-left\"\n          aria-label=\"Back to Creation Center\"\n          kind=\"outlined\"\n          size=\"small\"\n        />\n        <GlobalHeader.Brand>\n          <a\n            href=\"/home\"\n            aria-label=\"Azion home\"\n            class=\"inline-flex shrink-0 items-center self-center rounded-(--shape-elements) transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-surface) motion-reduce:transition-none\"\n          >\n            <Brand\n              kind=\"default\"\n              size=\"small\"\n            />\n          </a>\n        </GlobalHeader.Brand>\n        <Breadcrumb :items=\"breadcrumb\" />\n      </GlobalHeader.Left>\n      <GlobalHeader.Middle />\n      <GlobalHeader.Right>\n        <button\n          type=\"button\"\n          aria-label=\"Account settings\"\n          class=\"rounded-full transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-2 focus-visible:ring-offset-(--bg-surface) motion-reduce:transition-none\"\n        >\n          <Avatar\n            label=\"name@example.com\"\n            size=\"medium\"\n            kind=\"square\"\n          />\n        </button>\n      </GlobalHeader.Right>\n    </GlobalHeader>\n\n    <main\n      class=\"animate-page-enter motion-reduce:animate-none relative min-w-0 flex-1 overflow-auto\"\n    >\n      <div\n        class=\"layout-column-focused relative flex min-h-full flex-col items-center gap-(--spacing-xl) px-(--spacing-md) py-(--spacing-xxl)\"\n      >\n        <div\n          class=\"flex w-full items-start gap-(--spacing-md) overflow-hidden rounded-(--shape-card) border border-(--border-default) bg-(--bg-surface) p-(--spacing-md) no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) focus-visible:ring-offset-1 focus-visible:ring-offset-(--bg-canvas) max-w-none! motion-reduce:transition-none! motion-reduce:transform-none!\"\n        >\n          <span\n            class=\"flex size-10 shrink-0 items-center justify-center rounded-(--shape-elements) border border-(--border-muted) bg-(--bg-surface-raised)\"\n          >\n            <i\n              class=\"ai-cor ai-nuxt text-body-lg leading-none text-(--text-default)\"\n              aria-hidden=\"true\"\n            />\n          </span>\n\n          <div class=\"flex min-w-0 flex-1 flex-col gap-(--spacing-md)\">\n            <div class=\"flex w-full min-w-0 flex-col overflow-hidden\">\n              <span class=\"flex items-center gap-(--spacing-xs)\">\n                <span class=\"truncate text-heading-xxs text-(--text-default)\">Nuxt E-commerce</span>\n              </span>\n              <span class=\"text-body-xs text-(--text-muted)\">\n                Launch a Nuxt e-commerce or content app in a few steps.\n              </span>\n            </div>\n\n            <div class=\"flex w-full flex-col gap-(--spacing-xxs)\">\n              <span class=\"truncate text-body-xxs text-(--text-muted)\">Cloning from Github</span>\n              <div class=\"flex items-center gap-(--spacing-md)\">\n                <span\n                  class=\"flex h-5 items-center gap-(--spacing-xxs) text-label-sm text-(--text-default)\"\n                >\n                  <i\n                    class=\"ai ai-github text-[length:inherit] leading-none\"\n                    aria-hidden=\"true\"\n                  />\n                  acme\n                </span>\n                <span\n                  class=\"flex h-5 items-center gap-(--spacing-xxs) text-label-sm text-(--text-muted)\"\n                >\n                  <i\n                    class=\"pi pi-folder text-[length:inherit] leading-none\"\n                    aria-hidden=\"true\"\n                  />\n                  templates/nuxt-ecommerce\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div\n          data-phase=\"form\"\n          class=\"flex w-full flex-col items-center gap-(--spacing-xl) data-[phase=success]:my-auto motion-reduce:transition-none! motion-reduce:transform-none!\"\n        >\n          <Card class=\"w-full\">\n            <template #content>\n              <div class=\"flex flex-col gap-(--spacing-lg)\">\n                <div class=\"flex flex-col gap-(--spacing-xxs)\">\n                  <h2 class=\"text-heading-xs text-(--text-default)\">Deploy your project</h2>\n                  <p class=\"text-body-sm text-pretty text-(--text-muted)\">\n                    This repository deploys on every push, automatically.\n                  </p>\n                </div>\n\n                <div class=\"grid grid-cols-1 items-start gap-(--spacing-lg) sm:grid-cols-2\">\n                  <Field>\n                    <Field.Label>Scope</Field.Label>\n                    <Select\n                      v-model=\"scope\"\n                      size=\"large\"\n                      placeholder=\"Select a scope\"\n                    >\n                      <Select.Trigger />\n                      <Select.Content>\n                        <Select.Option\n                          v-for=\"option in scopes\"\n                          :key=\"String(option.value)\"\n                          :value=\"option.value\"\n                          :disabled=\"option.disabled\"\n                        >\n                          {{ option.label }}\n                        </Select.Option>\n                      </Select.Content>\n                    </Select>\n                  </Field>\n\n                  <div class=\"flex flex-col gap-(--spacing-xs)\">\n                    <Label\n                      :label=\"isPublic ? 'Public Repository Name' : 'Private Repository Name'\"\n                      required\n                      for=\"repoName\"\n                    />\n                    <InputGroupRoot size=\"large\">\n                      <input\n                        id=\"repoName\"\n                        v-model=\"repoName\"\n                        placeholder=\"my-repository\"\n                        class=\"w-full h-full bg-transparent border-0 outline-none focus:ring-0 px-(--spacing-md) text-label-sm text-(--text-default) placeholder:text-(--text-muted) disabled:cursor-not-allowed disabled:text-(--text-disabled)\"\n                      />\n                      <InputGroupAddon>\n                        <Tooltip text=\"Toggle repository visibility (public or private)\">\n                          <Switch\n                            v-model=\"isPublic\"\n                            kind=\"privacy\"\n                            :aria-label=\"\n                              isPublic\n                                ? 'Repository is public — toggle to make it private'\n                                : 'Repository is private — toggle to make it public'\n                            \"\n                          />\n                        </Tooltip>\n                      </InputGroupAddon>\n                    </InputGroupRoot>\n                  </div>\n                </div>\n\n                <h3 class=\"text-heading-xxs text-(--text-default)\">Template Settings</h3>\n                <div class=\"flex flex-col gap-(--spacing-lg)\">\n                  <Field\n                    v-for=\"field in settings\"\n                    :key=\"field.name\"\n                  >\n                    <Field.Label>{{ field.label }}</Field.Label>\n                    <Input\n                      v-model=\"values[field.name]\"\n                      size=\"large\"\n                      :placeholder=\"field.placeholder\"\n                    />\n                    <Field.Description v-if=\"field.description\">{{\n                      field.description\n                    }}</Field.Description>\n                  </Field>\n                </div>\n              </div>\n            </template>\n\n            <template #footer>\n              <Button\n                class=\"w-full\"\n                label=\"Deploy\"\n                kind=\"primary\"\n                size=\"large\"\n                :disabled=\"!canDeploy\"\n              />\n            </template>\n          </Card>\n\n          <Button\n            label=\"Browse Templates\"\n            kind=\"outlined\"\n            size=\"medium\"\n          />\n        </div>\n      </div>\n    </main>\n  </div>\n</template>"
  }
 ]
