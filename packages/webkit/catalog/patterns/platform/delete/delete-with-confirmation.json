{
 "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import ConfirmDialog from '@aziontech/webkit/confirm-dialog'\n  import Input from '@aziontech/webkit/input'\n  import Alert from '@aziontech/webkit/alert'\n  import Tooltip from '@aziontech/webkit/tooltip'\n  import { computed, ref, useId, watch } from 'vue'\n\n  const open = ref(false)\n  const name = 'resource-01'\n  const confirmation = ref('')\n  const copied = ref(false)\n  const confirmLabelId = useId()\n\n  const canDelete = computed(\n    () => confirmation.value.trim().length > 0 && confirmation.value.trim() === name.trim()\n  )\n\n  watch(open, (isOpen) => {\n    if (!isOpen) return\n    confirmation.value = ''\n    copied.value = false\n  })\n\n  const copyName = async () => {\n    await navigator.clipboard.writeText(name)\n    copied.value = true\n    setTimeout(() => {\n      copied.value = false\n    }, 2000)\n  }\n\n  const confirm = () => {\n    if (!canDelete.value) return\n    open.value = false\n  }\n</script>\n\n<template>\n  <ConfirmDialog\n    v-model:open=\"open\"\n    title=\"Delete Resource\"\n    size=\"medium\"\n  >\n    <template #trigger>\n      <Button\n        label=\"Delete resource\"\n        kind=\"danger\"\n        size=\"medium\"\n      />\n    </template>\n    <div class=\"flex flex-col gap-(--spacing-md)\">\n      <Alert\n        severity=\"warning\"\n        label=\"Once confirmed, this action can't be reversed.\"\n      />\n      <p class=\"m-0 text-body-sm text-(--text-muted)\">\n        The selected resource will be deleted, along with all associated settings or instances.\n        Check the\n        <a\n          href=\"https://example.com/docs\"\n          class=\"text-link\"\n          >Help Center</a\n        >\n        for more details.\n      </p>\n      <p\n        :id=\"confirmLabelId\"\n        class=\"m-0 flex flex-wrap items-center gap-(--spacing-xxs) text-body-sm text-(--text-default)\"\n      >\n        <span>To confirm, type</span>\n        <Tooltip\n          text=\"Copy to clipboard\"\n          class=\"max-w-full\"\n        >\n          <button\n            type=\"button\"\n            class=\"inline-flex max-w-full cursor-pointer items-center rounded-(--shape-elements) border border-(length:--border-width-default) border-(--border-muted) bg-(--bg-surface-overlay) px-(--spacing-xxs) text-body-sm text-(--text-default) transition-colors duration-fast-02 ease-productive-entrance hover:border-(--border-default) hover:bg-(--bg-hover) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--ring-color) motion-reduce:transition-none\"\n            :aria-label=\"copied ? 'Copied ' + name : 'Copy ' + name + ' to the clipboard'\"\n            @click=\"copyName\"\n          >\n            <span class=\"truncate\">{{ name }}</span>\n            <i\n              :class=\"copied ? 'pi pi-check' : 'pi pi-copy'\"\n              class=\"ms-(--spacing-xxs) shrink-0 text-body-xs text-(--text-default)\"\n              aria-hidden=\"true\"\n            />\n            <span\n              :data-shown=\"copied || null\"\n              class=\"grid min-w-0 grid-cols-[0fr] transition-[grid-template-columns] duration-moderate-01 ease-productive-entrance data-shown:grid-cols-[1fr] motion-reduce:transition-none\"\n            >\n              <span class=\"min-w-0 overflow-hidden\">\n                <span\n                  class=\"block whitespace-nowrap ps-(--spacing-xxs) text-body-xs text-(--text-default)\"\n                  >Copied</span\n                >\n              </span>\n            </span>\n          </button>\n        </Tooltip>\n        <span>in the box below:</span>\n      </p>\n      <Input\n        v-model=\"confirmation\"\n        :aria-labelledby=\"confirmLabelId\"\n        autocomplete=\"off\"\n        class=\"w-full\"\n        @keydown.enter=\"confirm\"\n      />\n    </div>\n    <template #actions=\"{ close }\">\n      <Button\n        label=\"Cancel\"\n        kind=\"outlined\"\n        size=\"medium\"\n        @click=\"close\"\n      />\n      <Button\n        label=\"Delete\"\n        kind=\"danger\"\n        size=\"medium\"\n        :disabled=\"!canDelete\"\n        @click=\"confirm\"\n      />\n    </template>\n  </ConfirmDialog>\n</template>",
 "variants": [
  {
   "name": "LabelledField",
   "summary": "A short, blocking decision in a modal: an outlined `Item` row on the page names what the delete removes and holds the danger trigger, and the medium dialog it opens stacks a warning `Alert` over a labelled `Field` + `Input` asking for the exact resource name, with Delete disabled until the typed name matches. The field clears every time the dialog opens, so its content stays in place while it closes. It is the form counterpart of the default Delete dialog on the resource lists, which renders the name as a copy chip with a bare input instead of a labelled field. Built from `PageHeader`, the platform shell, `Item`, `Dialog` with its trigger, portal, overlay, content, title and close parts, `PanelHeader`, `PanelContent`, `PanelFooter`, `Alert`, `Field`, `Input` and `Button`.",
   "sfc": "<script setup>\n  import Avatar from '@aziontech/webkit/avatar'\n  import Brand from '@aziontech/webkit/brand'\n  import Breadcrumb from '@aziontech/webkit/breadcrumb'\n  import Button from '@aziontech/webkit/button'\n  import ButtonHighlight from '@aziontech/webkit/button-highlight'\n  import Command from '@aziontech/webkit/command'\n  import Dialog from '@aziontech/webkit/dialog'\n  import DialogClose from '@aziontech/webkit/dialog-close'\n  import DialogContent from '@aziontech/webkit/dialog-content'\n  import DialogOverlay from '@aziontech/webkit/dialog-overlay'\n  import DialogPortal from '@aziontech/webkit/dialog-portal'\n  import DialogTitle from '@aziontech/webkit/dialog-title'\n  import DialogTrigger from '@aziontech/webkit/dialog-trigger'\n  import Drawer from '@aziontech/webkit/drawer'\n  import DrawerContent from '@aziontech/webkit/drawer-content'\n  import DrawerOverlay from '@aziontech/webkit/drawer-overlay'\n  import DrawerPortal from '@aziontech/webkit/drawer-portal'\n  import DropdownMenu from '@aziontech/webkit/dropdown-menu'\n  import Field from '@aziontech/webkit/field'\n  import GlobalHeader from '@aziontech/webkit/global-header'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Input from '@aziontech/webkit/input'\n  import Item from '@aziontech/webkit/item'\n  import Kbd from '@aziontech/webkit/kbd'\n  import Menu from '@aziontech/webkit/menu'\n  import Alert from '@aziontech/webkit/alert'\n  import PageHeader from '@aziontech/webkit/page-header'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import Sidebar from '@aziontech/webkit/sidebar'\n  import StatusIndicator from '@aziontech/webkit/status-indicator'\n  import ThemeSwitcher from '@aziontech/webkit/theme-switcher'\n  import Tooltip from '@aziontech/webkit/tooltip'\n  import { computed, ref, watch } from 'vue'\n\n  const navGroups = [\n    {\n      items: [\n        { id: 'home', label: 'Home', icon: 'pi pi-home', path: '/home' },\n        { id: 'projects', label: 'Projects', icon: 'pi pi-folder', path: '/projects' },\n        {\n          id: 'deployments',\n          label: 'Deployments',\n          icon: 'pi pi-cloud-upload',\n          path: '/deployments'\n        }\n      ]\n    },\n    {\n      label: 'Build',\n      items: [\n        { id: 'resources', label: 'Resources', icon: 'pi pi-box', path: '/resources' },\n        { id: 'services', label: 'Services', icon: 'pi pi-server', path: '/services' },\n        { id: 'variables', label: 'Variables', icon: 'pi pi-sliders-h', path: '/variables' },\n        { id: 'integrations', label: 'Integrations', icon: 'pi pi-link', path: '/integrations' },\n        { id: 'templates', label: 'Templates', icon: 'pi pi-clone', path: '/templates' }\n      ]\n    },\n    {\n      label: 'Security',\n      items: [\n        { id: 'domains', label: 'Domains', icon: 'pi pi-globe', path: '/domains' },\n        { id: 'policies', label: 'Policies', icon: 'pi pi-shield', path: '/policies' },\n        { id: 'rule-sets', label: 'Rule sets', icon: 'pi pi-list', path: '/rule-sets' },\n        { id: 'keys', label: 'Keys', icon: 'pi pi-key', path: '/keys' }\n      ]\n    },\n    {\n      label: 'Data',\n      items: [\n        {\n          id: 'databases',\n          label: 'Databases',\n          icon: 'pi pi-database',\n          path: '/databases',\n          tagValue: 'Preview'\n        },\n        { id: 'storage', label: 'Storage', icon: 'pi pi-inbox', path: '/storage' }\n      ]\n    },\n    {\n      label: 'Observability',\n      items: [\n        { id: 'logs', label: 'Logs', icon: 'pi pi-file', path: '/logs' },\n        {\n          id: 'metrics-module',\n          label: 'Metrics',\n          icon: 'pi pi-chart-bar',\n          kind: 'drill',\n          href: '/metrics',\n          groups: [\n            {\n              items: [{ id: 'metrics', label: 'Overview', path: '/metrics' }]\n            },\n            {\n              label: 'Build',\n              items: [\n                {\n                  id: 'metrics-resources',\n                  label: 'Resources',\n                  path: '/metrics',\n                  query: { dashboard: 'resources' }\n                },\n                {\n                  id: 'metrics-services',\n                  label: 'Services',\n                  path: '/metrics',\n                  query: { dashboard: 'services' }\n                },\n                {\n                  id: 'metrics-cache',\n                  label: 'Cache',\n                  path: '/metrics',\n                  query: { dashboard: 'cache' }\n                }\n              ]\n            },\n            {\n              label: 'Security',\n              items: [\n                {\n                  id: 'metrics-domains',\n                  label: 'Domains',\n                  path: '/metrics',\n                  query: { dashboard: 'domains' }\n                },\n                {\n                  id: 'metrics-policies',\n                  label: 'Policies',\n                  path: '/metrics',\n                  query: { dashboard: 'policies' }\n                },\n                {\n                  id: 'metrics-rule-sets',\n                  label: 'Rule sets',\n                  path: '/metrics',\n                  query: { dashboard: 'rule-sets' }\n                }\n              ]\n            },\n            {\n              label: 'Data',\n              items: [\n                {\n                  id: 'metrics-databases',\n                  label: 'Databases',\n                  path: '/metrics',\n                  query: { dashboard: 'databases' }\n                },\n                {\n                  id: 'metrics-storage',\n                  label: 'Storage',\n                  path: '/metrics',\n                  query: { dashboard: 'storage' }\n                }\n              ]\n            }\n          ]\n        },\n        { id: 'events', label: 'Events', icon: 'pi pi-bolt', path: '/events' }\n      ]\n    },\n    {\n      label: 'More',\n      items: [\n        { id: 'catalog', label: 'Catalog', icon: 'pi pi-th-large', path: '/catalog' },\n        {\n          id: 'settings',\n          label: 'Settings',\n          icon: 'pi pi-cog',\n          kind: 'drill',\n          groups: [\n            {\n              label: 'Settings',\n              items: [\n                { id: 'settings-general', label: 'General', path: '/account' },\n                {\n                  id: 'settings-build-deployment',\n                  label: 'Build & Deployment',\n                  path: '/account/build-deployment'\n                },\n                {\n                  id: 'settings-environments',\n                  label: 'Environments',\n                  path: '/account/environments'\n                },\n                { id: 'settings-users', label: 'Users management', path: '/account/users' },\n                { id: 'settings-teams', label: 'Teams and permissions', path: '/account/teams' }\n              ]\n            },\n            {\n              label: 'Access',\n              items: [\n                { id: 'settings-tokens', label: 'Personal Tokens', path: '/personal-tokens' },\n                { id: 'settings-credentials', label: 'Credentials', path: '/account/credentials' },\n                { id: 'settings-security-mfa', label: 'Multi-factor auth' },\n                { id: 'settings-security-sessions', label: 'Active sessions' },\n                { id: 'settings-activity', label: 'Activity History', path: '/account/activity' }\n              ]\n            },\n            {\n              label: 'Billing',\n              items: [\n                { id: 'settings-billing', label: 'Billing and plan', path: '/account/billing' },\n                { id: 'settings-invoices', label: 'Invoices' }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ]\n\n  const recentRows = [\n    {\n      key: 'resources/1020655',\n      name: 'resource-01',\n      icon: 'pi pi-box',\n      typeLabel: 'Resource',\n      navId: 'resources'\n    },\n    {\n      key: 'domains/domain-1020655',\n      name: 'app.example.com',\n      icon: 'pi pi-globe',\n      typeLabel: 'Domain',\n      navId: 'domains'\n    },\n    {\n      key: 'databases/feature-flags',\n      name: 'feature-flags',\n      icon: 'pi pi-database',\n      typeLabel: 'Database',\n      navId: 'databases'\n    }\n  ]\n\n  const accountCommands = [\n    { id: 'settings', label: 'Account Settings', icon: 'pi pi-cog' },\n    { id: 'personal-tokens', label: 'Personal Tokens', icon: 'pi pi-key' },\n    { id: 'docs', label: 'Docs', icon: 'pi pi-book' },\n    { id: 'logout', label: 'Log out', icon: 'pi pi-sign-out' }\n  ]\n\n  const breadcrumb = [{ label: 'Forms', href: '/forms' }, { label: 'Dialog form' }]\n\n  const activeId = ref('forms')\n  const navOpen = ref(false)\n  const paletteOpen = ref(false)\n  const paletteQuery = ref('')\n  const theme = ref('system')\n  const railWidth = ref(null)\n  const railCollapsed = ref(false)\n\n  watch(paletteOpen, () => {\n    paletteQuery.value = ''\n  })\n\n  const leaves = (items) =>\n    items.flatMap((item) =>\n      item.groups\n        ? leaves(item.groups.flatMap((group) => group.items))\n        : item.children\n          ? leaves(item.children)\n          : [item]\n    )\n\n  const paletteGroups = navGroups.flatMap((group, groupIndex) => {\n    const blocks = []\n    let run = []\n    const flush = () => {\n      if (run.length) {\n        blocks.push({\n          key: `area-${groupIndex}-${blocks.length}`,\n          heading: group.label ?? '',\n          items: leaves(run)\n        })\n      }\n      run = []\n    }\n    for (const item of group.items) {\n      if (item.groups || item.children) {\n        flush()\n        blocks.push({ key: item.id, heading: item.label, items: leaves([item]) })\n      } else run.push(item)\n    }\n    flush()\n    return blocks\n  })\n\n  const resolvedTheme = computed(() =>\n    theme.value === 'system'\n      ? globalThis.matchMedia?.('(prefers-color-scheme: dark)').matches\n        ? 'dark'\n        : 'light'\n      : theme.value\n  )\n\n  const actionCommands = computed(() => [\n    { id: 'create', label: 'Create Resource', icon: 'pi pi-plus-circle' },\n    {\n      id: 'theme',\n      label: resolvedTheme.value === 'dark' ? 'Switch to Light Theme' : 'Switch to Dark Theme',\n      icon: resolvedTheme.value === 'dark' ? 'pi pi-sun' : 'pi pi-moon'\n    },\n    {\n      id: 'sidebar',\n      label: railCollapsed.value ? 'Expand Sidebar' : 'Collapse Sidebar',\n      icon: railCollapsed.value ? 'pi pi-angle-double-right' : 'pi pi-angle-double-left'\n    }\n  ])\n\n  const onNavigate = (event, node) => {\n    activeId.value = node.id\n  }\n\n  const onMobileNavigate = (event, node) => {\n    onNavigate(event, node)\n    navOpen.value = false\n  }\n\n  const onPaletteSelect = (event, value) => {\n    const [scope, id] = String(value).split(':')\n    if (scope === 'nav') activeId.value = id\n    if (scope === 'res') {\n      activeId.value = recentRows.find((row) => row.key === id)?.navId ?? activeId.value\n    }\n    if (id === 'theme') theme.value = resolvedTheme.value === 'dark' ? 'light' : 'dark'\n    if (id === 'sidebar') railCollapsed.value = !railCollapsed.value\n  }\n\n  const resource = { name: 'resource-01' }\n\n  const open = ref(false)\n  const confirmation = ref('')\n  const submitting = ref(false)\n\n  const canDelete = computed(() => confirmation.value.trim() === resource.name)\n  const confirmLabel = computed(() => `To confirm, type \"${resource.name}\" in the box below:`)\n\n  watch(open, (isOpen) => {\n    if (isOpen) confirmation.value = ''\n  })\n\n  const remove = () => {\n    if (!canDelete.value || submitting.value) return\n    open.value = false\n  }\n</script>\n\n<template>\n  <div class=\"relative flex h-dvh overflow-hidden bg-(--bg-canvas)\">\n    <div class=\"hidden h-full [--sidebar-width:var(--container-2xs)] md:flex\">\n      <Sidebar\n        v-model:width=\"railWidth\"\n        v-model:collapsed=\"railCollapsed\"\n        resizable\n        collapsible\n        aria-label=\"Main navigation\"\n        collapse-aria-label=\"Collapse sidebar\"\n        expand-aria-label=\"Expand sidebar\"\n        resize-aria-label=\"Resize sidebar\"\n      >\n        <template #header>\n          <div class=\"-m-(--spacing-md) flex flex-col\">\n            <div\n              class=\"flex h-14 shrink-0 items-center border-b border-(--border-default) px-(--spacing-md)\"\n            >\n              <a\n                href=\"/home\"\n                aria-label=\"Azion home\"\n                class=\"flex h-6 w-fit items-center rounded-(--shape-button) px-(--spacing-xs) transition-opacity duration-fast-02 ease-productive-entrance hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--ring-color) motion-reduce:transition-none\"\n              >\n                <Brand\n                  kind=\"default\"\n                  size=\"small\"\n                />\n              </a>\n            </div>\n\n            <Command\n              v-model:open=\"paletteOpen\"\n              @select=\"onPaletteSelect\"\n            >\n              <Command.Input\n                placeholder=\"Search resources, pages and commands\"\n                @update:model-value=\"(value) => (paletteQuery = String(value ?? ''))\"\n              />\n              <Command.List>\n                <Command.Group\n                  v-if=\"!paletteQuery\"\n                  key=\"recents\"\n                  heading=\"Recents\"\n                >\n                  <Command.Item\n                    v-for=\"row in recentRows\"\n                    :key=\"row.key\"\n                    :value=\"'res:' + row.key\"\n                  >\n                    <template #prefix>\n                      <i\n                        :class=\"row.icon\"\n                        aria-hidden=\"true\"\n                      />\n                    </template>\n                    {{ row.name }}\n                    <template #suffix>\n                      <span class=\"text-label-sm text-(--text-muted)\">{{ row.typeLabel }}</span>\n                    </template>\n                  </Command.Item>\n                </Command.Group>\n\n                <Command.Separator\n                  v-if=\"!paletteQuery\"\n                  key=\"recents-rule\"\n                />\n\n                <Command.Group\n                  v-for=\"group in paletteGroups\"\n                  :key=\"group.key\"\n                  :heading=\"group.heading\"\n                >\n                  <Command.Item\n                    v-for=\"item in group.items\"\n                    :key=\"item.id\"\n                    :value=\"'nav:' + item.id\"\n                  >\n                    <template\n                      v-if=\"item.icon\"\n                      #prefix\n                    >\n                      <i\n                        :class=\"item.icon\"\n                        aria-hidden=\"true\"\n                      />\n                    </template>\n                    {{ item.label }}\n                  </Command.Item>\n                </Command.Group>\n\n                <Command.Separator key=\"commands-rule\" />\n\n                <Command.Group heading=\"Actions\">\n                  <Command.Item\n                    v-for=\"command in actionCommands\"\n                    :key=\"command.id\"\n                    :value=\"'cmd:' + command.id\"\n                  >\n                    <template #prefix>\n                      <i\n                        :class=\"command.icon\"\n                        aria-hidden=\"true\"\n                      />\n                    </template>\n                    {{ command.label }}\n                  </Command.Item>\n                </Command.Group>\n\n                <Command.Group heading=\"Account\">\n                  <Command.Item\n                    v-for=\"command in accountCommands\"\n                    :key=\"command.id\"\n                    :value=\"'cmd:' + command.id\"\n                  >\n                    <template #prefix>\n                      <i\n                        :class=\"command.icon\"\n                        aria-hidden=\"true\"\n                      />\n                    </template>\n                    {{ command.label }}\n                  </Command.Item>\n                </Command.Group>\n\n                <Command.Empty>No resource, page or command matches your search.</Command.Empty>\n              </Command.List>\n            </Command>\n          </div>\n        </template>\n\n        <div class=\"-mt-(--spacing-xxs) pt-(--layout-boundary-start)\">\n          <Menu\n            :groups=\"navGroups\"\n            :active-id=\"activeId\"\n            role=\"presentation\"\n            @navigate=\"onNavigate\"\n          >\n            <Menu.Back />\n          </Menu>\n        </div>\n\n        <template #footer>\n          <div class=\"flex items-center gap-(--spacing-xs)\">\n            <Avatar\n              label=\"alex@example.com\"\n              size=\"small\"\n              kind=\"square\"\n            />\n            <span class=\"min-w-0 flex-1 truncate text-label-sm text-(--text-default)\">alex</span>\n            <DropdownMenu placement=\"top-end\">\n              <DropdownMenu.Trigger>\n                <Tooltip text=\"Account menu\">\n                  <IconButton\n                    icon=\"pi pi-ellipsis-v\"\n                    aria-label=\"Account menu\"\n                    kind=\"outlined\"\n                    size=\"small\"\n                  />\n                </Tooltip>\n              </DropdownMenu.Trigger>\n              <DropdownMenu.Group>\n                <template #top>\n                  <div class=\"flex min-w-0 flex-col\">\n                    <span class=\"truncate text-label-md text-(--text-default)\">alex</span>\n                    <span class=\"truncate text-body-xs text-(--text-muted)\">alex@example.com</span>\n                  </div>\n                </template>\n                <DropdownMenu.Option\n                  value=\"settings\"\n                  label=\"Account Settings\"\n                >\n                  <template #right>\n                    <i\n                      class=\"pi pi-cog\"\n                      aria-hidden=\"true\"\n                    />\n                  </template>\n                </DropdownMenu.Option>\n                <DropdownMenu.Option\n                  value=\"personal-tokens\"\n                  label=\"Personal Tokens\"\n                >\n                  <template #right>\n                    <i\n                      class=\"pi pi-key\"\n                      aria-hidden=\"true\"\n                    />\n                  </template>\n                </DropdownMenu.Option>\n              </DropdownMenu.Group>\n              <DropdownMenu.Group>\n                <div\n                  class=\"flex h-8 min-h-8 items-center gap-(--spacing-xs) rounded-(--shape-button) px-(--spacing-sm) py-(--spacing-xxs)\"\n                >\n                  <span class=\"flex-1 truncate text-start text-label-sm text-(--text-default)\"\n                    >Theme</span\n                  >\n                  <ThemeSwitcher\n                    v-model=\"theme\"\n                    aria-label=\"Theme\"\n                  />\n                </div>\n              </DropdownMenu.Group>\n              <DropdownMenu.Group>\n                <DropdownMenu.Option\n                  value=\"home\"\n                  label=\"Home Page\"\n                >\n                  <template #right>\n                    <i\n                      class=\"pi pi-home\"\n                      aria-hidden=\"true\"\n                 