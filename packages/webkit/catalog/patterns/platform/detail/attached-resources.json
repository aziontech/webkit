{
 "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Card from '@aziontech/webkit/card'\n  import DropdownMenuRoot from '@aziontech/webkit/dropdown-menu-root'\n  import DropdownMenuGroup from '@aziontech/webkit/dropdown-menu-group'\n  import DropdownMenuOption from '@aziontech/webkit/dropdown-menu-option'\n  import DropdownMenuTrigger from '@aziontech/webkit/dropdown-menu-trigger'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import TableRoot from '@aziontech/webkit/table-root'\n  import TableBody from '@aziontech/webkit/table-body'\n  import TableCell from '@aziontech/webkit/table-cell'\n  import TableHeadCell from '@aziontech/webkit/table-head-cell'\n  import TableHeader from '@aziontech/webkit/table-header'\n  import TableRow from '@aziontech/webkit/table-row'\n  import Tag from '@aziontech/webkit/tag'\n  import Tooltip from '@aziontech/webkit/tooltip'\n  import { computed } from 'vue'\n\n  const domains = [\n    {\n      id: 'generated',\n      domain: 'web-app-7f3a.example.net',\n      environment: 'Production',\n      policy: 'Single',\n      certificate: 'Managed (free)',\n      generated: true\n    },\n    {\n      id: 'shop',\n      domain: 'shop.example.com',\n      environment: 'Production',\n      policy: 'Single',\n      certificate: 'Managed (free)',\n      generated: false\n    },\n    {\n      id: 'preview',\n      domain: 'preview.example.com',\n      environment: 'Stage',\n      policy: 'Versioned',\n      certificate: '*.example.com',\n      generated: false\n    }\n  ]\n\n  const countLabel = computed(\n    () => `${domains.length} ${domains.length === 1 ? 'domain' : 'domains'}`\n  )\n</script>\n\n<template>\n  <Card :padded=\"false\">\n    <template #content>\n      <div class=\"flex min-w-0 flex-col\">\n        <TableRoot :bordered=\"false\">\n          <TableHeader>\n            <TableRow>\n              <TableHeadCell principal>Domain</TableHeadCell>\n              <TableHeadCell>Environment</TableHeadCell>\n              <TableHeadCell>Policy</TableHeadCell>\n              <TableHeadCell>Certificate</TableHeadCell>\n              <TableHeadCell kind=\"action\" />\n            </TableRow>\n          </TableHeader>\n\n          <TableBody>\n            <TableRow\n              v-for=\"entry in domains\"\n              :key=\"entry.id\"\n            >\n              <TableCell principal>{{ entry.domain }}</TableCell>\n              <TableCell>\n                <Tag\n                  v-if=\"entry.environment\"\n                  severity=\"secondary\"\n                  size=\"medium\"\n                  rounded\n                  icon=\"ai ai-layers\"\n                  :label=\"entry.environment\"\n                />\n              </TableCell>\n              <TableCell>\n                <Tag\n                  v-if=\"entry.environment\"\n                  severity=\"secondary\"\n                  size=\"medium\"\n                  rounded\n                  :label=\"entry.policy\"\n                />\n              </TableCell>\n              <TableCell>\n                <Tag\n                  severity=\"secondary\"\n                  size=\"medium\"\n                  rounded\n                  icon=\"pi pi-verified\"\n                  :label=\"entry.certificate\"\n                />\n              </TableCell>\n              <TableCell kind=\"action\">\n                <DropdownMenuRoot\n                  v-if=\"!entry.generated\"\n                  placement=\"bottom-end\"\n                >\n                  <DropdownMenuTrigger>\n                    <Tooltip text=\"Row actions\">\n                      <IconButton\n                        icon=\"pi pi-ellipsis-h\"\n                        kind=\"outlined\"\n                        size=\"small\"\n                        :aria-label=\"`Actions for ${entry.domain}`\"\n                      />\n                    </Tooltip>\n                  </DropdownMenuTrigger>\n                  <DropdownMenuGroup>\n                    <DropdownMenuOption\n                      value=\"edit\"\n                      label=\"Edit\"\n                    >\n                      <template #left\n                        ><i\n                          class=\"pi pi-pencil\"\n                          aria-hidden=\"true\"\n                      /></template>\n                    </DropdownMenuOption>\n                  </DropdownMenuGroup>\n                  <DropdownMenuGroup>\n                    <DropdownMenuOption\n                      value=\"delete\"\n                      label=\"Delete\"\n                    >\n                      <template #left\n                        ><i\n                          class=\"pi pi-trash\"\n                          aria-hidden=\"true\"\n                      /></template>\n                    </DropdownMenuOption>\n                  </DropdownMenuGroup>\n                </DropdownMenuRoot>\n              </TableCell>\n            </TableRow>\n          </TableBody>\n        </TableRoot>\n\n        <div\n          class=\"flex flex-wrap items-center justify-between gap-(--spacing-xs) border-t border-(--border-muted) px-(--spacing-md) py-(--spacing-sm)\"\n        >\n          <span class=\"text-body-xs text-(--text-muted)\">{{ countLabel }}</span>\n          <Button\n            type=\"button\"\n            label=\"Add Domain\"\n            kind=\"outlined\"\n            size=\"medium\"\n            icon=\"pi pi-plus\"\n          />\n        </div>\n      </div>\n    </template>\n  </Card>\n</template>",
 "variants": []
}
