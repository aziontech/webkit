{
 "sfc": "<script setup>\n  import Card from '@aziontech/webkit/card'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Item from '@aziontech/webkit/item'\n  import Tag from '@aziontech/webkit/tag'\n  import { computed } from 'vue'\n\n  const steps = [\n    {\n      id: 'domain',\n      icon: 'pi pi-globe',\n      title: 'Add a custom domain',\n      description:\n        'Serve this service on a domain of your own, with a free HTTPS certificate, instead of the generated hostname.',\n      actionLabel: 'Add Domain',\n      done: true,\n      doneNote: 'Serving shop.example.com.'\n    },\n    {\n      id: 'policy',\n      icon: 'pi pi-shield',\n      title: 'Enable a security policy',\n      description:\n        'Attach a policy so requests are inspected before they reach the service. Rate limiting, access rules, and IP allowlists.',\n      actionLabel: 'Attach Policy',\n      done: false,\n      doneNote: ''\n    },\n    {\n      id: 'customPage',\n      icon: 'pi pi-file',\n      title: 'Set custom error pages',\n      description: 'Answer 4xx and 5xx with your own page instead of the default response.',\n      actionLabel: 'Add Error Page',\n      done: false,\n      doneNote: ''\n    }\n  ]\n\n  const doneCount = computed(() => steps.filter((step) => step.done).length)\n  const complete = computed(() => steps.length > 0 && doneCount.value === steps.length)\n</script>\n\n<template>\n  <Card\n    :padded=\"false\"\n    :data-complete=\"complete || null\"\n  >\n    <template #header>\n      <div class=\"flex min-w-0 flex-1 items-center gap-(--spacing-sm)\">\n        <h2 class=\"truncate text-label-md text-(--text-default)\">Ship to production</h2>\n\n        <Tag\n          :label=\"complete ? 'Ready for production' : `${doneCount} of ${steps.length}`\"\n          :severity=\"complete ? 'success' : 'secondary'\"\n          size=\"small\"\n          class=\"shrink-0\"\n        />\n      </div>\n\n      <IconButton\n        icon=\"pi pi-window-maximize\"\n        aria-label=\"Expand the production checklist\"\n        kind=\"outlined\"\n        size=\"small\"\n        class=\"shrink-0\"\n      />\n    </template>\n\n    <template #content>\n      <div\n        v-if=\"!complete\"\n        class=\"flex flex-col\"\n      >\n        <Item\n          v-for=\"step in steps\"\n          :key=\"`${step.id}:${step.done ? 'done' : 'todo'}`\"\n          as-child\n          size=\"small\"\n        >\n          <button\n            type=\"button\"\n            :data-done=\"step.done || null\"\n            class=\"w-full rounded-none text-start transition-colors duration-fast-02 ease-productive-entrance data-done:bg-(--primary-mask) motion-reduce:transition-none\"\n          >\n            <Item.Media>\n              <i\n                :class=\"step.icon\"\n                class=\"text-body-sm leading-none text-(--text-muted) group-data-done/item:text-(--primary)\"\n                aria-hidden=\"true\"\n              />\n            </Item.Media>\n\n            <Item.Content>\n              <Item.Title>\n                {{ step.title }}\n              </Item.Title>\n            </Item.Content>\n\n            <Item.Actions>\n              <i\n                v-if=\"step.done\"\n                class=\"pi pi-check text-body-sm leading-none text-(--primary)\"\n                aria-hidden=\"true\"\n              />\n              <span class=\"sr-only\">{{ step.done ? 'Done' : 'Not started' }}</span>\n            </Item.Actions>\n          </button>\n        </Item>\n      </div>\n    </template>\n  </Card>\n</template>",
 "variants": [
  {
   "name": "Complete",
   "summary": "Every gate done: the Tag turns into a success Ready for production, the rows are gone and the header loses its bottom border, so the card closes down to its title and the expand button.",
   "sfc": "<script setup>\n  import Card from '@aziontech/webkit/card'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Item from '@aziontech/webkit/item'\n  import Tag from '@aziontech/webkit/tag'\n  import { computed } from 'vue'\n\n  const steps = [\n    {\n      id: 'domain',\n      icon: 'pi pi-globe',\n      title: 'Add a custom domain',\n      description:\n        'Serve this service on a domain of your own, with a free HTTPS certificate, instead of the generated hostname.',\n      actionLabel: 'Add Domain',\n      done: true,\n      doneNote: 'Serving shop.example.com.'\n    },\n    {\n      id: 'policy',\n      icon: 'pi pi-shield',\n      title: 'Enable a security policy',\n      description:\n        'Attach a policy so requests are inspected before they reach the service. Rate limiting, access rules, and IP allowlists.',\n      actionLabel: 'Attach Policy',\n      done: true,\n      doneNote: 'Protected by policy-production.'\n    },\n    {\n      id: 'customPage',\n      icon: 'pi pi-file',\n      title: 'Set custom error pages',\n      description: 'Answer 4xx and 5xx with your own page instead of the default response.',\n      actionLabel: 'Add Error Page',\n      done: true,\n      doneNote: 'Serving Branded 404.'\n    }\n  ]\n\n  const doneCount = computed(() => steps.filter((step) => step.done).length)\n  const complete = computed(() => steps.length > 0 && doneCount.value === steps.length)\n</script>\n\n<template>\n  <Card\n    :padded=\"false\"\n    :data-complete=\"complete || null\"\n  >\n    <template #header>\n      <div class=\"flex min-w-0 flex-1 items-center gap-(--spacing-sm)\">\n        <h2 class=\"truncate text-label-md text-(--text-default)\">Ship to production</h2>\n\n        <Tag\n          :label=\"complete ? 'Ready for production' : `${doneCount} of ${steps.length}`\"\n          :severity=\"complete ? 'success' : 'secondary'\"\n          size=\"small\"\n          class=\"shrink-0\"\n        />\n      </div>\n\n      <IconButton\n        icon=\"pi pi-window-maximize\"\n        aria-label=\"Expand the production checklist\"\n        kind=\"outlined\"\n        size=\"small\"\n        class=\"shrink-0\"\n      />\n    </template>\n\n    <template #content>\n      <div\n        v-if=\"!complete\"\n        class=\"flex flex-col\"\n      >\n        <Item\n          v-for=\"step in steps\"\n          :key=\"`${step.id}:${step.done ? 'done' : 'todo'}`\"\n          as-child\n          size=\"small\"\n        >\n          <button\n            type=\"button\"\n            :data-done=\"step.done || null\"\n            class=\"w-full rounded-none text-start transition-colors duration-fast-02 ease-productive-entrance data-done:bg-(--primary-mask) motion-reduce:transition-none\"\n          >\n            <Item.Media>\n              <i\n                :class=\"step.icon\"\n                class=\"text-body-sm leading-none text-(--text-muted) group-data-done/item:text-(--primary)\"\n                aria-hidden=\"true\"\n              />\n            </Item.Media>\n\n            <Item.Content>\n              <Item.Title>\n                {{ step.title }}\n              </Item.Title>\n            </Item.Content>\n\n            <Item.Actions>\n              <i\n                v-if=\"step.done\"\n                class=\"pi pi-check text-body-sm leading-none text-(--primary)\"\n                aria-hidden=\"true\"\n              />\n              <span class=\"sr-only\">{{ step.done ? 'Done' : 'Not started' }}</span>\n            </Item.Actions>\n          </button>\n        </Item>\n      </div>\n    </template>\n  </Card>\n</template>"
  },
  {
   "name": "DrawerDetail",
   "summary": "The expand button opens a right-side drawer with the same progress Tag, the checklist description, every step with its description, and either its action or, once done, a Tag with what it now serves, over a Done footer.",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Card from '@aziontech/webkit/card'\n  import Drawer from '@aziontech/webkit/drawer'\n  import DrawerClose from '@aziontech/webkit/drawer-close'\n  import DrawerContent from '@aziontech/webkit/drawer-content'\n  import DrawerOverlay from '@aziontech/webkit/drawer-overlay'\n  import DrawerPortal from '@aziontech/webkit/drawer-portal'\n  import DrawerTitle from '@aziontech/webkit/drawer-title'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Item from '@aziontech/webkit/item'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import Tag from '@aziontech/webkit/tag'\n  import { computed, ref } from 'vue'\n\n  const open = ref(false)\n\n  const steps = [\n    {\n      id: 'domain',\n      icon: 'pi pi-globe',\n      title: 'Add a custom domain',\n      description:\n        'Serve this service on a domain of your own, with a free HTTPS certificate, instead of the generated hostname.',\n      actionLabel: 'Add Domain',\n      done: true,\n      doneNote: 'Serving shop.example.com.'\n    },\n    {\n      id: 'policy',\n      icon: 'pi pi-shield',\n      title: 'Enable a security policy',\n      description:\n        'Attach a policy so requests are inspected before they reach the service. Rate limiting, access rules, and IP allowlists.',\n      actionLabel: 'Attach Policy',\n      done: false,\n      doneNote: ''\n    },\n    {\n      id: 'customPage',\n      icon: 'pi pi-file',\n      title: 'Set custom error pages',\n      description: 'Answer 4xx and 5xx with your own page instead of the default response.',\n      actionLabel: 'Add Error Page',\n      done: false,\n      doneNote: ''\n    }\n  ]\n\n  const doneCount = computed(() => steps.filter((step) => step.done).length)\n  const complete = computed(() => steps.length > 0 && doneCount.value === steps.length)\n</script>\n\n<template>\n  <Card\n    :padded=\"false\"\n    :data-complete=\"complete || null\"\n  >\n    <template #header>\n      <div class=\"flex min-w-0 flex-1 items-center gap-(--spacing-sm)\">\n        <h2 class=\"truncate text-label-md text-(--text-default)\">Ship to production</h2>\n\n        <Tag\n          :label=\"complete ? 'Ready for production' : `${doneCount} of ${steps.length}`\"\n          :severity=\"complete ? 'success' : 'secondary'\"\n          size=\"small\"\n          class=\"shrink-0\"\n        />\n      </div>\n\n      <IconButton\n        icon=\"pi pi-window-maximize\"\n        aria-label=\"Expand the production checklist\"\n        kind=\"outlined\"\n        size=\"small\"\n        class=\"shrink-0\"\n        @click=\"open = true\"\n      />\n    </template>\n\n    <template #content>\n      <div\n        v-if=\"!complete\"\n        class=\"flex flex-col\"\n      >\n        <Item\n          v-for=\"step in steps\"\n          :key=\"`${step.id}:${step.done ? 'done' : 'todo'}`\"\n          as-child\n          size=\"small\"\n        >\n          <button\n            type=\"button\"\n            :data-done=\"step.done || null\"\n            class=\"w-full rounded-none text-start transition-colors duration-fast-02 ease-productive-entrance data-done:bg-(--primary-mask) motion-reduce:transition-none\"\n          >\n            <Item.Media>\n              <i\n                :class=\"step.icon\"\n                class=\"text-body-sm leading-none text-(--text-muted) group-data-done/item:text-(--primary)\"\n                aria-hidden=\"true\"\n              />\n            </Item.Media>\n\n            <Item.Content>\n              <Item.Title>\n                {{ step.title }}\n              </Item.Title>\n            </Item.Content>\n\n            <Item.Actions>\n              <i\n                v-if=\"step.done\"\n                class=\"pi pi-check text-body-sm leading-none text-(--primary)\"\n                aria-hidden=\"true\"\n              />\n              <span class=\"sr-only\">{{ step.done ? 'Done' : 'Not started' }}</span>\n            </Item.Actions>\n          </button>\n        </Item>\n      </div>\n    </template>\n  </Card>\n\n  <Drawer\n    v-model:open=\"open\"\n    size=\"large\"\n    side=\"right\"\n  >\n    <DrawerPortal>\n      <DrawerOverlay />\n      <DrawerContent>\n        <PanelHeader class=\"w-full\">\n          <div class=\"flex min-w-0 flex-1 flex-col gap-(--spacing-xxs)\">\n            <div class=\"flex min-w-0 items-center gap-(--spacing-sm)\">\n              <DrawerTitle>Ship to production</DrawerTitle>\n              <Tag\n                :label=\"complete ? 'Ready for production' : `${doneCount} of ${steps.length}`\"\n                :severity=\"complete ? 'success' : 'secondary'\"\n                size=\"small\"\n                class=\"shrink-0\"\n              />\n            </div>\n            <p class=\"text-body-sm text-(--text-muted)\">\n              The create put this service live on a generated hostname. These are the gates between\n              that and production.\n            </p>\n          </div>\n          <DrawerClose />\n        </PanelHeader>\n\n        <PanelContent>\n          <div class=\"flex flex-col gap-(--spacing-sm)\">\n            <Item\n              v-for=\"step in steps\"\n              :key=\"`${step.id}:${step.done ? 'done' : 'todo'}`\"\n              size=\"medium\"\n              :data-done=\"step.done || null\"\n            >\n              <Item.Media>\n                <span\n                  class=\"flex size-8 items-center justify-center rounded-(--shape-elements) border border-(--border-muted) bg-(--bg-surface) text-(--text-default) transition-colors duration-fast-02 ease-productive-entrance group-data-done/item:border-(--primary) group-data-done/item:bg-transparent group-data-done/item:text-(--primary) motion-reduce:transition-none\"\n                  aria-hidden=\"true\"\n                >\n                  <i\n                    :class=\"step.done ? 'pi pi-check' : step.icon\"\n                    class=\"text-body-sm leading-none\"\n                  />\n                </span>\n              </Item.Media>\n\n              <Item.Content>\n                <Item.Title>\n                  {{ step.title }}\n                </Item.Title>\n                <Item.Description>\n                  {{ step.description }}\n                </Item.Description>\n              </Item.Content>\n\n              <Item.Footer>\n                <Tag\n                  v-if=\"step.done\"\n                  icon=\"pi pi-check\"\n                  :label=\"step.doneNote || 'Done'\"\n                  severity=\"secondary\"\n                  size=\"medium\"\n                />\n                <Button\n                  v-else\n                  :label=\"step.actionLabel || step.title\"\n                  kind=\"outlined\"\n                  size=\"small\"\n                  @click=\"open = false\"\n                />\n              </Item.Footer>\n            </Item>\n          </div>\n        </PanelContent>\n\n        <PanelFooter>\n          <div class=\"flex w-full items-center justify-end gap-(--spacing-sm)\">\n            <Button\n              label=\"Done\"\n              kind=\"primary\"\n              size=\"medium\"\n              @click=\"open = false\"\n            />\n          </div>\n        </PanelFooter>\n      </DrawerContent>\n    </DrawerPortal>\n  </Drawer>\n</template>"
  }
