{
 "name": "chart-card",
 "binding": "ChartCard",
 "import": "@aziontech/webkit/chart-card",
 "treeShakeableImport": "@aziontech/webkit/chart-card-root",
 "category": "chart",
 "surface": "product",
 "structure": "composition",
 "compoundRoot": true,
 "subcomponents": [
  "@aziontech/webkit/chart-card-content",
  "@aziontech/webkit/chart-card-controls",
  "@aziontech/webkit/chart-card-description",
  "@aziontech/webkit/chart-card-drag-handle",
  "@aziontech/webkit/chart-card-footer",
  "@aziontech/webkit/chart-card-header",
  "@aziontech/webkit/chart-card-resize-handle",
  "@aziontech/webkit/chart-card-title"
 ],
 "purpose": "The box a dashboard chart lives in: a header with the title, the description and a controls zone, a content area padded or flush, an optional footer, and two optional handles that let the person move the card and resize it on a dashboard grid. The span (grid columns) and height are two-way models applied through custom properties, so the consumer's grid lays cards out with no script, and the reorder state stays with the page that owns the grid.",
 "setup": null,
 "useWhen": [
  "Every chart on a metrics dashboard, so title, description, menu and size read the same everywhere.",
  "A dashboard the person arranges: drag a card to reorder it, drag a corner to make it wider or taller."
 ],
 "avoidWhen": [
  "A KPI figure → use `stat-tile`, which is its own surface.",
  "A general content card with no chart → use `card`.",
  "A chart inline in a page section with its own heading → render `chart` alone."
 ],
 "related": [
  "chart`, `donut-chart` — what goes inside the content area; a chart inside a card takes its accessible name from the card title.",
  "card` — the general-purpose card; ChartCard shares its surface tokens.",
  "dropdown` — the \"More options\" menu (Copy query, Export CSV) composed into the controls zone."
 ],
 "bestPractices": [
  "Put the aggregation tag (Sum, Average) and the variation tag in `ChartCard.Controls`, before the menu.",
  "Keep filters and the time range above the grid, never inside a card.",
  "Use `flush` content for a plot that should run edge to edge, padded for everything else.",
  "Give the page's grid `--chart-grid-columns` per breakpoint so a 6-column card never overflows a 1-column phone layout.",
  "Persist `span` and `height` with the dashboard layout; they are plain numbers."
 ],
 "props": [
  {
   "name": "draggable",
   "type": "boolean",
   "default": "false",
   "required": "false",
   "doc": "Shows the drag handle and lets the card be dragged to a new position."
  },
  {
   "name": "resizable",
   "type": "boolean",
   "default": "false",
   "required": "false",
   "doc": "Shows the resize handle."
  },
  {
   "name": "minSpan",
   "type": "number",
   "default": "3",
   "required": "false",
   "doc": "Fewest grid columns the card may span."
  },
  {
   "name": "maxSpan",
   "type": "number",
   "default": "12",
   "required": "false",
   "doc": "Most grid columns the card may span."
  },
  {
   "name": "minHeight",
   "type": "number",
   "default": "240",
   "required": "false",
   "doc": "Smallest height in pixels the resize handle allows."
  },
  {
   "name": "maxHeight",
   "type": "number",
   "default": "960",
   "required": "false",
   "doc": "Largest height in pixels the resize handle allows."
  },
  {
   "name": "ariaLabel",
   "type": "string",
   "default": "''",
   "required": "false",
   "doc": "Accessible name of the card when it has no title."
  },
  {
   "name": "span",
   "type": "number",
   "default": "6",
   "required": "false",
   "doc": "Two-way value (`v-model:span`)."
  },
  {
   "name": "height",
   "type": "number | undefined",
   "default": "undefined",
   "required": "false",
   "doc": "Two-way value (`v-model:height`)."
  }
 ],
 "events": [
  {
   "name": "move",
   "payload": "(event: KeyboardEvent, direction: 'up' | 'down' | 'left' | 'right')",
   "notes": "An arrow key on the drag handle; the page moves the card in its own order."
  },
  {
   "name": "drag-start",
   "payload": "(event: DragEvent)",
   "notes": "Native drag began from the handle; the page records the source."
  },
  {
   "name": "drag-end",
   "payload": "(event: DragEvent)",
   "notes": "Native drag ended, dropped or cancelled."
  },
  {
   "name": "resize-start",
   "payload": "(event: PointerEvent)",
   "notes": "A pointer resize began on the handle."
  },
  {
   "name": "resize-end",
   "payload": "(event: PointerEvent | KeyboardEvent)",
   "notes": "A resize finished: pointer released, or a keyboard nudge committed."
  }
 ],
 "slots": [
  {
   "name": "default",
   "scope": "—",
   "notes": "The parts: Header, Description, Content, Footer, ResizeHandle."
  }
 ],
 "styleSeam": false,
 "assets": [],
 "examples": [
  {
   "name": "Default",
   "sfc": "<script setup>\n  import ChartCard from '@aziontech/webkit/chart-card'\n  import Chart from '@aziontech/webkit/chart'\n  import Hint from '@aziontech/webkit/hint'\n\n  const labels = [\n    '13:05',\n    '13:10',\n    '13:15',\n    '13:20',\n    '13:25',\n    '13:30',\n    '13:35',\n    '13:40',\n    '13:45',\n    '13:50',\n    '13:55',\n    '14:00'\n  ]\n  const series = [\n    {\n      id: 'allowed',\n      name: 'WAF requests allowed',\n      color: 'success',\n      values: [1210, 1340, 1295, 1480, 1530, 1460, 1610, 1580, 1720, 1690, 1810, 1760]\n    },\n    {\n      id: 'blocked',\n      name: 'WAF requests blocked',\n      color: 'danger',\n      values: [320, 410, 380, 520, 470, 430, 610, 580, 540, 690, 650, 720]\n    },\n    {\n      id: 'threat',\n      name: 'WAF requests threat',\n      color: 'warning',\n      values: [80, 95, 70, 120, 110, 90, 140, 130, 115, 160, 150, 170]\n    }\n  ]\n</script>\n\n<template>\n  <ChartCard>\n    <ChartCard.Header>\n      <span class=\"inline-flex min-w-0 items-center gap-(--spacing-xxs)\">\n        <ChartCard.Title>Threats vs requests</ChartCard.Title>\n        <Hint text=\"Requests WAF analyzed, split into blocked, logged and allowed.\" />\n      </span>\n    </ChartCard.Header>\n    <ChartCard.Content>\n      <Chart\n        :series=\"series\"\n        :labels=\"labels\"\n      >\n        <Chart.Grid />\n        <Chart.Axis kind=\"y\" />\n        <Chart.Axis kind=\"x\" />\n        <Chart.Line />\n        <Chart.Crosshair />\n        <Chart.Tooltip />\n        <Chart.Legend totals />\n      </Chart>\n    </ChartCard.Content>\n    <ChartCard.Footer>Last hour, 5 minute buckets</ChartCard.Footer>\n  </ChartCard>\n</template>"
  },
  {
   "name": "Content",
   "sfc": "<script setup>\n  import ChartCard from '@aziontech/webkit/chart-card'\n  import Chart from '@aziontech/webkit/chart'\n  import Hint from '@aziontech/webkit/hint'\n\n  const labels = [\n    '13:05',\n    '13:10',\n    '13:15',\n    '13:20',\n    '13:25',\n    '13:30',\n    '13:35',\n    '13:40',\n    '13:45',\n    '13:50',\n    '13:55',\n    '14:00'\n  ]\n  const series = [\n    {\n      id: 'allowed',\n      name: 'WAF requests allowed',\n      color: 'success',\n      values: [1210, 1340, 1295, 1480, 1530, 1460, 1610, 1580, 1720, 1690, 1810, 1760]\n    },\n    {\n      id: 'blocked',\n      name: 'WAF requests blocked',\n      color: 'danger',\n      values: [320, 410, 380, 520, 470, 430, 610, 580, 540, 690, 650, 720]\n    },\n    {\n      id: 'threat',\n      name: 'WAF requests threat',\n      color: 'warning',\n      values: [80, 95, 70, 120, 110, 90, 140, 130, 115, 160, 150, 170]\n    }\n  ]\n</script>\n\n<template>\n  <div class=\"grid grid-cols-1 gap-(--spacing-lg) lg:grid-cols-2\">\n    <ChartCard>\n      <ChartCard.Header>\n        <ChartCard.Title>Padded</ChartCard.Title>\n      </ChartCard.Header>\n      <ChartCard.Content>\n        <Chart\n          :series=\"series\"\n          :labels=\"labels\"\n        >\n          <Chart.Grid />\n          <Chart.Axis kind=\"y\" />\n          <Chart.Axis kind=\"x\" />\n          <Chart.Line />\n          <Chart.Crosshair />\n          <Chart.Tooltip />\n          <Chart.Legend totals />\n        </Chart>\n      </ChartCard.Content>\n    </ChartCard>\n    <ChartCard>\n      <ChartCard.Header>\n        <ChartCard.Title>Flush</ChartCard.Title>\n      </ChartCard.Header>\n      <ChartCard.Content flush>\n        <Chart\n          :series=\"series\"\n          :labels=\"labels\"\n        >\n          <Chart.Grid />\n          <Chart.Axis kind=\"y\" />\n          <Chart.Axis kind=\"x\" />\n          <Chart.Line />\n          <Chart.Crosshair />\n          <Chart.Tooltip />\n          <Chart.Legend totals />\n        </Chart>\n      </ChartCard.Content>\n    </ChartCard>\n  </div>\n</template>"
  },
  {
   "name": "WithControls",
   "sfc": "<script setup>\n  import Chart from '@aziontech/webkit/chart'\n  import ChartCard from '@aziontech/webkit/chart-card'\n  import DropdownMenuGroup from '@aziontech/webkit/dropdown-menu-group'\n  import DropdownMenuOption from '@aziontech/webkit/dropdown-menu-option'\n  import DropdownMenuRoot from '@aziontech/webkit/dropdown-menu-root'\n  import DropdownMenuTrigger from '@aziontech/webkit/dropdown-menu-trigger'\n  import Hint from '@aziontech/webkit/hint'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import Tag from '@aziontech/webkit/tag'\n\n  const labels = [\n    '13:05',\n    '13:10',\n    '13:15',\n    '13:20',\n    '13:25',\n    '13:30',\n    '13:35',\n    '13:40',\n    '13:45',\n    '13:50',\n    '13:55',\n    '14:00'\n  ]\n  const series = [\n    {\n      id: 'xss',\n      name: 'WAF requests XSS attacks',\n      values: [42, 38, 51, 47, 63, 58, 72, 69, 81, 77, 90, 86]\n    }\n  ]\n</script>\n\n<template>\n  <ChartCard class=\"max-w-(--container-3xl)\">\n    <ChartCard.Header>\n      <span class=\"inline-flex min-w-0 items-center gap-(--spacing-xxs)\">\n        <ChartCard.Title>Cross-site scripting threats</ChartCard.Title>\n        <Hint text=\"Requests carrying cross-site scripting attacks against your domains.\" />\n      </span>\n      <ChartCard.Controls>\n        <Tag\n          label=\"Sum\"\n          severity=\"secondary\"\n          icon=\"pi pi-calculator\"\n        />\n        <Tag\n          label=\"+12.40%\"\n          severity=\"danger\"\n        />\n        <DropdownMenuRoot>\n          <DropdownMenuTrigger>\n            <IconButton\n              kind=\"transparent\"\n              size=\"small\"\n              icon=\"pi pi-ellipsis-h\"\n              aria-label=\"More options\"\n            />\n          </DropdownMenuTrigger>\n          <DropdownMenuGroup>\n            <DropdownMenuOption\n              value=\"copy-query\"\n              label=\"Copy query\"\n            />\n            <DropdownMenuOption\n              value=\"export-csv\"\n              label=\"Export CSV\"\n            />\n            <DropdownMenuOption\n              value=\"mean-line\"\n              label=\"Show mean line\"\n            />\n          </DropdownMenuGroup>\n        </DropdownMenuRoot>\n      </ChartCard.Controls>\n    </ChartCard.Header>\n    <ChartCard.Content>\n      <Chart\n        :series=\"series\"\n        :labels=\"labels\"\n      >\n        <Chart.Grid />\n        <Chart.Axis kind=\"y\" />\n        <Chart.Axis kind=\"x\" />\n        <Chart.Line />\n        <Chart.Crosshair />\n        <Chart.Tooltip />\n      </Chart>\n    </ChartCard.Content>\n  </ChartCard>\n</template>"
  }
 ],
 "docs": "components/chart-card.md"
}
