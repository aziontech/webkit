{
 "name": "dialog",
 "binding": "Dialog",
 "import": "@aziontech/webkit/dialog",
 "treeShakeableImport": "@aziontech/webkit/dialog",
 "category": "overlay",
 "surface": "product",
 "structure": "composition",
 "compoundRoot": true,
 "subcomponents": [
  "@aziontech/webkit/dialog-close",
  "@aziontech/webkit/dialog-content",
  "@aziontech/webkit/dialog-description",
  "@aziontech/webkit/dialog-overlay",
  "@aziontech/webkit/dialog-portal",
  "@aziontech/webkit/dialog-title",
  "@aziontech/webkit/dialog-trigger"
 ],
 "purpose": "Modal surface above the page, built on the shared Panel shell. The consumer composes a trigger, an overlay backdrop and the panel regions (header, body, footer); the body is the only region that scrolls. Below `md` it renders as a full-width bottom sheet.",
 "setup": null,
 "useWhen": [
  "A focused, blocking modal task or confirmation that should sit centered over the page and trap focus.",
  "The interaction must be completed or dismissed before returning to the page."
 ],
 "avoidWhen": [
  "The content is a side panel, long form, or navigation that should slide from an edge → use `drawer`.",
  "It is small contextual content anchored to a trigger (a menu, info bubble, picker) → use a popover / `dropdown`."
 ],
 "related": [
  "drawer` — edge-anchored panel for secondary tasks / long content.",
  "dropdown` — trigger-anchored menu for actions/options."
 ],
 "bestPractices": [
  "Trap focus, restore it on close, and close on Escape and overlay click.",
  "One clear primary action; keep the body scannable.",
  "Bind the open state with `v-model:open`, or `:open` plus an `@update:open` handler typed `(open: boolean) => void`. The payload is always a `boolean`, so the handler needs no cast and no `Boolean(...)`."
 ],
 "props": [
  {
   "name": "defaultOpen",
   "type": "boolean",
   "default": "false",
   "required": "false",
   "doc": "Initial open state when uncontrolled."
  },
  {
   "name": "dismissible",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "When true, overlay click and Escape close the dialog."
  },
  {
   "name": "size",
   "type": "DialogSize",
   "default": "'medium'",
   "required": "false",
   "doc": "Panel max-width preset passed to the inner Panel."
  },
  {
   "name": "open",
   "type": "boolean",
   "default": "undefined as never",
   "required": "false",
   "doc": "Two-way value (`v-model:open`)."
  }
 ],
 "events": [],
 "slots": [
  {
   "name": "default",
   "scope": "—",
   "notes": "—"
  }
 ],
 "styleSeam": false,
 "assets": [],
 "examples": [
  {
   "name": "Default",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Dialog from '@aziontech/webkit/dialog'\n  import DialogClose from '@aziontech/webkit/dialog-close'\n  import DialogContent from '@aziontech/webkit/dialog-content'\n  import DialogDescription from '@aziontech/webkit/dialog-description'\n  import DialogOverlay from '@aziontech/webkit/dialog-overlay'\n  import DialogPortal from '@aziontech/webkit/dialog-portal'\n  import DialogTitle from '@aziontech/webkit/dialog-title'\n  import DialogTrigger from '@aziontech/webkit/dialog-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n</script>\n\n<template>\n  <Dialog\n    v-model:open=\"open\"\n    dismissible\n    size=\"medium\"\n  >\n    <DialogTrigger>\n      <Button\n        label=\"Open dialog\"\n        kind=\"primary\"\n      />\n    </DialogTrigger>\n    <DialogPortal>\n      <DialogOverlay />\n      <DialogContent>\n        <PanelHeader class=\"w-full\">\n          <DialogTitle>Dialog Title</DialogTitle>\n          <DialogClose />\n        </PanelHeader>\n        <PanelContent>\n          <DialogDescription>\n            Modal content. Uses the shared Panel header, body, and footer regions.\n          </DialogDescription>\n        </PanelContent>\n        <PanelFooter>\n          <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n            <Button\n              label=\"Cancel\"\n              kind=\"outlined\"\n              @click=\"open = false\"\n            />\n            <Button\n              label=\"Save\"\n              kind=\"primary\"\n            />\n          </div>\n        </PanelFooter>\n      </DialogContent>\n    </DialogPortal>\n  </Dialog>\n</template>"
  },
  {
   "name": "Sizes",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Dialog from '@aziontech/webkit/dialog'\n  import DialogClose from '@aziontech/webkit/dialog-close'\n  import DialogContent from '@aziontech/webkit/dialog-content'\n  import DialogDescription from '@aziontech/webkit/dialog-description'\n  import DialogOverlay from '@aziontech/webkit/dialog-overlay'\n  import DialogPortal from '@aziontech/webkit/dialog-portal'\n  import DialogTitle from '@aziontech/webkit/dialog-title'\n  import DialogTrigger from '@aziontech/webkit/dialog-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { reactive, watch } from 'vue'\n\n  const sizes = ['small', 'medium', 'large']\n  const sizeLabels = { small: 'Small', medium: 'Medium', large: 'Large' }\n  const openBySize = reactive({ small: false, medium: false, large: false })\n\n  watch(\n    openBySize,\n    () => {\n      const openKey = sizes.find((key) => openBySize[key])\n      if (!openKey) return\n      sizes.forEach((key) => {\n        if (key !== openKey) openBySize[key] = false\n      })\n    },\n    { deep: true }\n  )\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-center gap-(--spacing-md)\">\n    <Dialog\n      v-for=\"size in sizes\"\n      :key=\"size\"\n      v-model:open=\"openBySize[size]\"\n      :size=\"size\"\n    >\n      <DialogTrigger>\n        <Button\n          :label=\"sizeLabels[size]\"\n          kind=\"outlined\"\n        />\n      </DialogTrigger>\n      <DialogPortal>\n        <DialogOverlay />\n        <DialogContent>\n          <PanelHeader class=\"w-full\">\n            <DialogTitle>{{ sizeLabels[size] }}</DialogTitle>\n            <DialogClose />\n          </PanelHeader>\n          <PanelContent>\n            <DialogDescription>\n              Panel max-width preset for the {{ size }} dialog, applied from the md breakpoint up.\n            </DialogDescription>\n          </PanelContent>\n          <PanelFooter>\n            <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n              <Button\n                label=\"Close\"\n                kind=\"outlined\"\n                @click=\"openBySize[size] = false\"\n              />\n            </div>\n          </PanelFooter>\n        </DialogContent>\n      </DialogPortal>\n    </Dialog>\n  </div>\n</template>"
  },
  {
   "name": "ScrollContent",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Dialog from '@aziontech/webkit/dialog'\n  import DialogClose from '@aziontech/webkit/dialog-close'\n  import DialogContent from '@aziontech/webkit/dialog-content'\n  import DialogDescription from '@aziontech/webkit/dialog-description'\n  import DialogOverlay from '@aziontech/webkit/dialog-overlay'\n  import DialogPortal from '@aziontech/webkit/dialog-portal'\n  import DialogTitle from '@aziontech/webkit/dialog-title'\n  import DialogTrigger from '@aziontech/webkit/dialog-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n</script>\n\n<template>\n  <Dialog\n    v-model:open=\"open\"\n    dismissible\n    size=\"medium\"\n  >\n    <DialogTrigger>\n      <Button\n        label=\"Open dialog\"\n        kind=\"primary\"\n      />\n    </DialogTrigger>\n    <DialogPortal>\n      <DialogOverlay />\n      <DialogContent>\n        <PanelHeader class=\"w-full\">\n          <DialogTitle>Domain settings</DialogTitle>\n          <DialogClose />\n        </PanelHeader>\n        <PanelContent>\n          <DialogDescription>Body taller than the dialog, so it has to scroll.</DialogDescription>\n          <p>\n            Setting 1 — the body is the only region that scrolls, so the title and the footer\n            actions stay reachable.\n          </p>\n          <p>\n            Setting 2 — the body is the only region that scrolls, so the title and the footer\n            actions stay reachable.\n          </p>\n          <p>\n            Setting 3 — the body is the only region that scrolls, so the title and the footer\n            actions stay reachable.\n          </p>\n          <p>\n            Setting 4 — the body is the only region that scrolls, so the title and the footer\n            actions st