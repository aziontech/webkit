{
 "name": "drawer",
 "binding": "Drawer",
 "import": "@aziontech/webkit/drawer",
 "treeShakeableImport": "@aziontech/webkit/drawer-root",
 "category": "overlay",
 "surface": "product",
 "structure": "composition",
 "compoundRoot": true,
 "subcomponents": [
  "@aziontech/webkit/drawer-close",
  "@aziontech/webkit/drawer-content",
  "@aziontech/webkit/drawer-description",
  "@aziontech/webkit/drawer-title",
  "@aziontech/webkit/drawer-trigger"
 ],
 "purpose": "A panel that slides in from an edge of the screen and keeps the page behind it in view. It holds secondary work that is too large or too long-lived for a dialog: filters, a long form, the details of a row, a navigation list. `Drawer.Content` is the whole modal: it teleports to `body`, renders the dimmed overlay, traps focus and scroll-locks the page, so the page behind cannot be clicked or tabbed to while it is open. The header gets the close (X) button on its own unless `closable` is false. It closes on Escape and on an overlay click when `dismissible`, and returns focus to its trigger. `:modal=\"false\"` is the one opt-out: no overlay, no focus trap, no scroll lock, for a side panel that works next to the page it talks about (as Radix `modal={false}`).",
 "setup": null,
 "useWhen": [
  "A panel that slides in from a screen edge for secondary tasks, filters, long forms, or navigation, while keeping page context.",
  "The content is too large or persistent for a centered modal."
 ],
 "avoidWhen": [
  "It is a short, focused confirmation/task best centered and fully blocking → use `dialog`.",
  "It is a small overlay anchored to a trigger → use a popover / `dropdown`."
 ],
 "related": [
  "dialog` — centered, blocking modal for focused tasks/confirmations.",
  "sidebar` — persistent (non-overlay) side navigation."
 ],
 "bestPractices": [
  "Pick the edge (side) intentionally and keep it consistent across the app.",
  "Do not add an overlay, a portal or a close button by hand: `Drawer.Content` renders the overlay and the portal, and the header renders the close button while `closable` is true (the default).",
  "Keep the drawer modal (the default). Use `:modal=\"false\"` only when the reader must keep reading or using the page beside the drawer, such as an assistant that answers questions about the page.",
  "While an action is in flight, set `:dismissible=\"false\"` and `:closable=\"false\"` together so nothing can close it.",
  "Bind the open state with `v-model:open`, or `:open` plus an `@update:open` handler typed `(open: boolean) => void`. The payload is always a `boolean`, so the handler needs no cast and no `Boolean(...)`."
 ],
 "props": [
  {
   "name": "defaultOpen",
   "type": "boolean",
   "default": "false",
   "required": "false",
   "doc": "Initial open state when uncontrolled."
  },
  {
   "name": "closable",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "Shows the close (X) button at the end of the drawer header. False removes it; Escape and overlay click still follow `dismissible`."
  },
  {
   "name": "dismissible",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "Light-dismiss: when true, overlay click and Escape close the drawer. It does not govern the close button; see `closable`."
  },
  {
   "name": "modal",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "Renders the overlay, traps focus and locks page scroll. False leaves the page beside the drawer usable: no overlay, no focus trap, no scroll lock, `aria-modal` false; Escape, the close button and focus restore still work."
  },
  {
   "name": "side",
   "type": "DrawerSide",
   "default": "'right'",
   "required": "false",
   "doc": "Edge the drawer panel slides from."
  },
  {
   "name": "size",
   "type": "DrawerSize",
   "default": "'medium'",
   "required": "false",
   "doc": "Panel max-width preset (`small` `--container-sm`, `medium` `--container-xl`, `large` `--container-4xl`). Height is always 100% viewport."
  },
  {
   "name": "open",
   "type": "boolean",
   "default": "undefined as never",
   "required": "false",
   "doc": "Two-way value (`v-model:open`)."
  }
 ],
 "events": [],
 "slots": [
  {
   "name": "default",
   "scope": "—",
   "notes": "—"
  }
 ],
 "styleSeam": false,
 "assets": [],
 "examples": [
  {
   "name": "Default",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Drawer from '@aziontech/webkit/drawer'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n</script>\n\n<template>\n  <Drawer\n    v-model:open=\"open\"\n    dismissible\n    side=\"right\"\n    size=\"medium\"\n  >\n    <Drawer.Trigger>\n      <Button\n        label=\"Open drawer\"\n        kind=\"primary\"\n      />\n    </Drawer.Trigger>\n    <Drawer.Content>\n      <Drawer.Header class=\"w-full\">\n        <Drawer.Title>Drawer Title</Drawer.Title>\n      </Drawer.Header>\n      <Drawer.Body>\n        <Drawer.Description>\n          Side panel content. Uses the same Panel header, body, and footer regions as Dialog.\n        </Drawer.Description>\n      </Drawer.Body>\n      <Drawer.Footer>\n        <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n          <Button\n            label=\"Cancel\"\n            kind=\"outlined\"\n            @click=\"open = false\"\n          />\n          <Button\n            label=\"Save\"\n            kind=\"primary\"\n          />\n        </div>\n      </Drawer.Footer>\n    </Drawer.Content>\n  </Drawer>\n</template>"
  },
  {
   "name": "Sizes",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import DrawerContent from '@aziontech/webkit/drawer-content'\n  import DrawerDescription from '@aziontech/webkit/drawer-description'\n  import Drawer from '@aziontech/webkit/drawer-root'\n  import DrawerTitle from '@aziontech/webkit/drawer-title'\n  import DrawerTrigger from '@aziontech/webkit/drawer-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { reactive, watch } from 'vue'\n\n  const sizes = ['small', 'medium', 'large']\n  const sizeLabels = {\n    small: 'Small (384px)',\n    medium: 'Medium (672px)',\n    large: 'Large (1024px)'\n  }\n  const openBySize = reactive({ small: false, medium: false, large: false })\n\n  watch(\n    openBySize,\n    () => {\n      const openKey = sizes.find((key) => openBySize[key])\n      if (!openKey) return\n      sizes.forEach((key) => {\n        if (key !== openKey) openBySize[key] = false\n      })\n    },\n    { deep: true }\n  )\n</script>\n\n<template>\n  <div class=\"flex flex-wrap items-center justify-center gap-(--spacing-4)\">\n    <Drawer\n      v-for=\"size in sizes\"\n      :key=\"size\"\n      :size=\"size\"\n      v-model:open=\"openBySize[size]\"\n      dismissible\n      side=\"right\"\n    >\n      <DrawerTrigger>\n        <Button\n          :label=\"sizeLabels[size]\"\n          kind=\"primary\"\n        />\n      </DrawerTrigger>\n      <DrawerContent>\n        <PanelHeader class=\"w-full\">\n          <DrawerTitle>{{ sizeLabels[size] }}</DrawerTitle>\n        </PanelHeader>\n        <PanelContent>\n          <DrawerDescription>\n            Panel max-width preset for the {{ size }} drawer. Height is always 100% viewport.\n          </DrawerDescription>\n        </PanelContent>\n        <PanelFooter>\n          <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n            <Button\n              label=\"Cancel\"\n              kind=\"outlined\"\n              @click=\"openBySize[size] = false\"\n            />\n            <Button\n              label=\"Save\"\n              kind=\"primary\"\n            />\n          </div>\n        </PanelFooter>\n      </DrawerContent>\n    </Drawer>\n  </div>\n</template>"
  },
  {
   "name": "ScrollContent",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import DrawerContent from '@aziontech/webkit/drawer-content'\n  import DrawerDescription from '@aziontech/webkit/drawer-description'\n  import Drawer from '@aziontech/webkit/drawer-root'\n  import DrawerTitle from '@aziontech/webkit/drawer-title'\n  import DrawerTrigger from '@aziontech/webkit/drawer-trigger'\n  import PanelContent from '@aziontech/webkit/panel-content'\n  import PanelFooter from '@aziontech/webkit/panel-footer'\n  import PanelHeader from '@aziontech/webkit/panel-header'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n  const scrollSections = Array.from({ length: 12 }, (_, index) => ({\n    title: `Section ${index + 1}`,\n    body: `Scrollable drawer body copy for section ${index + 1}. Only PanelContent scrolls; header and footer stay in the panel layout.`\n  }))\n</script>\n\n<template>\n  <Drawer\n    v-model:open=\"open\"\n    dismissible\n    side=\"right\"\n    size=\"medium\"\n  >\n    <DrawerTrigger>\n      <Button\n        label=\"Open scrollable drawer\"\n        kind=\"primary\"\n      />\n    </DrawerTrigger>\n    <DrawerContent>\n      <PanelHeader class=\"w-full\">\n        <DrawerTitle>Scrollable drawer</DrawerTitle>\n      </PanelHeader>\n      <PanelContent>\n        <div class=\"flex flex-col gap-(--spacing-4)\">\n          <DrawerDescription>\n            Place long forms, lists, or settings inside PanelContent. Only the body scrolls inside\n            ScrollArea while header and footer stay in the panel layout.\n          </DrawerDescription>\n          <section\n            v-for=\"section in scrollSections\"\n            :key=\"section.title\"\n            class=\"flex flex-col gap-(--spacing-2) rounded-(--shape-elements) border border-(length:--border-width-default) border-(--border-muted) p-(--spacing-4)\"\n          >\n            <h3 class=\"m-0 text-body-md text-(--text-default)\">{{ section.title }}</h3>\n            <p class=\"m-0 text-body-sm text-(--text-muted)\">{{ section.body }}</p>\n          </section>\n        </div>\n      </PanelContent>\n      <PanelFooter>\n        <div class=\"flex w-full flex-col gap-(--spacing-sm) md:flex-row md:justify-end\">\n          <Button\n            label=\"Cancel\"\n            kind=\"outlined\"\n            @click=\"open = false\"\n          />\n          <Button\n            label=\"Save\"\n            kind=\"primary\"\n          />\n        </div>\n      </PanelFooter>\n    </DrawerContent>\n  </Drawer>\n</template>"
  }
 ],
 "docs": "components/drawer.md"
}
