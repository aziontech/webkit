{
 "name": "shell-mockup",
 "binding": "ShellMockup",
 "import": "@aziontech/webkit/shell-mockup",
 "treeShakeableImport": "@aziontech/webkit/shell-mockup-root",
 "category": "content",
 "surface": "product",
 "structure": "composition",
 "compoundRoot": true,
 "subcomponents": [
  "@aziontech/webkit/shell-mockup-part"
 ],
 "purpose": "A scaled, inert picture of an Azion Console screen, for marketing bands that show the product. The consumer composes the screen's body from real webkit components at a fixed design width; the frame draws the console shell around it (the slim console bar, the side rail with breadcrumbs and actions, or the previous console's top bar) and scales the whole drawing to fit its host. Each piece of the body is a `ShellMockup.Part` that travels in on its own beat once the mockup scrolls into view, so the screen assembles itself instead of appearing all at once.",
 "setup": null,
 "useWhen": [
  "Showing a console screen or fragment on a marketing band: a hero, a media split, a feature tab, a widget grid cell.",
  "Depicting a product workflow with real webkit controls instead of a screenshot, so the drawing follows the theme and stays sharp at any size.",
  "Staggering the parts of a mock so they arrive in reading order when the band scrolls into view, and replaying that entrance each time a tab makes the mock active.",
  "Drawing only a fragment of a screen (a list, a form row) floating on the band's own surface, with `kind=\"bare\"` and `chrome` off."
 ],
 "avoidWhen": [
  "To show a real, working screen at a device size → use `browser-frame`; it renders live content in a true viewport, not a scaled picture.",
  "For a static screenshot or clip in documentation → use `doc-frame`.",
  "For an illustration scene → use `illustration`."
 ],
 "related": [
  "browser-frame` — a live, resizable viewport for real screens; `shell-mockup` is an inert, scaled drawing of the console.",
  "texture-material` — the texture the frame grounds itself with when `texture` is set.",
  "frame-box` — the page's registration frame a mockup band is often placed inside."
 ],
 "bestPractices": [
  "Compose the body at the design width (`width`, `mobileWidth`), not at the host's width; the frame scales the drawing, so sizes inside are design pixels.",
  "Give the host a height (or an aspect ratio); the frame fills its host and derives its design height from it.",
  "Number parts in reading order with `order`, starting at `0`; parts on the same beat land together.",
  "Keep the mockup decorative: it is hidden from assistive technology unless `interactive` is set, so the band's own copy must say what the picture shows.",
  "Set `active` from the host when several mockups share one slot (tabs), so only the visible one plays and it replays when it returns.",
  "Tune a fade with the consumer-side custom properties `--mockup-fade-start` / `--mockup-fade-end` (or `--mockup-fade-edge` for `y`) and match its color to the host surface with `--mockup-fade-color`."
 ],
 "props": [
  {
   "name": "kind",
   "type": "'window' | 'bare'",
   "default": "'window'",
   "required": "false",
   "doc": "How the mockup is plated: a bordered console window, or bare parts floating on the host's surface."
  },
  {
   "name": "shell",
   "type": "'console' | 'legacy'",
   "default": "'console'",
   "required": "false",
   "doc": "Console generation the shell draws: the current one, or the previous one with its top bar."
  },
  {
   "name": "width",
   "type": "number",
   "default": "860",
   "required": "false",
   "doc": "Design width of the frame from `md` up; the frame scales to fit its host."
  },
  {
   "name": "mobileWidth",
   "type": "number",
   "default": "390",
   "required": "false",
   "doc": "Design width of the frame below `md`."
  },
  {
   "name": "fade",
   "type": "'none' | 'bottom' | 'top' | 'left' | 'right' | 'y'",
   "default": "'none'",
   "required": "false",
   "doc": "Edge the mockup fades out along; `y` fades top and bottom."
  },
  {
   "name": "chrome",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "Draws the console bar over the body."
  },
  {
   "name": "title",
   "type": "string",
   "default": "''",
   "required": "false",
   "doc": "Module label on the console bar; with a rail, `›` splits it into breadcrumbs."
  },
  {
   "name": "rail",
   "type": "string",
   "default": "''",
   "required": "false",
   "doc": "Active entry of the console's side rail; empty renders no rail."
  },
  {
   "name": "texture",
   "type": "'dots' | 'grid' | 'lines' | 'dither' | 'pixelate' | 'none'",
   "default": "'none'",
   "required": "false",
   "doc": "Texture the frame is grounded with, behind the body."
  },
  {
   "name": "textureFade",
   "type": "'none' | 'top' | 'bottom' | 'left' | 'right' | 'edges' | 'vignette'",
   "default": "'vignette'",
   "required": "false",
   "doc": "How the frame's texture fades out before its edges."
  },
  {
   "name": "travel",
   "type": "'fast-01' | 'fast-02' | 'moderate-01' | 'moderate-02' | 'slow-01' | 'slow-02'",
   "default": "'slow-01'",
   "required": "false",
   "doc": "Duration token of each part's travel."
  },
  {
   "name": "beat",
   "type": "'fast-01' | 'fast-02' | 'moderate-01' | 'moderate-02' | 'slow-01' | 'slow-02'",
   "default": "'fast-01'",
   "required": "false",
   "doc": "Duration token of the gap between one part's beat and the next."
  },
  {
   "name": "active",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "Whether this mockup is the one showing; parts replay their entrance each time it becomes active."
  },
  {
   "name": "interactive",
   "type": "boolean",
   "default": "false",
   "required": "false",
   "doc": "Lets the viewer operate the controls inside instead of drawing them as an inert picture."
  },
  {
   "name": "animated",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "Plays the entrance as the frame comes into view and replays it when `active` turns back on. Off draws every part in place from the start, with no entrance and no replay."
  }
 ],
 "events": [],
 "slots": [
  {
   "name": "default",
   "scope": "—",
   "notes": "The mockup's body, composed of `ShellMockup.Part` beats."
  },
  {
   "name": "overlay",
   "scope": "—",
   "notes": "A layer over the whole frame, bar and rail included, such as a drawer."
  }
 ],
 "styleSeam": false,
 "assets": [],
 "examples": [
  {
   "name": "Default",
   "sfc": "<script setup>\n  import Button from '@aziontech/webkit/button'\n  import Input from '@aziontech/webkit/input'\n  import ShellMockup from '@aziontech/webkit/shell-mockup'\n  import Table from '@aziontech/webkit/table'\n  import Tag from '@aziontech/webkit/tag'\n</script>\n\n<template>\n  <div class=\"h-96 w-full\">\n    <ShellMockup\n      title=\"Workloads › my-workload\"\n      rail=\"workloads\"\n      fade=\"bottom\"\n    >\n      <div class=\"flex flex-col gap-(--spacing-md) p-(--spacing-lg)\">\n        <ShellMockup.Part :order=\"0\">\n          <div class=\"flex items-center justify-between gap-(--spacing-md)\">\n            <span class=\"text-heading-sm text-(--text-default)\">Workloads</span>\n            <Button\n              label=\"Create workload\"\n              icon=\"pi pi-plus\"\n              size=\"medium\"\n            />\n          </div>\n        </ShellMockup.Part>\n        <ShellMockup.Part :order=\"1\">\n          <div class=\"flex items-center gap-(--spacing-sm)\">\n            <Input\n              placeholder=\"Search workloads\"\n              size=\"small\"\n            />\n            <Tag\n              label=\"3 active\"\n              severity=\"success\"\n              size=\"small\"\n            />\n          </div>\n        </ShellMockup.Part>\n        <ShellMockup.Part :order=\"2\">\n          <Table bordered>\n            <Table.Header>\n              <Table.Row>\n                <Table.HeadCell principal>Name</Table.HeadCell>\n                <Table.HeadCell>Domain</Table.HeadCell>\n                <Table.HeadCell>Status</Table.HeadCell>\n              </Table.Row>\n            </Table.Header>\n            <Table.Body>\n              <Table.Row>\n                <Table.Cell principal>my-workload</Table.Cell>\n                <Table.Cell>my-workload.azion.app</Table.Cell>\n                <Table.Cell\n                  ><Tag\n                    label=\"Active\"\n                    severity=\"success\"\n                    size=\"small\"\n                /></Table.Cell>\n              </Table.Row>\n              <Table.Row>\n                <Table.Cell principal>storefront</Table.Cell>\n                <Table.Cell>shop.example.com</Table.Cell>\n                <Table.Cell\n                  ><Tag\n                    label=\"Active\"\n                    severity=\"success\"\n                    size=\"small\"\n                /></Table.Cell>\n              </Table.Row>\n              <Table.Row>\n                <Table.Cell principal>docs-portal</Table.Cell>\n                <Table.Cell>docs.example.com</Table.Cell>\n                <Table.Cell\n                  ><Tag\n                    label=\"Deploying\"\n                    severity=\"warning\"\n                    size=\"small\"\n                /></Table.Cell>\n              </Table.Row>\n            </Table.Body>\n          </Table>\n        </ShellMockup.Part>\n      </div>\n    </ShellMockup>\n  </div>\n</template>"
  },
