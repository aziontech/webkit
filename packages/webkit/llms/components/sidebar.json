{
 "name": "sidebar",
 "binding": "Sidebar",
 "import": "@aziontech/webkit/sidebar",
 "treeShakeableImport": "@aziontech/webkit/sidebar-root",
 "category": "layout",
 "surface": "app",
 "structure": "composition",
 "compoundRoot": true,
 "subcomponents": [
  "@aziontech/webkit/sidebar-header",
  "@aziontech/webkit/sidebar-footer"
 ],
 "purpose": "Helps users move between views or sections. Composable application sidebar with optional header and footer regions; navigation content scrolls inside a built-in `ScrollArea`. It also owns **the rail gesture** — sizing the sidebar by dragging its trailing edge, and collapsing it out of the layout entirely. That belongs here rather than in each shell: the interaction is not a small one (a pointer drag that crosses the collapse boundary continuously, a keyboard equivalent, token-derived bounds, a phase-aware transition, and an affordance that brings a collapsed rail back), and every app that has a sidebar wants the same one. Two shells re-implementing it is how the two drift apart. Both halves are **opt-in and independent**: `resizable` adds the drag, `collapsible` adds the collapse trigger and the edge affordance. `collapsible=\"icon\"` collapses to an **icon rail** instead of leaving the layout, and `shortcut` adds the Ctrl+B / Cmd+B toggle. With neither set the component renders exactly as it always has, with the host owning the width — every existing consumer is unaffected.",
 "setup": null,
 "useWhen": [
  "Use Sidebar only when not using ConsoleLayout, which already renders the rail; put a SidebarMenu inside it.",
  "The persistent navigation column of an app shell, with an optional header (brand, workspace switcher) and footer (profile, settings) around a scrolling `SidebarMenu`.",
  "The user should be able to resize the rail by dragging its trailing edge (`resizable`) or take it out of the layout and bring it back (`collapsible`).",
  "Wide work surfaces where the navigation should shrink to its icons rather than disappear (`collapsible=\"icon\"`), so a destination stays one click away.",
  "The rail's size or collapsed state must survive navigation or reloads — bind `v-model:width` and `v-model:open` and persist them in the app."
 ],
 "avoidWhen": [
  "Adjacent work areas the reader resizes (editor beside a preview, a terminal under it) → use `resizable`.",
  "Horizontal top-level navigation with dropdown panels → use `navigation-menu`.",
  "A temporary panel that slides over the page → use `drawer`."
 ],
 "related": [
  "sidebar-menu` — the navigation rows, groups and drill levels that go in the sidebar's default slot.",
  "resizable` — draggable splits between content regions; the sidebar's rail gesture is for navigation only.",
  "app-header` — the top bar that usually sits above the sidebar in an app shell.",
  "console-layout` — the console layout template that composes the header, the sidebar and the page."
 ],
 "bestPractices": [
  "Put a `SidebarMenu` with `role=\"presentation\"` in the default slot; the sidebar already renders the `nav` landmark and its `aria-label` (default `'Sidebar'`) names the region.",
  "Group the rows with `SidebarMenu.Group`; the sidebar has no group part of its own.",
  "Without `resizable` or `collapsible`, size the rail with a width class on the root; with either set, the sidebar owns the width and clamps it between `min-width-token` and `max-width-token`.",
  "When the sidebar is revealed after mount (for example leaving a mobile layout where it was hidden), call the exposed `measure()` so the rail does not keep a zero width.",
  "Keep the profile block in the `footer` slot; with `collapsible`, the collapse trigger renders in the same footer row.",
  "With `collapsible=\"icon\"`, give every top-level `SidebarMenu.Item` and drill `SidebarMenu.SubTrigger` an icon: rows without one (and inline sub-menus) step aside in the rail. Use the `{ rail }` slot scope to compact header and footer content (an avatar without the name).",
  "Turn on `shortcut` for one sidebar per page only; Ctrl+B / Cmd+B is a page-wide key."
 ],
 "props": [
  {
   "name": "ariaLabel",
   "type": "string",
   "default": "''",
   "required": "false",
   "doc": "Accessible name for the navigation landmark. Empty uses the locale catalog (`Sidebar`)."
  },
  {
   "name": "resizable",
   "type": "boolean",
   "default": "false",
   "required": "false",
   "doc": "Adds the drag handle on the trailing edge; dragging past the minimum collapses the rail."
  },
  {
   "name": "collapsible",
   "type": "boolean | SidebarCollapsible",
   "default": "false",
   "required": "false",
   "doc": "Adds the collapse trigger; `true` or `'offcanvas'` takes a collapsed sidebar out of the layout (with the edge affordance that brings it back), `'icon'` keeps an icon rail."
  },
  {
   "name": "shortcut",
   "type": "boolean",
   "default": "false",
   "required": "false",
   "doc": "Lets Ctrl+B / Cmd+B toggle `open` while the sidebar is collapsible. Ignored while focus is in an editable field."
  },
  {
   "name": "minWidthToken",
   "type": "string",
   "default": "'--container-3xs'",
   "required": "false",
   "doc": "Theme container token the sized width is clamped up to, read off the document at runtime."
  },
  {
   "name": "maxWidthToken",
   "type": "string",
   "default": "'--container-sm'",
   "required": "false",
   "doc": "Theme container token the sized width is clamped down to, read off the document at runtime."
  },
  {
   "name": "collapseAriaLabel",
   "type": "string",
   "default": "''",
   "required": "false",
   "doc": "Accessible name for the collapse trigger. Empty uses the locale catalog (`Collapse sidebar`)."
  },
  {
   "name": "expandAriaLabel",
   "type": "string",
   "default": "''",
   "required": "false",
   "doc": "Accessible name for the control and the grab bar that bring a collapsed rail back. Empty uses the locale catalog (`Expand sidebar`)."
  },
  {
   "name": "resizeAriaLabel",
   "type": "string",
   "default": "''",
   "required": "false",
   "doc": "Accessible name for the drag handle separator. Empty uses the locale catalog (`Resize sidebar`)."
  },
  {
   "name": "open",
   "type": "boolean",
   "default": "true",
   "required": "false",
   "doc": "Two-way value (`v-model:open`)."
  },
  {
   "name": "width",
   "type": "number | null",
   "default": "null",
   "required": "false",
   "doc": "Two-way value (`v-model:width`)."
  }
 ],
 "events": [],
 "slots": [
  {
   "name": "default",
   "scope": "{ rail: boolean }",
   "notes": "The navigation. `rail` is true while the sidebar is collapsed to its icon rail."
  },
  {
   "name": "header",
   "scope": "{ rail: boolean }",
   "notes": "Named slot. Use `rail` to compact the content in the icon rail."
  },
  {
   "name": "footer",
   "scope": "{ rail: boolean }",
   "notes": "Named slot. The collapse trigger renders after this content in the same row, under one full-width separator, so a profile block and the trigger read as one footer. In the icon rail the row stacks and the trigger becomes the expand button."
  }
 ],
 "styleSeam": false,
 "assets": [],
 "examples": [
  {
   "name": "Default",
   "sfc": "<script setup>\n  import Avatar from '@aziontech/webkit/avatar'\n  import CommandEmpty from '@aziontech/webkit/command-empty'\n  import CommandGroup from '@aziontech/webkit/command-group'\n  import CommandInput from '@aziontech/webkit/command-input'\n  import CommandItem from '@aziontech/webkit/command-item'\n  import CommandList from '@aziontech/webkit/command-list'\n  import Command from '@aziontech/webkit/command-root'\n  import CommandSeparator from '@aziontech/webkit/command-separator'\n  import DropdownMenuGroup from '@aziontech/webkit/dropdown-menu-group'\n  import DropdownMenuItem from '@aziontech/webkit/dropdown-menu-item'\n  import DropdownMenu from '@aziontech/webkit/dropdown-menu-root'\n  import DropdownMenuTrigger from '@aziontech/webkit/dropdown-menu-trigger'\n  import IconButton from '@aziontech/webkit/icon-button'\n  import SearchTrigger from '@aziontech/webkit/search-trigger'\n  import SidebarFooter from '@aziontech/webkit/sidebar-footer'\n  import SidebarHeader from '@aziontech/webkit/sidebar-header'\n  import SidebarMenuBack from '@aziontech/webkit/sidebar-menu-back'\n  import SidebarMenuGroup from '@aziontech/webkit/sidebar-menu-group'\n  import SidebarMenuItem from '@aziontech/webkit/sidebar-menu-item'\n  import SidebarMenu from '@aziontech/webkit/sidebar-menu-root'\n  import SidebarMenuSub from '@aziontech/webkit/sidebar-menu-sub'\n  import SidebarMenuSubContent from '@aziontech/webkit/sidebar-menu-sub-content'\n  import SidebarMenuSubTrigger from '@aziontech/webkit/sidebar-menu-sub-trigger'\n  import Sidebar from '@aziontech/webkit/sidebar-root'\n  import { ref } from 'vue'\n\n  const accountMenuOpen = ref(false)\n  const paletteOpen = ref(false)\n</script>\n\n<template>\n  <div class=\"h-screen w-[280px]\">\n    <Sidebar aria-label=\"Console\">\n      <template #header>\n        <SidebarHeader>\n          <SearchTrigger\n            class=\"w-full\"\n            @open=\"paletteOpen = true\"\n          />\n\n          <Command v-model:open=\"paletteOpen\">\n            <CommandInput placeholder=\"Search navigation and commands\" />\n            <CommandList>\n              <CommandGroup label=\"Build\">\n                <CommandItem value=\"nav:applications\">\n                  <template #leading\n                    ><i\n                      class=\"ai ai-edge-application\"\n                      aria-hidden=\"true\"\n                  /></template>\n                  Applications\n                </CommandItem>\n                <CommandItem value=\"nav:variables\">\n                  <template #leading\n                    ><i\n                      class=\"ai ai-variables\"\n                      aria-hidden=\"true\"\n                  /></template>\n                  Variables\n                </CommandItem>\n              </CommandGroup>\n\n              <CommandSeparator />\n\n              <CommandGroup label=\"Account\">\n                <CommandItem value=\"cmd:settings\">\n                  <template #leading\n                    ><i\n                      class=\"ai ai-settings\"\n                      aria-hidden=\"true\"\n                  /></template>\n                  Account Settings\n                </CommandItem>\n              </CommandGroup>\n\n              <CommandEmpty>No navigation or command matches your search.</CommandEmpty>\n            </CommandList>\n          </Command>\n        </SidebarHeader>\n      </template>\n      <SidebarMenu role=\"presentation\">\n        <SidebarMenuBack />\n        <SidebarMenuGroup>\n          <SidebarMenuItem\n            label=\"Home\"\n            icon=\"ai ai-home\"\n            href=\"/\"\n            active\n          />\n          <SidebarMenuItem\n            label=\"Marketplace\"\n            icon=\"ai ai-marketplace\"\n            href=\"/marketplace\"\n          />\n        </SidebarMenuGroup>\n        <SidebarMenuGroup label=\"Build\">\n          <SidebarMenuItem\n            label=\"Applications\"\n            icon=\"ai ai-edge-application\"\n            href=\"/applications\"\n          />\n          <SidebarMenuSub default-open>\n            <SidebarMenuSubTrigger\n              label=\"Edge Functions\"\n              type=\"inline\"\n            />\n            <SidebarMenuSubContent>\n              <SidebarMenuItem\n                label=\"Runtime APIs\"\n                href=\"/functions/runtime-apis\"\n              />\n              <SidebarMenuItem\n                label=\"Bundlers\"\n                href=\"/functions/bundlers\"\n              />\n            </SidebarMenuSubContent>\n          </SidebarMenuSub>\n          <SidebarMenuItem\n            label=\"Variables\"\n            icon=\"ai ai-variables\"\n            href=\"/variables\"\n          />\n        </SidebarMenuGroup>\n        <SidebarMenuGroup label=\"Store\">\n          <SidebarMenuItem\n            label=\"Object Storage\"\n            icon=\"ai ai-edge-storage\"\n            href=\"/object-storage\"\n          />\n          <SidebarMenuItem\n            label=\"SQL Database\"\n            icon=\"ai ai-edge-sql\"\n            href=\"/sql-database\"\n            tag-value=\"Preview\"\n            tag-variant=\"primary\"\n          />\n        </SidebarMenuGroup>\n        <SidebarMenuGroup label=\"Account\">\n          <SidebarMenuSub>\n            <SidebarMenuSubTrigger\n              label=\"Settings\"\n              icon=\"ai ai-settings\"\n              type=\"drill\"\n            />\n            <SidebarMenuSubContent>\n              <SidebarMenuGroup label=\"Organization\">\n                <SidebarMenuItem\n                  label=\"General\"\n                  href=\"/settings/general\"\n                />\n                <SidebarMenuItem\n                  label=\"Members\"\n                  href=\"/settings/members\"\n                />\n                <SidebarMenuItem\n                  label=\"Billing\"\n                  href=\"/settings/billing\"\n                />\n              </SidebarMenuGroup>\n            </SidebarMenuSubContent>\n          </SidebarMenuSub>\n        </SidebarMenuGroup>\n      </SidebarMenu>\n      <template #footer>\n        <SidebarFooter>\n          <div class=\"flex items-center gap-(--spacing-xs)\">\n            <Avatar\n              variant=\"square\"\n              size=\"small\"\n              label=\"AM\"\n              alt=\"Alex Morgan\"\n            />\n            <span class=\"min-w-0 flex-1 truncate text-label-sm text-(--text-default)\"\n              >Alex Morgan</span\n            >\n            <DropdownMenu\n              v-model:open=\"accountMenuOpen\"\n              placement=\"top-end\"\n            >\n              <DropdownMenuTrigger>\n                <IconButton\n                  icon=\"ai ai-ellipsis-vertical\"\n                  aria-label=\"Account menu\"\n                  variant=\"outline\"\n                  size=\"small\"\n                />\n              </DropdownMenuTrigger>\n              <DropdownMenuGroup>\n                <template #header>\n                  <div class=\"flex min-w-0 flex-col\">\n                    <span class=\"truncate text-label-md text-(--text-default)\">Alex Morgan</span>\n                    <span class=\"truncate text-body-xs text-(--text-muted)\"\n                      >rafael.umman@example.com</span\n                    >\n                  </div>\n                </template>\n                <DropdownMenuItem\n                  value=\"settings\"\n                  label=\"Account Settings\"\n                />\n                <DropdownMenuItem\n                  value=\"personal-tokens\"\n                  label=\"Personal Tokens\"\n                />\n              </DropdownMenuGroup>\n              <DropdownMenuGroup>\n                <DropdownMenuItem\n                  value=\"logout\"\n                  label=\"Log Out\"\n                >\n                  <template #trailing\n                    ><i\n                      class=\"ai ai-log-out\"\n                      aria-hidden=\"true\"\n                  /></template>\n                </DropdownMenuItem>\n              </DropdownMenuGroup>\n            </DropdownMenu>\n          </div>\n        </SidebarFooter>\n      </template>\n    </Sidebar>\n  </div>\n</template>"
  },
  {
   "name": "IconRail",
   "sfc": "<script setup>\n  import Avatar from '@aziontech/webkit/avatar'\n  import SidebarFooter from '@aziontech/webkit/sidebar-footer'\n  import SidebarMenuBack from '@aziontech/webkit/sidebar-menu-back'\n  import SidebarMenuGroup from '@aziontech/webkit/sidebar-menu-group'\n  import SidebarMenuItem from '@aziontech/webkit/sidebar-menu-item'\n  import SidebarMenu from '@aziontech/webkit/sidebar-menu-root'\n  import SidebarMenuSub from '@aziontech/webkit/sidebar-menu-sub'\n  import SidebarMenuSubContent from '@aziontech/webkit/sidebar-menu-sub-content'\n  import SidebarMenuSubTrigger from '@aziontech/webkit/sidebar-menu-sub-trigger'\n  import Sidebar from '@aziontech/webkit/sidebar-root'\n  import { ref } from 'vue'\n\n  const open = ref(false)\n</script>\n\n<template>\n  <div class=\"relative flex h-screen min-h-0\">\n    <div class=\"flex min-h-0 shrink-0 max-md:hidden\">\n      <Sidebar\n        v-model:open=\"open\"\n        collapsible=\"icon\"\n        shortcut\n        aria-label=\"Console\"\n      >\n        <SidebarMenu role=\"presentation\">\n          <SidebarMenuBack />\n          <SidebarMenuGroup>\n            <SidebarMenuItem\n              label=\"Home\"\n              icon=\"ai ai-home\"\n              href=\"/\"\n              active\n            />\n            <SidebarMenuItem\n              label=\"Marketplace\"\n              icon=\"ai ai-marketplace\"\n              href=\"/marketplace\"\n            />\n          </SidebarMenuGroup>\n          <SidebarMenuGroup label=\"Build\">\n            <SidebarMenuItem\n              label=\"Applications\"\n              icon=\"ai ai-edge-application\"\n              href=\"/applications\"\n            />\n            <SidebarMenuItem\n              label=\"Variables\"\n              icon=\"ai ai-variables\"\n              href=\"/variables\"\n            />\n          </SidebarMenuGroup>\n          <SidebarMenuGroup label=\"Store\">\n            <SidebarMenuItem\n              label=\"Object Storage\"\n              icon=\"ai ai-edge-storage\"\n              href=\"/object-storage\"\n            />\n            <SidebarMenuItem\n              label=\"SQL Database\"\n              icon=\"ai ai-edge-sql\"\n              href=\"/sql-database\"\n              tag-value=\"Preview\"\n              tag-variant=\"primary\"\n            />\n          </SidebarMenuGroup>\n          <SidebarMenuGroup label=\"Account\">\n            <SidebarMenuSub>\n              <SidebarMenuSubTrigger\n                label=\"Settings\"\n                icon=\"ai ai-settings\"\n                type=\"drill\"\n              />\n              <SidebarMenuSubContent>\n                <SidebarMenuGroup label=\"Organization\">\n                  <SidebarMenuItem\n                    label=\"General\"\n                    href=\"/settings/general\"\n                  />\n                  <SidebarMenuItem\n                    label=\"Members\"\n                    href=\"/settings/members\"\n                  />\n                </SidebarMenuGroup>\n              </SidebarMenuSubContent>\n            </SidebarMenuSub>\n          </SidebarMenuGroup>\n        </SidebarMenu>\n        <template #footer=\"{ rail }\">\n          <SidebarFooter>\n            <div class=\"flex items-center gap-(--spacing-xs)\">\n              <Avatar\n                variant=\"square\"\n                size=\"small\"\n                label=\"JD\"\n                alt=\"Jane Doe\"\n              />\n              <span\n                v-if=\"!rail\"\n                class=\"min-w-0 flex-1 truncate text-label-sm text-(--text-default)\"\n                >Jane Doe</span\n              >\n            </div>\n          </SidebarFooter>\n        </template>\n      </Sidebar>\n    </div>\n\n    <main class=\"min-w-0 flex-1 p-(--spacing-lg)\">\n      <p class=\"text-body-sm text-(--text-muted)\">\n        Press Ctrl+B (Cmd+B on macOS) to switch between the icon rail and the full sidebar.\n      </p>\n    </main>\n  </div>\n</template>"
  }
 ],
 "docs": "components/sidebar.md"
}
