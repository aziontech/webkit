{
  "name": "@aziontech/webkit",
  "version": "5.1.0",
  "description": "Reusable UI components and design system utilities for building Azion web interfaces.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/aziontech/webkit.git",
    "directory": "packages/webkit"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "pack:check": "! npm pack --dry-run 2>&1 | grep -E '\\.test\\.(ts|js)|src/test/'",
    "format": "prettier --write \"**/*.{js,mjs,ts,vue,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,vue,css,json,md}\"",
    "lint": "eslint src --ext .js,.mjs,.ts,.vue --max-warnings 0",
    "lint:fix": "eslint src --ext .js,.mjs,.ts,.vue --fix",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\"",
    "lint:style:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "type-check": "vue-tsc --noEmit",
    "type-coverage": "type-coverage -p . --at-least 95 --detail",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs && git diff --exit-code --stat catalog.json",
    "size": "node scripts/check-size.mjs",
    "test:toolkit": "node --test \"test/**/*.test.mjs\"",
    "authoring": "node scripts/check-authoring.mjs",
    "authoring:update": "node scripts/check-authoring.mjs --update",
    "doc-standards": "node scripts/check-authoring-docs.mjs",
    "doc-standards:update": "node scripts/check-authoring-docs.mjs --update",
    "test:gate": "node scripts/check-tests.mjs",
    "smoke:consume": "node scripts/smoke-consume.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --browser.headless=false",
    "test:watch": "vitest",
    "figma:parse": "figma connect parse",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish"
  },
  "bin": {
    "webkit": "./src/cli/cli.js",
    "webkit-mcp": "./src/mcp/server.js"
  },
  "dependencies": {
    "@aziontech/theme": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^10.11.1",
