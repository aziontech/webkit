    "eslint": ">=9",
    "stylelint": ">=16",
    "vue": "^3.5.29",
    "vue-eslint-parser": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
