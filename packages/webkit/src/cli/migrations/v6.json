{
  "version": 6,
  "components": {
    "paginator": { "to": "pagination", "from": "Paginator", "binding": "Pagination" },
    "tab-view": { "to": "tabs", "from": "TabView", "binding": "Tabs" },
    "card-box": { "to": "card", "from": "CardBox", "binding": "Card" },
    "message": { "to": "alert", "from": "Message", "binding": "Alert" },
    "divider": { "to": "separator", "from": "Divider", "binding": "Separator" },
    "progress-bar": { "to": "progress", "from": "ProgressBar", "binding": "Progress" },
    "command-menu": { "to": "command", "from": "CommandMenu", "binding": "Command" },
    "dropdown": { "to": "dropdown-menu", "from": "Dropdown", "binding": "DropdownMenu" },
    "input-text": { "to": "input", "from": "InputText", "binding": "Input" },
    "input-number": { "to": "number-input", "from": "InputNumber", "binding": "NumberInput" },
    "input-password": {
      "to": "password-input",
      "from": "InputPassword",
      "binding": "PasswordInput"
    },
    "box-grid-selection": {
      "to": "radio-cards",
      "from": "BoxGridSelection",
      "binding": "RadioCards"
    },
    "resizable-panel": { "to": "resizable", "from": "ResizablePanel", "binding": "Resizable" },
    "segmented-button": {
      "to": "toggle-group",
      "from": "SegmentedButton",
      "binding": "ToggleGroup"
    }
  }
}
