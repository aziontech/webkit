{
  "version": 6,
  "components": {
    "paginator": { "to": "pagination", "from": "Paginator", "binding": "Pagination" },
    "tab-view": { "to": "tabs", "from": "TabView", "binding": "Tabs" },
    "card-box": { "to": "card", "from": "CardBox", "binding": "Card" },
    "message": { "to": "alert", "from": "Message", "binding": "Alert" },
    "divider": { "to": "separator", "from": "Divider", "binding": "Separator" },
    "progress-bar": { "to": "progress", "from": "ProgressBar", "binding": "Progress" },
    "command-menu": { "to": "command", "from": "CommandMenu", "binding": "Command" },
    "dropdown": { "to": "dropdown-menu", "from": "Dropdown", "binding": "DropdownMenu" },
    "input-text": { "to": "input", "from": "InputText", "binding": "Input" },
    "input-number": { "to": "number-input", "from": "InputNumber", "binding": "NumberInput" },
    "input-password": {
      "to": "password-input",
      "from": "InputPassword",
      "binding": "PasswordInput"
    },
    "box-grid-selection": {
      "to": "radio-cards",
      "from": "BoxGridSelection",
      "binding": "RadioCards"
    },
    "resizable-panel": { "to": "resizable", "from": "ResizablePanel", "binding": "Resizable" },
    "segmented-button": {
      "to": "toggle-group",
      "from": "SegmentedButton",
      "binding": "ToggleGroup"
    }
  },
  "removed": {
    "field-text": "Field + FieldLabel + Input + FieldDescription",
    "field-textarea": "Field + FieldLabel + Textarea + FieldDescription",
    "field-select": "Field + FieldLabel + Select (Trigger/Content/Option) + FieldDescription",
    "field-password": "Field + FieldLabel + PasswordInput + FieldDescription (+ PasswordRequirements for the rules row)",
    "field-phone-number": "Field + FieldLabel + PhoneInput + FieldDescription",
    "field-time": "Field + FieldLabel + Input + FieldDescription",
    "field-file-upload": "Field + FieldLabel + FileDropzone + FieldDescription",
    "field-input-group": "Field + FieldLabel + InputGroup (Addon + InputGroupInput) + FieldDescription",
    "field-text-switch": "Field + FieldLabel + InputGroup (InputGroupInput + Addon with Switch) + FieldDescription",
    "field-checkbox": "Field orientation=horizontal + Checkbox + FieldContent (FieldLabel + FieldDescription)",
    "field-radio": "Field orientation=horizontal + RadioButton + FieldContent (FieldLabel + FieldDescription)",
    "field-switch": "Field orientation=horizontal + Switch + FieldContent (FieldLabel + FieldDescription)",
    "field-checkbox-block": "FieldLabel wrapping Field orientation=horizontal + Checkbox + FieldContent (FieldTitle + FieldDescription)",
    "field-radio-block": "FieldLabel wrapping Field orientation=horizontal + RadioButton + FieldContent (FieldTitle + FieldDescription)",
    "field-switch-block": "FieldLabel wrapping Field orientation=horizontal + Switch + FieldContent (FieldTitle + FieldDescription)"
  }
}
