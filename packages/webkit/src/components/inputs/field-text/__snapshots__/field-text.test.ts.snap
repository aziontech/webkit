// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FieldText — rendered HTML stays stable > renders the same HTML as before when type, autocomplete and spellcheck are absent 1`] = `"<div data-testid="input-field-text" data-size="medium" class="flex flex-col gap-(--spacing-xs) w-full"><label for="email" data-testid="input-field-text__label" class="inline-flex items-center text-label-sm text-(--text-default) data-[hinted]:gap-(--spacing-xxs) data-[required]:gap-(--spacing-xxs)"><span data-testid="input-field-text__label__text">Email</span><!--v-if--><!--v-if--></label><span data-size="medium" class="relative inline-flex items-center w-full cursor-text gap-(--spacing-xs) px-(--spacing-sm) rounded-(--shape-elements) border border-(--border-default) bg-(--bg-surface) text-(--text-default) transition-colors duration-150 ease-out motion-reduce:transition-none [&amp;:not(:focus-within):not([data-disabled])]:hover:border-(--border-strong) focus-within:outline-none focus-within:ring-2 focus-within:ring-(--ring-color) focus-within:ring-offset-2 focus-within:ring-offset-[var(--input-ring-offset,var(--bg-canvas))] data-[size=small]:h-7 data-[size=medium]:h-8 data-[size=large]:h-10 data-[invalid]:border-(--danger-border) data-[required]:border-(--warning-border) data-[disabled]:bg-(--bg-disabled) data-[disabled]:text-(--text-disabled) data-[disabled]:cursor-not-allowed data-[disabled]:hover:border-(--border-default) data-[disabled]:focus-within:ring-0 data-[disabled]:focus-within:ring-offset-0"><!--v-if--><input type="text" placeholder="" data-testid="input-field-text__input" class="relative z-(--z-input-field) h-full w-full min-w-0 self-stretch border-0 bg-transparent p-0 outline-none text-label-sm text-(--text-default) placeholder:text-(--text-muted) disabled:cursor-not-allowed disabled:text-(--text-disabled) read-only:cursor-default" id="email" name="email" aria-describedby="email-helper" value=""><!--v-if--></span><p id="email-helper" data-testid="input-field-text__helper" data-kind="helper" class="inline-flex items-center text-label-sm data-[kind=helper]:text-(--text-muted) data-[kind=disabled]:text-(--text-muted) data-[kind=invalid]:text-(--danger-contrast) data-[kind=required]:text-(--warning-contrast) data-[kind=disabled]:gap-(--spacing-xxs)"><!--v-if--><span data-testid="input-field-text__helper__text">Work address</span></p></div>"`;
